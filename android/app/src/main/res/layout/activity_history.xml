<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_primary">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/space_16"
            android:paddingTop="@dimen/space_8"
            android:paddingBottom="@dimen/space_24">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/screen_header_height"
                android:background="@drawable/bg_screen_header"
                android:gravity="center_vertical">

                <ImageButton
                    android:id="@+id/backButton"
                    android:layout_width="@dimen/icon_button_size"
                    android:layout_height="@dimen/icon_button_size"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Indietro"
                    android:padding="@dimen/space_8"
                    android:src="@drawable/ic_arrow_back"
                    app:tint="@color/text_primary" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    style="@style/Text.MyFitAI.ScreenTitle"
                    android:text="Storico" />

                <Space android:layout_width="@dimen/icon_button_size" android:layout_height="1dp" />
            </LinearLayout>

            <com.myfitai.app.ui.widgets.SelectableSegmentView
                android:id="@+id/categorySegment"
                android:layout_width="match_parent"
                android:layout_height="@dimen/control_min_height"
                android:layout_marginTop="@dimen/space_12" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/addHistoryMeasurementButton"
                style="@style/Widget.MyFitAI.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="@dimen/button_secondary_min_height"
                android:layout_marginTop="@dimen/space_12"
                android:text="Aggiungi rilevazione"
                android:textAllCaps="false"
                android:visibility="gone" />

            <TextView
                android:id="@+id/emptyHistoryText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_12"
                android:gravity="center"
                android:padding="@dimen/space_20"
                android:text="Nessun dato disponibile."
                 style="@style/Text.MyFitAI.Body"
                android:background="@drawable/bg_card_soft"
                android:visibility="gone" />

             <com.google.android.material.card.MaterialCardView
                 android:id="@+id/historyRowsCard"
                 style="@style/Widget.MyFitAI.Card"
                android:layout_width="match_parent"
                 android:layout_height="wrap_content"
                 android:layout_marginTop="@dimen/space_12"
                 android:visibility="gone">
                <LinearLayout
                    style="@style/Widget.MyFitAI.HomeSectionContent"
                    android:id="@+id/historyRowsContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/exportButton"
                style="@style/Widget.MyFitAI.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="@dimen/button_primary_min_height"
                android:layout_marginTop="@dimen/space_16"
                android:text="Esporta tutto"
                android:textAllCaps="false" />
        </LinearLayout>
    </ScrollView>

    <include layout="@layout/view_bottom_navigation" />
</LinearLayout>
