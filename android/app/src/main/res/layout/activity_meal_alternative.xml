<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_primary">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/space_16"
            android:paddingTop="@dimen/space_8"
            android:paddingBottom="@dimen/space_24">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/screen_header_height"
                android:background="@drawable/bg_screen_header"
                android:gravity="center_vertical">

                 <ImageButton
                     android:id="@+id/backButton"
                     android:layout_width="@dimen/screen_header_icon_size"
                     android:layout_height="@dimen/screen_header_icon_size"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Indietro"
                     android:padding="@dimen/space_8"
                    android:src="@drawable/ic_arrow_back"
                    app:tint="@color/text_primary" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Alternative IA"
                    android:textColor="@color/text_primary"
                    style="@style/Text.MyFitAI.ScreenTitle" />
            </LinearLayout>

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.MyFitAI.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_8">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    style="@style/Widget.MyFitAI.HomeSectionContent">

                    <TextView
                        android:id="@+id/sourceMealText"
                        style="@style/Text.MyFitAI.Section"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />

                    <TextView
                        android:id="@+id/constraintText"
                        style="@style/Text.MyFitAI.BodyCompact"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_4"
                        android:text="Le alternative mantengono lo stesso tipo/orario e le stesse calorie del pasto." />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:id="@+id/loadingRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_16"
                android:gravity="center"
                android:orientation="horizontal">

                <ProgressBar
                    android:layout_width="@dimen/progress_compact_size"
                    android:layout_height="@dimen/progress_compact_size" />

                <TextView
                    style="@style/Text.MyFitAI.BodyCompact"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_8"
                    android:text="Sto preparando 5 alternative equivalenti…" />
            </LinearLayout>

            <TextView
                android:id="@+id/providerText"
                style="@style/Text.MyFitAI.Micro"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_8"
                android:gravity="center"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/alternativesContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_12"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/statusText"
                style="@style/Text.MyFitAI.BodyCompact"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_12"
                android:gravity="center"
                android:visibility="gone" />

        </LinearLayout>
    </ScrollView>

    <include layout="@layout/view_bottom_navigation" />
</LinearLayout>
