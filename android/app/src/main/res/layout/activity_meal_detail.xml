<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_primary">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/meal_detail_hero_image_height">
                <ImageView
                    android:id="@+id/mealImage"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:src="@drawable/img_meal_lunch"
                    android:contentDescription="Foto pasto" />
                <FrameLayout
                    android:id="@+id/backButton"
                    android:layout_width="@dimen/screen_header_icon_size"
                    android:layout_height="@dimen/screen_header_icon_size"
                    android:layout_margin="@dimen/space_16"
                    android:background="@drawable/bg_logo_circle">
                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:padding="@dimen/space_10"
                        android:src="@drawable/ic_arrow_back"
                        android:contentDescription="Indietro" />
                </FrameLayout>
            </FrameLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="@dimen/space_16"
                android:paddingTop="@dimen/space_16"
                android:paddingBottom="@dimen/space_24">

                 <TextView android:id="@+id/mealTitle" style="@style/Text.MyFitAI.ScreenTitle" android:layout_width="match_parent" android:layout_height="wrap_content" />
                 <TextView android:id="@+id/mealSubtitle" style="@style/Text.MyFitAI.Body" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_2" />

                 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_12" android:background="@drawable/bg_card" android:orientation="horizontal" android:paddingVertical="@dimen/space_10">
                    <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center">
                         <TextView android:id="@+id/statKcal" style="@style/Text.MyFitAI.CardTitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textStyle="bold" />
                         <TextView style="@style/Text.MyFitAI.Caption" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Calorie" />
                    </LinearLayout>
                    <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center">
                         <TextView android:id="@+id/statProtein" style="@style/Text.MyFitAI.CardTitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textStyle="bold" />
                         <TextView style="@style/Text.MyFitAI.Caption" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Proteine" />
                    </LinearLayout>
                    <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center">
                         <TextView android:id="@+id/statCarbs" style="@style/Text.MyFitAI.CardTitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textStyle="bold" />
                         <TextView style="@style/Text.MyFitAI.Caption" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Carboidrati" />
                    </LinearLayout>
                    <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center">
                         <TextView android:id="@+id/statFat" style="@style/Text.MyFitAI.CardTitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textStyle="bold" />
                         <TextView style="@style/Text.MyFitAI.Caption" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Grassi" />
                    </LinearLayout>
                </LinearLayout>

                <com.myfitai.app.ui.widgets.SelectableSegmentView android:id="@+id/detailSegment" android:layout_width="match_parent" android:layout_height="@dimen/control_min_height" android:layout_marginTop="@dimen/space_16" />

                 <com.google.android.material.card.MaterialCardView
                     android:id="@+id/ingredientsCard"
                    style="@style/Widget.MyFitAI.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                      android:layout_marginTop="@dimen/space_8">
                    <LinearLayout
                        android:id="@+id/ingredientsContainer"
                        style="@style/Widget.MyFitAI.HomeSectionContent"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/preparationCard"
                    style="@style/Widget.MyFitAI.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:visibility="gone"
                    android:layout_marginTop="@dimen/space_8">
                    <TextView
                        android:id="@+id/preparationContainer"
                        style="@style/Text.MyFitAI.BodyCompact"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="@dimen/space_16"
                        android:lineSpacingExtra="@dimen/space_4"
                        android:visibility="gone" />
                </com.google.android.material.card.MaterialCardView>

                <TextView
                    android:id="@+id/mealError"
                    style="@style/Text.MyFitAI.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_16"
                    android:gravity="center"
                    android:visibility="gone" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/consumedButton"
                    style="@style/Widget.MyFitAI.Button.Primary"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/button_primary_min_height"
                    android:layout_marginTop="@dimen/space_20"
                    android:text="Segna come consumato"
                    android:textAllCaps="false"
                    android:textStyle="bold"
                    android:visibility="gone"
                    app:icon="@drawable/ic_check"
                    app:iconGravity="textStart" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/skippedButton"
                    style="@style/Widget.MyFitAI.Button.Outlined"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/button_secondary_min_height"
                    android:layout_marginTop="@dimen/space_8"
                    android:text="Segna come saltato"
                    android:textAllCaps="false"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/rescheduleButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="@dimen/space_12"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="@dimen/space_8"
                    android:visibility="gone">
                    <ImageView android:layout_width="@dimen/inline_icon_size" android:layout_height="@dimen/inline_icon_size" android:importantForAccessibility="no" android:src="@drawable/ic_refresh" />
                         <TextView style="@style/Text.MyFitAI.Body" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="@dimen/space_6" android:text="Sposta orario" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
    <include layout="@layout/view_bottom_navigation" />
</LinearLayout>
