<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_primary">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="200dp">
                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:src="@drawable/img_meal_lunch"
                    android:contentDescription="Foto pasto" />
                <FrameLayout
                    android:id="@+id/backButton"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_margin="@dimen/space_16"
                    android:background="@drawable/bg_logo_circle">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:text="‹"
                        android:textSize="24sp"
                        android:textColor="@color/text_primary" />
                </FrameLayout>
            </FrameLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/space_16">

                <TextView
                    android:id="@+id/mealTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Riso basmati, pollo e verdure"
                    android:textColor="@color/text_primary"
                    android:textSize="19sp"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/mealSubtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_2"
                    android:text="Pranzo – 13:00"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_16"
                    android:orientation="horizontal">
                    <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center">
                        <TextView android:id="@+id/statKcal" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="710 kcal" android:textColor="@color/text_primary" android:textStyle="bold" android:textSize="16sp" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Calorie" android:textColor="@color/text_secondary" android:textSize="12sp" />
                    </LinearLayout>
                    <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center">
                        <TextView android:id="@+id/statProtein" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="55g" android:textColor="@color/text_primary" android:textStyle="bold" android:textSize="16sp" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Proteine" android:textColor="@color/text_secondary" android:textSize="12sp" />
                    </LinearLayout>
                    <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center">
                        <TextView android:id="@+id/statCarbs" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="85g" android:textColor="@color/text_primary" android:textStyle="bold" android:textSize="16sp" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Carboidrati" android:textColor="@color/text_secondary" android:textSize="12sp" />
                    </LinearLayout>
                    <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center">
                        <TextView android:id="@+id/statFat" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="15g" android:textColor="@color/text_primary" android:textStyle="bold" android:textSize="16sp" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Grassi" android:textColor="@color/text_secondary" android:textSize="12sp" />
                    </LinearLayout>
                </LinearLayout>

                <com.myfitai.app.ui.widgets.SelectableSegmentView
                    android:id="@+id/detailSegment"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="@dimen/space_16" />

                <LinearLayout
                    android:id="@+id/ingredientsContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_8"
                    android:background="@drawable/bg_card"
                    android:orientation="vertical"
                    android:paddingHorizontal="@dimen/space_16">
                    <com.myfitai.app.ui.widgets.IngredientRowView android:id="@+id/ingredientRice" android:layout_width="match_parent" android:layout_height="wrap_content" />
                    <com.myfitai.app.ui.widgets.IngredientRowView android:id="@+id/ingredientChicken" android:layout_width="match_parent" android:layout_height="wrap_content" />
                    <com.myfitai.app.ui.widgets.IngredientRowView android:id="@+id/ingredientZucchini" android:layout_width="match_parent" android:layout_height="wrap_content" />
                    <com.myfitai.app.ui.widgets.IngredientRowView android:id="@+id/ingredientCarrot" android:layout_width="match_parent" android:layout_height="wrap_content" />
                    <com.myfitai.app.ui.widgets.IngredientRowView android:id="@+id/ingredientOil" android:layout_width="match_parent" android:layout_height="wrap_content" />
                    <com.myfitai.app.ui.widgets.IngredientRowView android:id="@+id/ingredientSalt" android:layout_width="match_parent" android:layout_height="wrap_content" />
                </LinearLayout>

                <TextView
                    android:id="@+id/preparationContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_8"
                    android:background="@drawable/bg_card"
                    android:padding="@dimen/space_16"
                    android:text="1. Cuoci il riso basmati in acqua salata.\n2. Scotta il petto di pollo in padella con un filo d'olio.\n3. Salta zucchine e carote a fuoco vivo.\n4. Componi la bowl e regola di sale e spezie."
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp"
                    android:lineSpacingExtra="4dp"
                    android:visibility="gone" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/consumedButton"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="@dimen/space_20"
                    android:text="Segna come consumato"
                    android:textAllCaps="false"
                    android:textStyle="bold"
                    app:icon="@drawable/ic_check"
                    app:iconGravity="textStart"
                    app:cornerRadius="12dp"
                    app:backgroundTint="@color/accent_green" />

                <LinearLayout
                    android:id="@+id/rescheduleButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="@dimen/space_12"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="@dimen/space_8">
                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_refresh" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_6"
                        android:text="Sposta orario"
                        android:textColor="@color/text_secondary"
                        android:textSize="14sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
    <include layout="@layout/view_bottom_navigation" />
</LinearLayout>
