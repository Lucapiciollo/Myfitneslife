<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@color/bg_primary">
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingHorizontal="@dimen/space_16" android:paddingTop="@dimen/space_8" android:paddingBottom="@dimen/space_24">
            <LinearLayout android:layout_width="match_parent" android:layout_height="@dimen/screen_header_height" android:gravity="center_vertical" android:background="@drawable/bg_screen_header" android:paddingHorizontal="@dimen/space_8">
                 <ImageButton android:id="@+id/backButton" android:layout_width="@dimen/icon_button_size" android:layout_height="@dimen/icon_button_size" android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="Indietro" android:padding="@dimen/space_8" android:src="@drawable/ic_arrow_back" app:tint="@color/text_primary" />
                <TextView style="@style/Text.MyFitAI.ScreenTitle" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="Configurazione alimentazione" />
                  <Space android:layout_width="@dimen/icon_button_size" android:layout_height="@dimen/layout_geometry_shim_thickness" />
            </LinearLayout>
            <TextView style="@style/Text.MyFitAI.BodyCompact" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_8" android:text="Qui configuri come viene organizzato e generato il tuo piano. Le impostazioni non cambiano i dati storici." />
            <com.google.android.material.card.MaterialCardView style="@style/Widget.MyFitAI.Card" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_16">
                 <LinearLayout style="@style/Widget.MyFitAI.WhiteCardContent" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                  <TextView style="@style/Text.MyFitAI.Section" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Struttura dei pasti" />
                <TextView android:id="@+id/mealCountValue" style="@style/Text.MyFitAI.BodyCompact" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_8" />
                  <com.google.android.material.button.MaterialButton android:id="@+id/mealCountButton" style="@style/Widget.MyFitAI.Button.Outlined" android:layout_width="match_parent" android:layout_height="@dimen/button_secondary_min_height" android:layout_marginTop="@dimen/space_10" android:text="Modifica pasti al giorno" android:textAllCaps="false" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <com.google.android.material.card.MaterialCardView style="@style/Widget.MyFitAI.Card" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_12">
                <LinearLayout style="@style/Widget.MyFitAI.WhiteCardContent" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                    <TextView style="@style/Text.MyFitAI.Section" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Giorni di allenamento" />
                    <TextView android:id="@+id/trainingProgramValue" style="@style/Text.MyFitAI.BodyCompact" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_8" />
                    <TextView android:id="@+id/trainingProgramNotice" style="@style/Text.MyFitAI.Caption" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_4" android:text="Salvato nel profilo. Alla prossima generazione il piano usa calorie e menu diversi nei giorni di allenamento." />
                    <com.google.android.material.chip.ChipGroup android:id="@+id/trainingDaysGroup" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_8" app:singleSelection="false" app:chipSpacingHorizontal="@dimen/space_8" app:chipSpacingVertical="@dimen/space_8">
                        <com.google.android.material.chip.Chip android:id="@+id/trainingDayMonday" style="@style/Widget.Material3.Chip.Filter" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Lun" android:contentDescription="Lunedì" android:checkable="true" app:chipBackgroundColor="@color/chip_background_selector" android:textColor="@color/chip_text_selector" app:checkedIconVisible="false" app:chipStrokeColor="@color/divider" app:chipStrokeWidth="@dimen/border_width_default" />
                        <com.google.android.material.chip.Chip android:id="@+id/trainingDayTuesday" style="@style/Widget.Material3.Chip.Filter" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Mar" android:contentDescription="Martedì" android:checkable="true" app:chipBackgroundColor="@color/chip_background_selector" android:textColor="@color/chip_text_selector" app:checkedIconVisible="false" app:chipStrokeColor="@color/divider" app:chipStrokeWidth="@dimen/border_width_default" />
                        <com.google.android.material.chip.Chip android:id="@+id/trainingDayWednesday" style="@style/Widget.Material3.Chip.Filter" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Mer" android:contentDescription="Mercoledì" android:checkable="true" app:chipBackgroundColor="@color/chip_background_selector" android:textColor="@color/chip_text_selector" app:checkedIconVisible="false" app:chipStrokeColor="@color/divider" app:chipStrokeWidth="@dimen/border_width_default" />
                        <com.google.android.material.chip.Chip android:id="@+id/trainingDayThursday" style="@style/Widget.Material3.Chip.Filter" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Gio" android:contentDescription="Giovedì" android:checkable="true" app:chipBackgroundColor="@color/chip_background_selector" android:textColor="@color/chip_text_selector" app:checkedIconVisible="false" app:chipStrokeColor="@color/divider" app:chipStrokeWidth="@dimen/border_width_default" />
                        <com.google.android.material.chip.Chip android:id="@+id/trainingDayFriday" style="@style/Widget.Material3.Chip.Filter" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Ven" android:contentDescription="Venerdì" android:checkable="true" app:chipBackgroundColor="@color/chip_background_selector" android:textColor="@color/chip_text_selector" app:checkedIconVisible="false" app:chipStrokeColor="@color/divider" app:chipStrokeWidth="@dimen/border_width_default" />
                        <com.google.android.material.chip.Chip android:id="@+id/trainingDaySaturday" style="@style/Widget.Material3.Chip.Filter" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Sab" android:contentDescription="Sabato" android:checkable="true" app:chipBackgroundColor="@color/chip_background_selector" android:textColor="@color/chip_text_selector" app:checkedIconVisible="false" app:chipStrokeColor="@color/divider" app:chipStrokeWidth="@dimen/border_width_default" />
                        <com.google.android.material.chip.Chip android:id="@+id/trainingDaySunday" style="@style/Widget.Material3.Chip.Filter" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Dom" android:contentDescription="Domenica" android:checkable="true" app:chipBackgroundColor="@color/chip_background_selector" android:textColor="@color/chip_text_selector" app:checkedIconVisible="false" app:chipStrokeColor="@color/divider" app:chipStrokeWidth="@dimen/border_width_default" />
                    </com.google.android.material.chip.ChipGroup>
                    <com.google.android.material.button.MaterialButton android:id="@+id/trainingSessionButton" style="@style/Widget.MyFitAI.Button.Outlined" android:layout_width="match_parent" android:layout_height="@dimen/button_secondary_min_height" android:layout_marginTop="@dimen/space_10" android:text="Durata e intensità" android:textAllCaps="false" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/trainingTimeButton" style="@style/Widget.MyFitAI.Button.Outlined" android:layout_width="match_parent" android:layout_height="@dimen/button_secondary_min_height" android:layout_marginTop="@dimen/space_8" android:text="Orario abituale (facoltativo)" android:textAllCaps="false" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <com.google.android.material.card.MaterialCardView style="@style/Widget.MyFitAI.Card" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_12">
                 <LinearLayout style="@style/Widget.MyFitAI.WhiteCardContent" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                        <TextView style="@style/Text.MyFitAI.Section" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Generazione automatica" />
                        <TextView android:id="@+id/scheduleValue" style="@style/Text.MyFitAI.BodyCompact" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_4" />
                    </LinearLayout>
                    <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/scheduleSwitch" style="@style/Widget.MyFitAI.SettingsSwitch" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                </LinearLayout>
                  <com.google.android.material.button.MaterialButton android:id="@+id/scheduleButton" style="@style/Widget.MyFitAI.Button.Outlined" android:layout_width="match_parent" android:layout_height="@dimen/button_secondary_min_height" android:layout_marginTop="@dimen/space_10" android:text="Modifica frequenza e ora" android:textAllCaps="false" />
                  <com.google.android.material.button.MaterialButton android:id="@+id/nutritionPathButton" style="@style/Widget.MyFitAI.Button.Outlined" android:layout_width="match_parent" android:layout_height="@dimen/button_secondary_min_height" android:layout_marginTop="@dimen/space_8" android:text="Suggerisci il percorso nutrizionale" android:textAllCaps="false" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
