<?xml version="1.0" encoding="utf-8"?>
<!-- Attesa IA: titolo e messaggio annunciati (live region), indicatore descritto e Annulla (48dp). Usato da import foto e analisi BIA. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/space_8"
    android:background="@drawable/bg_card"
    android:orientation="vertical"
    android:padding="@dimen/space_12"
    android:visibility="gone">

    <TextView
        android:id="@+id/biaWaitTitle"
        style="@style/Text.MyFitAI.SettingsLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <TextView
        android:id="@+id/biaWaitMessage"
        style="@style/Text.MyFitAI.SettingsDescription"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_4" />

    <ProgressBar
        android:id="@+id/biaWaitProgress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_8"
        android:contentDescription="@string/bia_k4_wait_progress_cd"
        android:indeterminate="true" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/biaWaitCancel"
        style="@style/Widget.MyFitAI.Button.Text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_4"
        android:minHeight="@dimen/control_min_height"
        android:text="@string/bia_k4_wait_cancel"
        android:textAllCaps="false" />
</LinearLayout>
