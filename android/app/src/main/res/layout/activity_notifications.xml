<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:src="@drawable/img_notification_background"
        android:contentDescription="Sfondo promemoria" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_scrim_dark" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="@dimen/space_20">

        <LinearLayout android:layout_width="match_parent" android:layout_height="@dimen/screen_header_icon_size" android:gravity="center_vertical">
            <ImageButton
                android:id="@+id/backButton"
                android:layout_width="@dimen/screen_header_icon_size"
                android:layout_height="@dimen/screen_header_icon_size"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Indietro"
                android:padding="@dimen/space_8"
                android:src="@drawable/ic_arrow_back"
                app:tint="@color/white" />
        </LinearLayout>

        <ImageView
            android:layout_width="@dimen/notification_lock_icon_size"
            android:layout_height="@dimen/notification_lock_icon_size"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="@dimen/space_16"
            android:src="@drawable/ic_lock"
            android:importantForAccessibility="no" />

        <TextView
            android:id="@+id/mainClock"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_8"
            android:gravity="center"
            android:text="--:--"
            android:textColor="@color/white"
            android:textSize="58sp" />

        <TextView
            android:id="@+id/mainDate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="—"
            android:textColor="@color/white"
            style="@style/Text.MyFitAI.Body" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_28"
            android:orientation="vertical"
            android:background="@drawable/bg_frosted_card"
            android:padding="@dimen/space_12">

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                <ImageView
                    android:layout_width="@dimen/notification_lock_icon_size"
                    android:layout_height="@dimen/notification_lock_icon_size"
                    android:src="@drawable/img_app_icon"
                    android:scaleType="centerCrop"
                    android:contentDescription="Icona app" />
                <TextView
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_8"
                     android:text="MyFitAI"
                    android:textColor="@color/text_primary"
                    android:textStyle="bold"
                    style="@style/Text.MyFitAI.CardTitle" />
                <TextView
                    android:id="@+id/notificationTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="--:--"
                    android:textColor="@color/text_secondary"
                    style="@style/Text.MyFitAI.Caption" />
            </LinearLayout>

            <TextView
                android:id="@+id/reminderTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_8"
                android:text="Promemoria pasto"
                android:textColor="@color/text_primary"
                android:textStyle="bold"
                style="@style/Text.MyFitAI.CardTitle" />
            <TextView
                android:id="@+id/reminderText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_2"
                android:text="Apri il piano per i dettagli"
                android:textColor="@color/text_secondary"
                style="@style/Text.MyFitAI.Body" />

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/mealImage"
                android:layout_width="match_parent"
                android:layout_height="@dimen/notification_meal_image_height"
                android:layout_marginTop="@dimen/space_12"
                android:scaleType="centerCrop"
                android:src="@drawable/img_meal_lunch"
                android:contentDescription="Immagine pasto"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.MyFitAI.Thumbnail" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/openMealButton"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_primary_min_height"
            android:layout_marginTop="@dimen/space_16"
            android:background="@drawable/bg_frosted_pill"
            android:text="Apri pasto"
            android:textColor="@color/text_primary"
            android:textStyle="bold"
            android:textAllCaps="false" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/snoozeButton"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_secondary_min_height"
            android:layout_marginTop="@dimen/space_8"
            android:background="@drawable/bg_frosted_pill_soft"
            android:text="Posticipa 10 min"
            android:textColor="@color/white"
            android:textAllCaps="false" />
    </LinearLayout>
</FrameLayout>
