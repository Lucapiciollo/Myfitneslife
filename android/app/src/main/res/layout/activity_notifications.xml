<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:src="@drawable/img_notification_background"
        android:contentDescription="Sfondo schermata di blocco" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_scrim_dark" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="@dimen/space_20">

        <LinearLayout android:layout_width="match_parent" android:layout_height="40dp" android:gravity="center_vertical">
            <TextView android:id="@+id/backButton" android:layout_width="40dp" android:layout_height="40dp" android:gravity="center" android:text="‹" android:textSize="28sp" android:textColor="@color/white" />
        </LinearLayout>

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="@dimen/space_16"
            android:src="@drawable/ic_lock"
            android:importantForAccessibility="no" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_8"
            android:gravity="center"
            android:text="12:15"
            android:textColor="@color/white"
            android:textSize="58sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="Lun 14 Settembre"
            android:textColor="@color/white"
            android:textSize="15sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_28"
            android:orientation="vertical"
            android:background="@drawable/bg_frosted_card"
            android:padding="@dimen/space_12">

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/img_app_icon"
                    android:scaleType="centerCrop"
                    android:contentDescription="Icona app" />
                <TextView
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_8"
                    android:text="MyFitnessAI"
                    android:textColor="@color/text_primary"
                    android:textStyle="bold"
                    android:textSize="13sp" />
                <TextView
                    android:id="@+id/notificationTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="12:15"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_8"
                android:text="Tra 15 minuti: Pranzo"
                android:textColor="@color/text_primary"
                android:textStyle="bold"
                android:textSize="14sp" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_2"
                android:text="Riso basmati, pollo e verdure 💪"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />

            <com.google.android.material.imageview.ShapeableImageView
                android:layout_width="match_parent"
                android:layout_height="170dp"
                android:layout_marginTop="@dimen/space_12"
                android:scaleType="centerCrop"
                android:src="@drawable/img_meal_lunch"
                android:contentDescription="Foto pasto"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.MyFitAI.Thumbnail" />
        </LinearLayout>

        <TextView
            android:id="@+id/openMealButton"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="@dimen/space_16"
            android:gravity="center"
            android:background="@drawable/bg_frosted_pill"
            android:text="Apri pasto"
            android:textColor="@color/text_primary"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/snoozeButton"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="@dimen/space_8"
            android:gravity="center"
            android:background="@drawable/bg_frosted_pill_soft"
            android:text="Posticipa 10 min"
            android:textColor="@color/white" />
    </LinearLayout>
</FrameLayout>
