<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_primary">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/space_16">

            <TextView
                style="@style/Text.MyFitAI.ScreenTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Percorso nutrizionale" />

            <TextView
                android:id="@+id/currentGoalText"
                style="@style/Text.MyFitAI.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_12"
                android:visibility="gone" />

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.MyFitAI.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_16">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    style="@style/Widget.MyFitAI.HomeSectionContent">

                    <TextView
                        android:id="@+id/recommendationPath"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Analisi in corso…"
                        android:textColor="@color/accent_green_dark"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/recommendationReason"
                        style="@style/Text.MyFitAI.Body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_8" />

                    <TextView
                        android:id="@+id/recommendationExplanation"
                        style="@style/Text.MyFitAI.Body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_8"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/recommendationConfidence"
                        style="@style/Text.MyFitAI.Caption"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_8" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/pathStatus"
                style="@style/Text.MyFitAI.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_16" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/alternativesCard"
                style="@style/Widget.MyFitAI.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_12"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    style="@style/Widget.MyFitAI.HomeSectionContent">

                    <TextView
                        style="@style/Text.MyFitAI.Section"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Altri percorsi disponibili" />

                    <LinearLayout
                        android:id="@+id/alternativesContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_8"
                        android:orientation="vertical" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/goalConfirmationHint"
                style="@style/Text.MyFitAI.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_16"
                android:text="L’obiettivo attuale non cambia finché non confermi una scelta."
                android:visibility="gone" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/chooseButton"
        style="@style/Widget.MyFitAI.Button.Primary"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginHorizontal="@dimen/space_16"
        android:layout_marginTop="@dimen/space_8"
        android:layout_marginBottom="@dimen/space_16"
        android:text="Scegli questo percorso"
        android:enabled="false" />
</LinearLayout>
