<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@color/bg_primary">
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="@dimen/space_20">
            <TextView android:id="@+id/pathTitle" style="@style/Text.MyFitAI.ScreenTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Percorso nutrizionale" />
            <TextView android:id="@+id/pathSubtitle" style="@style/Text.MyFitAI.Body" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_8" android:text="Il suggerimento è informativo: scegli tu il percorso da seguire." />
            <com.google.android.material.card.MaterialCardView android:id="@+id/recommendationCard" style="@style/Widget.MyFitAI.Card" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_20">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="@dimen/space_16">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Percorso suggerito" android:textColor="@color/accent_green_dark" android:textSize="13sp" android:textStyle="bold" />
                    <TextView android:id="@+id/recommendationPath" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_8" android:textColor="@color/text_primary" android:textSize="22sp" android:textStyle="bold" />
                    <TextView android:id="@+id/recommendationReason" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_8" android:textColor="@color/text_secondary" android:textSize="14sp" />
                    <TextView android:id="@+id/recommendationConfidence" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_8" android:textColor="@color/text_muted" android:textSize="12sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_20" android:text="Alternative" android:textColor="@color/text_primary" android:textSize="16sp" android:textStyle="bold" />
            <LinearLayout android:id="@+id/alternativesContainer" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_8" android:orientation="vertical" />
            <TextView android:id="@+id/pathStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_12" android:textColor="@color/text_secondary" android:textSize="13sp" />
            <com.google.android.material.button.MaterialButton android:id="@+id/chooseButton" style="@style/Widget.MyFitAI.Button.Primary" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="@dimen/space_20" android:text="Scegli questo percorso" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
