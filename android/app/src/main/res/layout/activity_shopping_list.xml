<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_primary">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
             android:paddingHorizontal="@dimen/space_16"
             android:paddingTop="@dimen/space_8"
             android:paddingBottom="@dimen/space_24">

            <LinearLayout style="@style/Widget.MyFitAI.ScreenHeader" android:layout_height="@dimen/weekly_screen_header_height">
                <ImageButton
                    android:id="@+id/backButton"
                    android:layout_width="@dimen/icon_button_size"
                    android:layout_height="@dimen/icon_button_size"
                     android:background="?attr/selectableItemBackgroundBorderless"
                    android:padding="@dimen/space_8"
                    android:src="@drawable/ic_arrow_back"
                    android:contentDescription="Indietro"
                    app:tint="@color/text_primary" />
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                    <TextView style="@style/Text.MyFitAI.ScreenTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:text="Lista della spesa" />
                    <TextView android:id="@+id/weekLabel" style="@style/Text.MyFitAI.ScreenDate" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_4" android:gravity="center" />
                </LinearLayout>
                <Space android:layout_width="@dimen/icon_button_size" android:layout_height="1dp" />
            </LinearLayout>

            <TextView
                android:id="@+id/versionLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="start"
                android:textColor="@color/text_muted"
                 style="@style/Text.MyFitAI.Caption"
                android:visibility="gone" />

            <com.myfitai.app.ui.widgets.SelectableSegmentView
                android:id="@+id/viewModeSegment"
                android:layout_width="match_parent"
                android:layout_height="@dimen/control_min_height"
                 android:layout_marginTop="@dimen/space_12" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_8"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <com.myfitai.app.ui.widgets.SelectableSegmentView
                    android:id="@+id/filterSegment"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="@dimen/shopping_filter_segment_height" />
                <ImageView
                    android:id="@+id/resetButton"
                    android:layout_width="@dimen/dashboard_pill_height"
                    android:layout_height="@dimen/dashboard_pill_height"
                    android:layout_marginStart="@dimen/space_8"
                    android:padding="@dimen/space_4"
                    android:src="@drawable/ic_refresh"
                    android:contentDescription="Azzera stato lista" />
            </LinearLayout>

            <TextView
                android:id="@+id/statusSummary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_12"
                android:textColor="@color/text_secondary"
                 style="@style/Text.MyFitAI.Caption" />

            <ProgressBar
                android:id="@+id/loadingProgress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                 android:layout_marginTop="@dimen/space_12"
                android:visibility="gone" />

            <TextView
                android:id="@+id/emptyText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_24"
                 android:gravity="start"
                  android:padding="@dimen/space_12"
                  android:background="@drawable/bg_card"
                android:textColor="@color/text_secondary"
                 style="@style/Text.MyFitAI.Body"
                android:visibility="gone" />

             <com.google.android.material.card.MaterialCardView
                 android:id="@+id/itemsCard"
                 style="@style/Widget.MyFitAI.Card"
                android:layout_width="match_parent"
                 android:layout_height="wrap_content"
                 android:layout_marginTop="@dimen/space_8"
                 android:visibility="gone">
                <LinearLayout
                    style="@style/Widget.MyFitAI.HomeSectionContent"
                    android:id="@+id/itemsContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_12"
                android:text="Tocca una riga per scegliere Da comprare, Preso o Già in dispensa. La spunta rapida indica Preso."
                android:textColor="@color/text_muted"
                 style="@style/Text.MyFitAI.Micro" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/exportButton"
                android:layout_width="match_parent"
                android:layout_height="@dimen/button_primary_min_height"
                 style="@style/Widget.MyFitAI.Button.Primary"
                  android:layout_marginTop="@dimen/space_12"
                android:text="Condividi lista"
                android:textAllCaps="false"
                app:icon="@drawable/ic_setting_export"
                app:iconTint="@color/white"
                 app:iconGravity="textStart" />
        </LinearLayout>
    </ScrollView>
    <include layout="@layout/view_bottom_navigation" />
</LinearLayout>
