<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_primary">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:clipToPadding="false"
            android:paddingHorizontal="@dimen/space_16"
            android:paddingTop="@dimen/space_8"
            android:paddingBottom="@dimen/space_24">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/screen_header_height"
                android:background="@drawable/bg_screen_header"
                android:gravity="center_vertical">
                <ImageButton
                    android:id="@+id/backButton"
                    android:layout_width="@dimen/icon_button_size"
                    android:layout_height="@dimen/icon_button_size"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Indietro"
                    android:padding="@dimen/space_8"
                    android:src="@drawable/ic_arrow_back"
                    app:tint="@color/text_primary" />
                <TextView
                    style="@style/Text.MyFitAI.ScreenTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="Esporta / importa dati" />
                <Space android:layout_width="@dimen/icon_button_size" android:layout_height="1dp" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_12"
                android:text="Puoi esportare i dati del profilo attivo oppure importare uno storico BIA. Le rilevazioni già presenti non vengono sovrascritte."
                style="@style/Text.MyFitAI.Body" />

            <com.myfitai.app.ui.widgets.SettingListCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_12">
                <LinearLayout
                    style="@style/Widget.MyFitAI.HomeSectionContent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <com.myfitai.app.ui.widgets.SettingRowView
                        android:id="@+id/importBiaHistoryRow"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:srIcon="@drawable/ic_setting_export"
                        app:srLabel="Importa storico BIA"
                        app:srDescription="Aggiunge le rilevazioni mancanti senza sovrascrivere quelle già presenti" />
                    <com.myfitai.app.ui.widgets.SettingRowView
                        android:id="@+id/saveBackupRow"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:srIcon="@drawable/ic_setting_export"
                        app:srLabel="Salva backup su disco"
                        app:srDescription="Salva tutti i dati del profilo in un file JSON ripristinabile" />
                    <com.myfitai.app.ui.widgets.SettingRowView
                        android:id="@+id/importBackupRow"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:srIcon="@drawable/ic_setting_export"
                        app:srLabel="Importa backup da disco"
                        app:srDescription="Crea un nuovo profilo dai dati del file JSON" />
                </LinearLayout>
            </com.myfitai.app.ui.widgets.SettingListCardView>

            <com.myfitai.app.ui.widgets.SettingListCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_12">
                <LinearLayout
                    style="@style/Widget.MyFitAI.HomeSectionContent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <com.myfitai.app.ui.widgets.SettingRowView
                        android:id="@+id/exportJsonRow"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:srIcon="@drawable/ic_setting_export"
                        app:srLabel="Esporta JSON"
                        app:srDescription="Completo: profilo, BIA, misure, allenamenti, piani e tutte le versioni, sgarri e review" />
                    <com.myfitai.app.ui.widgets.SettingRowView
                        android:id="@+id/exportCsvRow"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:srIcon="@drawable/ic_setting_export"
                        app:srLabel="Pacchetto CSV (.zip)"
                        app:srDescription="Tabelle separate; gerarchia completa dei piani inclusa in JSON nel pacchetto" />
                    <com.myfitai.app.ui.widgets.SettingRowView
                        android:id="@+id/exportPdfRow"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:srIcon="@drawable/ic_setting_export"
                        app:srLabel="Report profilo PDF"
                        app:srDescription="Report grafico: snapshot, BIA, misure, proporzioni, trend, alimentazione e attività" />
                    <com.myfitai.app.ui.widgets.SettingRowView
                        android:id="@+id/exportWeeklyPlanPdfRow"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:srIcon="@drawable/ic_setting_export"
                        app:srLabel="Dieta settimanale PDF"
                        app:srDescription="7 giorni ben impaginati con pasti, ingredienti, dosi e lista della spesa aggregata in fondo" />
                </LinearLayout>
            </com.myfitai.app.ui.widgets.SettingListCardView>

            <ProgressBar
                android:id="@+id/exportProgress"
                android:layout_width="@dimen/progress_indicator_size"
                android:layout_height="@dimen/progress_indicator_size"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="@dimen/space_20"
                android:visibility="gone" />

            <TextView
                android:id="@+id/exportStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_10"
                android:gravity="center"
                style="@style/Text.MyFitAI.Caption"
                android:visibility="gone" />
        </LinearLayout>
    </ScrollView>

    <include layout="@layout/view_bottom_navigation" />
</LinearLayout>
