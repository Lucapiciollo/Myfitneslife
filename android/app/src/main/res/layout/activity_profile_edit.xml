<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_primary">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
         android:background="@drawable/bg_screen_header"
         android:paddingHorizontal="@dimen/space_8"
         android:paddingTop="@dimen/space_8"
         android:paddingBottom="@dimen/space_8">

        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/backButton"
            android:layout_width="@dimen/icon_button_size"
            android:layout_height="@dimen/icon_button_size"
             android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Indietro"
             android:padding="@dimen/space_8"
             android:src="@drawable/ic_arrow_back"
             app:tint="@color/text_primary" />

        <TextView
            android:id="@+id/title"
            style="@style/Text.MyFitAI.ScreenTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
             android:gravity="center"
             android:textColor="@color/text_primary"
            android:text="Modifica profilo" />

        <Space android:layout_width="@dimen/icon_button_size" android:layout_height="@dimen/icon_button_size" />
    </LinearLayout>

         <androidx.core.widget.NestedScrollView
        android:id="@+id/profileEditScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true"
         android:paddingBottom="@dimen/space_32">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/space_16">

            <TextView
                android:id="@+id/bootstrapHint"
                style="@style/Text.MyFitAI.BodyCompact"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_8"
                android:paddingHorizontal="@dimen/space_4"
                android:text="Crea il profilo principale. I dati contrassegnati sono necessari per i calcoli locali."
                android:visibility="gone" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_8"
                 style="@style/Widget.MyFitAI.FormCard">
                <LinearLayout
                    style="@style/Widget.MyFitAI.CompactSectionContent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                <com.google.android.material.textview.MaterialTextView
                    style="@style/Text.MyFitAI.Section"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Dati personali" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/nameLayout"
                    style="@style/Widget.MyFitAI.InputCompact"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_12"
                    android:hint="Nome profilo">
                    <com.google.android.material.textfield.TextInputEditText
                style="@style/Widget.MyFitAI.InputEditTextCompact"
                        android:id="@+id/nameInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textPersonName"
                        android:maxLines="1" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/birthDateLayout"
                    style="@style/Widget.MyFitAI.InputCompact"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_8"
                    android:hint="Data di nascita"
                    app:endIconDrawable="@drawable/ic_calendar"
                    app:endIconMode="custom">
                    <com.google.android.material.textfield.TextInputEditText
                style="@style/Widget.MyFitAI.InputEditTextCompact"
                        android:id="@+id/birthDateInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:clickable="true"
                        android:focusable="false"
                        android:inputType="none" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/sexLayout"
                    style="@style/Widget.MyFitAI.InputDropdownCompact"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_8"
                    android:hint="Sesso biologico">
                    <AutoCompleteTextView
                        style="@style/Widget.MyFitAI.InputDropdownTextCompact"
                        android:id="@+id/sexInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="none" />
                </com.google.android.material.textfield.TextInputLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_8"
                    android:orientation="horizontal">
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/heightLayout"
                        style="@style/Widget.MyFitAI.InputCompact"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:hint="Altezza (cm)">
                        <com.google.android.material.textfield.TextInputEditText
                style="@style/Widget.MyFitAI.InputEditTextCompact"
                            android:id="@+id/heightInput"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="numberDecimal"
                            android:maxLines="1" />
                    </com.google.android.material.textfield.TextInputLayout>
                    <Space android:layout_width="@dimen/space_8" android:layout_height="1dp" />
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/weightLayout"
                        style="@style/Widget.MyFitAI.InputCompact"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:hint="Peso (kg)">
                        <com.google.android.material.textfield.TextInputEditText
                style="@style/Widget.MyFitAI.InputEditTextCompact"
                            android:id="@+id/weightInput"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="numberDecimal"
                            android:maxLines="1" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_12"
                 style="@style/Widget.MyFitAI.FormCard">
                <LinearLayout
                    style="@style/Widget.MyFitAI.CompactSectionContent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/goalSectionTitle"
                    style="@style/Text.MyFitAI.Section"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Obiettivo e attività" />

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/goalAdvisorHint"
                    style="@style/Text.MyFitAI.Micro"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_4"
                    android:text="MyFitAI consiglierà l'obiettivo dopo aver analizzato i dati disponibili."
                    android:visibility="gone" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/goalLayout"
                    style="@style/Widget.MyFitAI.InputDropdownCompact"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_12"
                    android:hint="Obiettivo">
                    <AutoCompleteTextView
                        style="@style/Widget.MyFitAI.InputDropdownTextCompact"
                        android:id="@+id/goalInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="none" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/activityLayout"
                    style="@style/Widget.MyFitAI.InputDropdownCompact"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_8"
                    android:hint="Livello di attività">
                    <AutoCompleteTextView
                        style="@style/Widget.MyFitAI.InputDropdownTextCompact"
                        android:id="@+id/activityInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="none" />
                </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_12"
                 style="@style/Widget.MyFitAI.FormCard">
                <LinearLayout
                    style="@style/Widget.MyFitAI.CompactSectionContent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                <com.google.android.material.textview.MaterialTextView
                    style="@style/Text.MyFitAI.Section"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Giornata" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_12"
                    android:orientation="horizontal">
                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="0dp"
                        style="@style/Widget.MyFitAI.InputCompact"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:hint="Sveglia">
                        <com.google.android.material.textfield.TextInputEditText
                style="@style/Widget.MyFitAI.InputEditTextCompact"
                            android:id="@+id/wakeTimeInput"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:clickable="true"
                            android:focusable="false"
                            android:inputType="none" />
                    </com.google.android.material.textfield.TextInputLayout>
                    <Space android:layout_width="@dimen/space_8" android:layout_height="1dp" />
                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="0dp"
                        style="@style/Widget.MyFitAI.InputCompact"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:hint="Sonno">
                        <com.google.android.material.textfield.TextInputEditText
                style="@style/Widget.MyFitAI.InputEditTextCompact"
                            android:id="@+id/sleepTimeInput"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:clickable="true"
                            android:focusable="false"
                            android:inputType="none" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_12"
                 style="@style/Widget.MyFitAI.FormCard">
                <LinearLayout
                    style="@style/Widget.MyFitAI.CompactSectionContent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                <com.google.android.material.textview.MaterialTextView
                    style="@style/Text.MyFitAI.Section"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Preferenze e vincoli alimentari" />

                <com.google.android.material.textview.MaterialTextView
                    style="@style/Text.MyFitAI.SettingsDescription"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_4"
                    android:text="Separa più alimenti con una virgola. Preferenze e alimenti non graditi vengono rispettati quando possibile; allergie, intolleranze ed esclusioni sono vincoli rigidi." />

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    style="@style/Widget.MyFitAI.InputCompact"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_12"
                    android:hint="Alimenti preferiti">
                    <com.google.android.material.textfield.TextInputEditText
                style="@style/Widget.MyFitAI.InputEditTextCompact"
                        android:id="@+id/preferredFoodsInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textCapSentences"
                        android:maxLines="2" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.MyFitAI.InputCompact"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_8"
                    android:hint="Alimenti non graditi">
                    <com.google.android.material.textfield.TextInputEditText
                style="@style/Widget.MyFitAI.InputEditTextCompact"
                        android:id="@+id/dislikedFoodsInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textCapSentences"
                        android:maxLines="2" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.MyFitAI.InputCompact"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_8"
                    android:hint="Alimenti da escludere">
                    <com.google.android.material.textfield.TextInputEditText
                style="@style/Widget.MyFitAI.InputEditTextCompact"
                        android:id="@+id/excludedFoodsInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textCapSentences"
                        android:maxLines="2" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.MyFitAI.InputCompact"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_8"
                    android:hint="Intolleranze">
                    <com.google.android.material.textfield.TextInputEditText
                style="@style/Widget.MyFitAI.InputEditTextCompact"
                        android:id="@+id/intolerancesInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textCapSentences"
                        android:maxLines="2" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.MyFitAI.InputCompact"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_8"
                    android:hint="Allergie">
                    <com.google.android.material.textfield.TextInputEditText
                style="@style/Widget.MyFitAI.InputEditTextCompact"
                        android:id="@+id/allergiesInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textCapSentences"
                        android:maxLines="2" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.MyFitAI.InputDropdownCompact"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_8"
                    android:hint="Stile alimentare">
                    <AutoCompleteTextView
                        style="@style/Widget.MyFitAI.InputDropdownTextCompact"
                        android:id="@+id/dietStyleInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="none" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.MyFitAI.InputCompact"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_8"
                    android:hint="Note alimentari">
                    <com.google.android.material.textfield.TextInputEditText
                style="@style/Widget.MyFitAI.InputEditTextCompact"
                        android:id="@+id/preferencesInput"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/multiline_notes_field_height"
                        android:gravity="top|start"
                        android:inputType="textMultiLine|textCapSentences"
                        android:maxLines="4" />
                </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/saveProfileButton"
                style="@style/Widget.MyFitAI.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="@dimen/button_primary_min_height"
                android:layout_marginTop="@dimen/space_16"
                android:text="Salva profilo" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
