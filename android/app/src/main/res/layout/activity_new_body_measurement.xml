<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_primary"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:clipToPadding="false"
        android:paddingHorizontal="@dimen/space_16"
        android:paddingTop="@dimen/space_8"
        android:paddingBottom="@dimen/space_24">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/screen_header_height"
            android:background="@drawable/bg_screen_header"
            android:gravity="center_vertical">

            <ImageButton
                android:id="@+id/backButton"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Indietro"
                android:padding="8dp"
                android:src="@drawable/ic_arrow_back_white"
                app:tint="@color/text_primary" />

             <TextView
                 android:id="@+id/title"
                 android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Nuova misurazione"
                android:textColor="@color/text_primary"
                style="@style/Text.MyFitAI.ScreenTitle" />

            <Space
                android:layout_width="40dp"
                android:layout_height="40dp" />
        </LinearLayout>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/measurementDataCard"
            style="@style/Widget.MyFitAI.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_12">
            <LinearLayout
                style="@style/Widget.MyFitAI.HomeSectionContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <com.myfitai.app.ui.widgets.SectionHeaderView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Dati rilevazione" />
                <GridLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:columnCount="@integer/measurement_grid_columns"
                    android:useDefaultMargins="false">
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/dateLayout"
                    style="@style/Widget.MyFitAI.InputCompact"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/space_2"
                    android:layout_columnWeight="1"
                    android:hint="Data"
                    app:endIconMode="custom"
                    app:endIconDrawable="@drawable/ic_calendar"
                    app:endIconContentDescription="Scegli data">

                    <com.google.android.material.textfield.TextInputEditText
                        style="@style/Widget.MyFitAI.InputEditTextCompact"
                        android:id="@+id/dateInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:focusable="false"
                        android:clickable="true"
                        android:inputType="none" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.MyFitAI.InputCompact"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/space_2"
                    android:layout_columnWeight="1"
                    android:hint="Peso corporeo (kg)">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/bodyWeightInput"
                        style="@style/Widget.MyFitAI.InputEditTextCompact"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="numberDecimal" />
                </com.google.android.material.textfield.TextInputLayout>
                </GridLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_4"
                    android:text="Peso manuale: viene salvato con le misure, senza creare una BIA."
                    android:textColor="@color/text_muted"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/sameDateBiaWeightHint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_4"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    android:visibility="gone" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_8"
            style="@style/Widget.MyFitAI.Card">
            <LinearLayout
                style="@style/Widget.MyFitAI.HomeSectionContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

            <com.myfitai.app.ui.widgets.SectionHeaderView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Circonferenze" />

            <GridLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:columnCount="@integer/measurement_grid_columns" android:useDefaultMargins="false">
            <com.google.android.material.textfield.TextInputLayout style="@style/Widget.MyFitAI.InputCompact" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_margin="@dimen/space_2" android:layout_columnWeight="1" android:hint="Torace (cm)">
                <com.google.android.material.textfield.TextInputEditText
                style="@style/Widget.MyFitAI.InputEditTextCompact" android:id="@+id/chestInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="numberDecimal" />
            </com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.textfield.TextInputLayout style="@style/Widget.MyFitAI.InputCompact" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_margin="@dimen/space_2" android:layout_columnWeight="1" android:hint="Vita (cm)">
                <com.google.android.material.textfield.TextInputEditText
                style="@style/Widget.MyFitAI.InputEditTextCompact" android:id="@+id/waistInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="numberDecimal" />
            </com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.textfield.TextInputLayout style="@style/Widget.MyFitAI.InputCompact" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_margin="@dimen/space_2" android:layout_columnWeight="1" android:hint="Addome (cm)">
                <com.google.android.material.textfield.TextInputEditText
                style="@style/Widget.MyFitAI.InputEditTextCompact" android:id="@+id/abdomenInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="numberDecimal" />
            </com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.textfield.TextInputLayout style="@style/Widget.MyFitAI.InputCompact" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_margin="@dimen/space_2" android:layout_columnWeight="1" android:hint="Spalle (cm)">
                <com.google.android.material.textfield.TextInputEditText
                style="@style/Widget.MyFitAI.InputEditTextCompact" android:id="@+id/shouldersInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="numberDecimal" />
            </com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.textfield.TextInputLayout style="@style/Widget.MyFitAI.InputCompact" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_margin="@dimen/space_2" android:layout_columnWeight="1" android:hint="Fianchi (cm)">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/hipsInput"
                    style="@style/Widget.MyFitAI.InputEditTextCompact"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="numberDecimal" />
            </com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.textfield.TextInputLayout style="@style/Widget.MyFitAI.InputCompact" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_margin="@dimen/space_2" android:layout_columnWeight="1" android:hint="Glutei (cm)">
                <com.google.android.material.textfield.TextInputEditText
                style="@style/Widget.MyFitAI.InputEditTextCompact" android:id="@+id/glutesInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="numberDecimal" />
            </com.google.android.material.textfield.TextInputLayout>
            </GridLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_8"
            style="@style/Widget.MyFitAI.Card">
            <LinearLayout
                style="@style/Widget.MyFitAI.HomeSectionContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

            <com.myfitai.app.ui.widgets.SectionHeaderView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Arti" />

            <GridLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="@integer/measurement_group_columns"
                android:useDefaultMargins="false">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_margin="@dimen/space_2"
                    android:orientation="vertical">
                    <com.myfitai.app.ui.widgets.SectionHeaderView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/measurement_group_arms" />
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">
                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/Widget.MyFitAI.InputCompact"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="@dimen/space_2"
                            android:layout_weight="1"
                            android:hint="@string/measurement_side_left">
                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/armLeftInput"
                                style="@style/Widget.MyFitAI.InputEditTextCompact"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="numberDecimal" />
                        </com.google.android.material.textfield.TextInputLayout>
                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/Widget.MyFitAI.InputCompact"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:hint="@string/measurement_side_right">
                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/armRightInput"
                                style="@style/Widget.MyFitAI.InputEditTextCompact"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="numberDecimal" />
                        </com.google.android.material.textfield.TextInputLayout>
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_margin="@dimen/space_2"
                    android:orientation="vertical">
                    <com.myfitai.app.ui.widgets.SectionHeaderView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/measurement_group_thighs" />
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">
                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/Widget.MyFitAI.InputCompact"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="@dimen/space_2"
                            android:layout_weight="1"
                            android:hint="@string/measurement_side_left">
                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/thighLeftInput"
                                style="@style/Widget.MyFitAI.InputEditTextCompact"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="numberDecimal" />
                        </com.google.android.material.textfield.TextInputLayout>
                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/Widget.MyFitAI.InputCompact"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:hint="@string/measurement_side_right">
                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/thighRightInput"
                                style="@style/Widget.MyFitAI.InputEditTextCompact"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="numberDecimal" />
                        </com.google.android.material.textfield.TextInputLayout>
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_margin="@dimen/space_2"
                    android:orientation="vertical">
                    <com.myfitai.app.ui.widgets.SectionHeaderView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/measurement_group_calves" />
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">
                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/Widget.MyFitAI.InputCompact"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="@dimen/space_2"
                            android:layout_weight="1"
                            android:hint="@string/measurement_side_left">
                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/calfLeftInput"
                                style="@style/Widget.MyFitAI.InputEditTextCompact"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="numberDecimal" />
                        </com.google.android.material.textfield.TextInputLayout>
                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/Widget.MyFitAI.InputCompact"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:hint="@string/measurement_side_right">
                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/calfRightInput"
                                style="@style/Widget.MyFitAI.InputEditTextCompact"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="numberDecimal" />
                        </com.google.android.material.textfield.TextInputLayout>
                    </LinearLayout>
                </LinearLayout>
            </GridLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/saveMeasurementButton"
            style="@style/Widget.MyFitAI.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="@dimen/space_20"
            android:layout_marginBottom="@dimen/space_24"
            android:text="Salva misurazione" />
    </LinearLayout>
</ScrollView>
