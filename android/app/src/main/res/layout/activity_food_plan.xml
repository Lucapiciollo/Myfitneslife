<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_primary">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/space_16">

            <LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:orientation="horizontal" android:gravity="center_vertical">
                 <ImageButton android:id="@+id/prevWeekButton" android:layout_width="40dp" android:layout_height="40dp" android:background="@android:color/transparent" android:padding="8dp" android:src="@drawable/ic_arrow_back_white" android:contentDescription="Settimana precedente" app:tint="@color/text_primary" />
                 <TextView android:id="@+id/weekRangeLabel" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:textColor="@color/text_primary" android:textStyle="bold" android:textSize="15sp" />
                 <ImageButton android:id="@+id/nextWeekButton" android:layout_width="40dp" android:layout_height="40dp" android:background="@android:color/transparent" android:padding="8dp" android:rotation="180" android:src="@drawable/ic_arrow_back_white" android:contentDescription="Settimana successiva" app:tint="@color/text_primary" />
             </LinearLayout>

            <TextView
                android:id="@+id/planVersionLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textColor="@color/text_muted"
                android:textSize="12sp"
                android:visibility="gone" />

             <com.myfitai.app.ui.widgets.WeekDaySelectorView
                 android:id="@+id/weekDaySelector"
                 android:layout_width="match_parent"
                 android:layout_height="wrap_content"
                 android:layout_marginTop="@dimen/space_8" />

             <com.google.android.material.card.MaterialCardView
                 android:id="@+id/energyTargetCard"
                 android:layout_width="match_parent"
                 android:layout_height="wrap_content"
                 android:layout_marginTop="@dimen/space_16"
                 app:cardBackgroundColor="@color/surface_primary"
                 app:cardCornerRadius="@dimen/radius_medium"
                 app:cardElevation="0dp"
                 app:strokeColor="@color/divider"
                 app:strokeWidth="1dp">

                 <LinearLayout
                     android:layout_width="match_parent"
                     android:layout_height="wrap_content"
                     android:orientation="vertical"
                     android:padding="@dimen/space_16">

                     <LinearLayout
                         android:layout_width="match_parent"
                         android:layout_height="wrap_content"
                         android:gravity="center_vertical"
                         android:orientation="horizontal">
                          <TextView
                              android:id="@+id/energyGoalLabel"
                             android:layout_width="0dp"
                             android:layout_height="wrap_content"
                             android:layout_weight="1"
                             android:text="Obiettivo energetico"
                             android:textColor="@color/text_primary"
                              android:textSize="15sp"
                              android:textStyle="bold" />
                          <TextView
                             android:id="@+id/energyModeLabel"
                             android:layout_width="wrap_content"
                             android:layout_height="wrap_content"
                             android:background="@drawable/bg_pill_selected"
                             android:paddingHorizontal="@dimen/space_10"
                             android:paddingVertical="@dimen/space_4"
                             android:textColor="@color/accent_green_dark"
                             android:textSize="11sp"
                             android:textStyle="bold" />
                      </LinearLayout>

                      <TextView
                          android:id="@+id/energyGoalDescription"
                          android:layout_width="match_parent"
                          android:layout_height="wrap_content"
                          android:layout_marginTop="@dimen/space_4"
                          android:textColor="@color/text_secondary"
                          android:textSize="12sp" />

                      <TextView
                         android:id="@+id/energyTargetCaption"
                         android:layout_width="wrap_content"
                         android:layout_height="wrap_content"
                         android:layout_marginTop="@dimen/space_16"
                          android:text="Calorie da assumere oggi"
                         android:textColor="@color/text_secondary"
                         android:textSize="12sp" />
                     <TextView
                         android:id="@+id/energyTargetValue"
                         android:layout_width="wrap_content"
                         android:layout_height="wrap_content"
                         android:layout_marginTop="@dimen/space_2"
                         android:textColor="@color/text_primary"
                         android:textSize="28sp"
                         android:textStyle="bold" />
                     <TextView
                         android:id="@+id/energyTargetSubline"
                         android:layout_width="match_parent"
                         android:layout_height="wrap_content"
                         android:layout_marginTop="@dimen/space_4"
                         android:textColor="@color/accent_green_dark"
                         android:textSize="12sp" />

                     <View
                         android:layout_width="match_parent"
                         android:layout_height="1dp"
                         android:layout_marginTop="@dimen/space_12"
                         android:background="@color/divider" />

                      <LinearLayout
                          android:layout_width="match_parent"
                          android:layout_height="wrap_content"
                          android:layout_marginTop="@dimen/space_12"
                          android:orientation="vertical">
                          <LinearLayout
                              android:layout_width="match_parent"
                              android:layout_height="wrap_content"
                              android:orientation="vertical">
                             <TextView
                                 android:layout_width="wrap_content"
                                 android:layout_height="wrap_content"
                                   android:text="Mantenimento giornaliero"
                                 android:textColor="@color/text_muted"
                                 android:textSize="11sp" />
                             <TextView
                                 android:id="@+id/energyMaintenanceValue"
                                 android:layout_width="wrap_content"
                                 android:layout_height="wrap_content"
                                 android:layout_marginTop="@dimen/space_2"
                                 android:textColor="@color/text_primary"
                                 android:textSize="14sp"
                                 android:textStyle="bold" />
                         </LinearLayout>
                          <LinearLayout
                              android:layout_width="match_parent"
                              android:layout_height="wrap_content"
                              android:layout_marginTop="@dimen/space_12"
                             android:orientation="vertical">
                             <TextView
                                 android:layout_width="wrap_content"
                                 android:layout_height="wrap_content"
                                   android:text="Differenza dal mantenimento"
                                 android:textColor="@color/text_muted"
                                 android:textSize="11sp" />
                             <TextView
                                 android:id="@+id/energyDifferenceValue"
                                 android:layout_width="wrap_content"
                                 android:layout_height="wrap_content"
                                 android:layout_marginTop="@dimen/space_2"
                                 android:textColor="@color/text_primary"
                                 android:textSize="14sp"
                                 android:textStyle="bold" />
                         </LinearLayout>
                     </LinearLayout>

                     <LinearLayout
                         android:id="@+id/energyRecoveryDetails"
                         android:layout_width="match_parent"
                         android:layout_height="wrap_content"
                         android:layout_marginTop="@dimen/space_12"
                         android:background="@drawable/bg_positive_soft"
                         android:orientation="vertical"
                         android:padding="@dimen/space_10"
                         android:visibility="gone">
                         <TextView
                             android:layout_width="wrap_content"
                             android:layout_height="wrap_content"
                             android:text="Riequilibrio temporaneo"
                             android:textColor="@color/accent_green_dark"
                             android:textSize="12sp"
                             android:textStyle="bold" />
                         <TextView
                             android:id="@+id/energyRecoveryValue"
                             android:layout_width="match_parent"
                             android:layout_height="wrap_content"
                             android:layout_marginTop="@dimen/space_2"
                             android:textColor="@color/text_secondary"
                             android:textSize="12sp" />
                     </LinearLayout>
                 </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

              <TextView
                 android:id="@+id/mealCountHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_8"
                android:gravity="center"
                android:text="Pasti al giorno"
                android:textColor="@color/text_secondary"
                 android:textSize="12sp" />

             <com.google.android.material.card.MaterialCardView
                 android:id="@+id/weeklyActionsCard"
                 android:layout_width="match_parent"
                 android:layout_height="wrap_content"
                 android:layout_marginTop="@dimen/space_16"
                 app:cardBackgroundColor="@color/surface_primary"
                 app:cardCornerRadius="@dimen/radius_medium"
                 app:cardElevation="0dp"
                 app:strokeColor="@color/divider"
                 app:strokeWidth="1dp">
              <LinearLayout
                  android:layout_width="match_parent"
                  android:layout_height="wrap_content"
                  android:orientation="vertical"
                  android:padding="@dimen/space_16">
              <com.myfitai.app.ui.widgets.SectionHeaderView
                  android:id="@+id/weeklyActionsHeader"
                  android:layout_width="match_parent"
                  android:layout_height="wrap_content"
                  android:text="Azioni settimana" />

              <LinearLayout
                  android:id="@+id/weeklyActionsRow"
                  android:layout_width="match_parent"
                  android:layout_height="wrap_content"
                  android:layout_marginTop="@dimen/space_8"
                  android:orientation="horizontal">
                 <com.google.android.material.button.MaterialButton
                     android:id="@+id/shoppingButton"
                     style="@style/Widget.Material3.Button.OutlinedButton"
                     android:layout_width="0dp"
                     android:layout_height="44dp"
                     android:layout_weight="1"
                     android:layout_marginEnd="@dimen/space_6"
                      android:text="Lista della spesa"
                     android:textAllCaps="false"
                     app:icon="@drawable/ic_cart"
                     app:iconGravity="textStart" />
                 <com.google.android.material.button.MaterialButton
                     android:id="@+id/cheatButton"
                     style="@style/Widget.Material3.Button.OutlinedButton"
                     android:layout_width="0dp"
                     android:layout_height="44dp"
                     android:layout_weight="1"
                     android:layout_marginStart="@dimen/space_6"
                       android:text="Aggiungi extra"
                     android:textAllCaps="false"
                     app:icon="@drawable/ic_add_circle"
                     app:iconGravity="textStart" />
              </LinearLayout>

              </LinearLayout>
             </com.google.android.material.card.MaterialCardView>

              <com.google.android.material.card.MaterialCardView
                 android:id="@+id/supplementsCard"
                 android:layout_width="match_parent"
                 android:layout_height="wrap_content"
                 android:layout_marginTop="@dimen/space_16"
                 app:cardBackgroundColor="@color/surface_primary"
                 app:cardCornerRadius="@dimen/radius_medium"
                 app:cardElevation="0dp"
                 app:strokeColor="@color/divider"
                 app:strokeWidth="1dp">
                 <LinearLayout
                     android:layout_width="match_parent"
                     android:layout_height="wrap_content"
                     android:orientation="vertical"
                     android:padding="@dimen/space_16">
                    <TextView
                        android:layout_width="match_parent"
                         android:layout_height="wrap_content"
                         android:text="Integrazione di oggi"
                         android:textColor="@color/text_primary"
                         android:textSize="15sp"
                         android:textStyle="bold" />
                     <TextView
                         android:id="@+id/supplementsDescription"
                         android:layout_width="match_parent"
                         android:layout_height="wrap_content"
                         android:layout_marginTop="@dimen/space_4"
                         android:text="Segui la dose e l'orario indicati. Questi valori sono già inclusi nel totale giornaliero."
                         android:textColor="@color/text_secondary"
                         android:textSize="12sp" />
                     <LinearLayout
                         android:id="@+id/supplementsContainer"
                         android:layout_width="match_parent"
                         android:layout_height="wrap_content"
                         android:layout_marginTop="@dimen/space_12"
                         android:orientation="vertical" />
                 </LinearLayout>
             </com.google.android.material.card.MaterialCardView>

             <TextView
                  android:id="@+id/emptyPlanText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_24"
                android:gravity="center"
                android:padding="@dimen/space_20"
                 android:text="Nessun piano per questa settimana. Genera un piano per vedere pasti, quantità e valori nutrizionali."
                android:textColor="@color/text_secondary"
                android:textSize="14sp"
                 android:visibility="gone" />

             <TextView
                 android:id="@+id/recoverySummary"
                 android:layout_width="match_parent"
                 android:layout_height="wrap_content"
                 android:layout_marginTop="@dimen/space_8"
                 android:padding="@dimen/space_12"
                 android:background="@drawable/bg_card"
                 android:textColor="@color/text_secondary"
                 android:textSize="13sp"
                 android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/generatePlanButton"
                android:layout_width="match_parent"
                 android:layout_height="48dp"
                android:layout_marginTop="@dimen/space_12"
                android:text="Genera piano con IA"
                android:textAllCaps="false"
                android:textStyle="bold"
                app:cornerRadius="12dp"
                app:backgroundTint="@color/accent_green" />

            <LinearLayout
                android:id="@+id/generationStatusContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_8"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone">
                <ProgressBar
                    android:id="@+id/generationProgress"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:indeterminate="true"
                    android:visibility="gone" />
                <TextView
                    android:id="@+id/generationStatusText"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/space_8"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/mealsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_8"
                android:orientation="vertical" />

               <com.google.android.material.card.MaterialCardView
                   android:id="@+id/dailyTotalContainer"
                   android:layout_width="match_parent"
                   android:layout_height="wrap_content"
                   android:layout_marginTop="@dimen/space_20"
                   app:cardBackgroundColor="@color/surface_primary"
                  app:cardCornerRadius="@dimen/radius_medium"
                  app:cardElevation="0dp"
                  app:strokeColor="@color/divider"
                  app:strokeWidth="1dp">
                   <LinearLayout
                       android:layout_width="match_parent"
                       android:layout_height="wrap_content"
                       android:orientation="vertical"
                       android:padding="@dimen/space_16">
                    <TextView
                        android:id="@+id/dailyTotalHeader"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Totale giornaliero"
                        android:textColor="@color/text_primary"
                        android:textSize="15sp"
                        android:textStyle="bold" />
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_12"
                        android:orientation="horizontal">
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:background="@drawable/bg_card_soft" android:orientation="vertical" android:padding="@dimen/space_10">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Esercizio registrato" android:textColor="@color/text_muted" android:textSize="11sp" />
                            <TextView android:id="@+id/exerciseKcalValue" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_4" android:textColor="@color/accent_green_dark" android:textSize="16sp" android:textStyle="bold" />
                        </LinearLayout>
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="@dimen/space_6" android:background="@drawable/bg_positive_soft" android:orientation="vertical" android:padding="@dimen/space_10">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Bilancio netto" android:textColor="@color/accent_green_dark" android:textSize="11sp" />
                            <TextView android:id="@+id/netKcalValue" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_4" android:textColor="@color/text_primary" android:textSize="16sp" android:textStyle="bold" />
                        </LinearLayout>
                    </LinearLayout>
                    <TextView android:id="@+id/dailyTotalLegend" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Obiettivo = quanto puntare. Nel piano = quanto è previsto. Registrato da te = quanto hai segnato come consumato." android:textColor="@color/text_muted" android:textSize="12sp" />
                    <TextView android:id="@+id/consumptionCoverage" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_4" android:text="Consumo registrato da te: nessun alimento segnato" android:textColor="@color/text_secondary" android:textSize="12sp" />
                   <TextView android:id="@+id/cheatSummary" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_8" android:textColor="@color/accent_orange" android:textSize="12sp" android:visibility="gone" />
                   <TextView
                       android:layout_width="match_parent"
                       android:layout_height="wrap_content"
                       android:layout_marginTop="@dimen/space_16"
                       android:text="Calorie"
                       android:textColor="@color/text_primary"
                       android:textSize="15sp"
                       android:textStyle="bold" />
                   <LinearLayout
                       android:layout_width="match_parent"
                       android:layout_height="wrap_content"
                       android:layout_marginTop="@dimen/space_8"
                       android:orientation="horizontal">
                       <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:background="@drawable/bg_card_soft" android:orientation="vertical" android:padding="@dimen/space_10">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Obiettivo del giorno" android:textColor="@color/text_muted" android:textSize="11sp" />
                           <TextView android:id="@+id/totalKcalTarget" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_4" android:textColor="@color/text_primary" android:textSize="16sp" android:textStyle="bold" />
                       </LinearLayout>
                       <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="@dimen/space_6" android:background="@drawable/bg_positive_soft" android:orientation="vertical" android:padding="@dimen/space_10">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Previsto nel piano" android:textColor="@color/accent_green_dark" android:textSize="11sp" />
                           <TextView android:id="@+id/totalKcalPlanned" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_4" android:textColor="@color/text_primary" android:textSize="16sp" android:textStyle="bold" />
                       </LinearLayout>
                       <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="@dimen/space_6" android:background="@drawable/bg_card_soft" android:orientation="vertical" android:padding="@dimen/space_10">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Registrato da te" android:textColor="@color/accent_orange" android:textSize="11sp" />
                           <TextView android:id="@+id/totalKcalConsumed" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_4" android:textColor="@color/text_primary" android:textSize="16sp" android:textStyle="bold" />
                       </LinearLayout>
                   </LinearLayout>
                   <TextView
                       android:layout_width="match_parent"
                       android:layout_height="wrap_content"
                       android:layout_marginTop="@dimen/space_20"
                       android:text="Macronutrienti"
                       android:textColor="@color/text_primary"
                       android:textSize="15sp"
                       android:textStyle="bold" />
                   <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_8" android:orientation="horizontal">
                       <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1.2" android:text="Valore" android:textColor="@color/text_muted" android:textSize="11sp" />
                       <TextView android:id="@+id/totalTargetHeader" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="end" android:text="Obiettivo" android:textColor="@color/text_muted" android:textSize="11sp" />
                        <TextView android:id="@+id/totalPlannedHeader" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="end" android:text="Nel piano" android:textColor="@color/accent_green_dark" android:textSize="11sp" />
                        <TextView android:id="@+id/totalConsumedHeader" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="end" android:text="Registrato" android:textColor="@color/accent_orange" android:textSize="11sp" />
                   </LinearLayout>
                   <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                       <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingVertical="@dimen/space_8">
                           <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1.2" android:text="Proteine" android:textColor="@color/text_primary" android:textStyle="bold" />
                           <TextView android:id="@+id/totalProteinTarget" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="end" android:textColor="@color/text_primary" />
                           <TextView android:id="@+id/totalProteinPlanned" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="end" android:textColor="@color/text_primary" />
                           <TextView android:id="@+id/totalProteinConsumed" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="end" android:textColor="@color/accent_orange" />
                       </LinearLayout>
                       <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingVertical="@dimen/space_8">
                           <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1.2" android:text="Carboidrati" android:textColor="@color/text_primary" android:textStyle="bold" />
                           <TextView android:id="@+id/totalCarbsTarget" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="end" android:textColor="@color/text_primary" />
                           <TextView android:id="@+id/totalCarbsPlanned" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="end" android:textColor="@color/text_primary" />
                           <TextView android:id="@+id/totalCarbsConsumed" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="end" android:textColor="@color/accent_blue" />
                       </LinearLayout>
                       <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingVertical="@dimen/space_8">
                           <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1.2" android:text="Grassi" android:textColor="@color/text_primary" android:textStyle="bold" />
                           <TextView android:id="@+id/totalFatTarget" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="end" android:textColor="@color/text_primary" />
                           <TextView android:id="@+id/totalFatPlanned" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="end" android:textColor="@color/text_primary" />
                           <TextView android:id="@+id/totalFatConsumed" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="end" android:textColor="@color/accent_purple" />
                       </LinearLayout>
                    </LinearLayout>
               </LinearLayout>
              </com.google.android.material.card.MaterialCardView>
         </LinearLayout>
    </ScrollView>
</LinearLayout>
