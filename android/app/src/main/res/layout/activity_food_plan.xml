<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_primary">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
             android:paddingHorizontal="@dimen/space_16"
             android:paddingTop="@dimen/space_8"
             android:paddingBottom="@dimen/space_24">

              <LinearLayout android:layout_width="match_parent" android:layout_height="@dimen/weekly_screen_header_height" android:orientation="horizontal" android:gravity="center_vertical" android:background="@drawable/bg_screen_header" android:paddingHorizontal="@dimen/space_8">
                 <ImageButton android:id="@+id/prevWeekButton" android:layout_width="@dimen/screen_header_icon_size" android:layout_height="@dimen/screen_header_icon_size" android:background="@android:color/transparent" android:padding="@dimen/space_8" android:src="@drawable/ic_arrow_back_white" android:contentDescription="Settimana precedente" app:tint="@color/text_primary" />
                 <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                     <TextView style="@style/Text.MyFitAI.ScreenTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:text="Piano alimentare" />
                     <TextView android:id="@+id/weekRangeLabel" style="@style/Text.MyFitAI.ScreenDate" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_4" android:gravity="center" />
                 </LinearLayout>
                  <ImageButton android:id="@+id/nextWeekButton" android:layout_width="@dimen/screen_header_icon_size" android:layout_height="@dimen/screen_header_icon_size" android:background="@android:color/transparent" android:padding="@dimen/space_8" android:rotation="180" android:src="@drawable/ic_arrow_back_white" android:contentDescription="Settimana successiva" app:tint="@color/text_primary" />
             </LinearLayout>

             <TextView
                 android:id="@+id/planVersionLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                 android:textColor="@color/text_muted"
                 style="@style/Text.MyFitAI.Micro"
                 android:visibility="gone" />

             <TextView
                 android:id="@+id/historicalPlanBanner"
                 android:layout_width="match_parent"
                 android:layout_height="wrap_content"
                 android:layout_marginTop="@dimen/space_8"
                 android:background="@color/surface_primary"
                 android:padding="@dimen/space_12"
                 android:text="@string/food_plan_historical_banner"
                  android:textColor="@color/text_secondary"
                  style="@style/Text.MyFitAI.Caption"
                 android:visibility="gone" />

            <com.myfitai.app.ui.widgets.WeekDaySelectorView
                android:id="@+id/weekDaySelector"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                 android:layout_marginTop="@dimen/space_12" />

            <TextView
                android:id="@+id/mealCountHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_8"
                android:gravity="center"
                android:text="@string/food_plan_ux2_meal_count_hint"
                android:textColor="@color/text_secondary"
                style="@style/Text.MyFitAI.Caption"
                android:visibility="gone" />

            <TextView
                android:id="@+id/goalChangedNotice"
                style="@style/Text.MyFitAI.BodyCompact"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_12"
                android:background="@drawable/bg_banner_warning"
                android:padding="@dimen/space_12"
                android:text="@string/food_plan_ux2_goal_changed_banner"
                android:textColor="@color/text_primary"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/generationStatusContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_12"
                android:background="@drawable/bg_banner_info"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="@dimen/space_12"
                android:visibility="gone">
                <View
                    android:id="@+id/planStateDot"
                    android:layout_width="@dimen/food_plan_status_dot_size"
                    android:layout_height="@dimen/food_plan_status_dot_size"
                    android:background="@drawable/bg_status_dot_neutral" />
                <ProgressBar
                    android:id="@+id/generationProgress"
                    android:layout_width="@dimen/compact_progress_indicator_size"
                    android:layout_height="@dimen/compact_progress_indicator_size"
                    android:indeterminate="true"
                    android:visibility="gone" />
                <TextView
                    android:id="@+id/generationStatusText"
                    style="@style/Text.MyFitAI.SettingsDescription"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/space_8" />
            </LinearLayout>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/emptyPlanCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_12"
                android:visibility="gone"
                style="@style/Widget.MyFitAI.Card">
                <LinearLayout
                    style="@style/Widget.MyFitAI.WhiteCardContent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <TextView
                        android:id="@+id/emptyPlanText"
                        style="@style/Text.MyFitAI.Body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="start"
                        android:textAlignment="viewStart"
                        android:text="@string/food_plan_empty_current"
                        android:textColor="@color/text_secondary" />
                    <LinearLayout
                        android:id="@+id/planGenerateSlotEmpty"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/dayMealsCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_12"
                android:visibility="gone"
                style="@style/Widget.MyFitAI.Card">
                <LinearLayout
                    style="@style/Widget.MyFitAI.WhiteCardContent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/settings_section_header_height"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">
                        <com.myfitai.app.ui.widgets.SectionHeaderView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/food_plan_ux2_meals_card_title" />
                        <ImageButton
                            android:id="@+id/dayMealsHelpButton"
                            android:layout_width="@dimen/screen_header_icon_size"
                            android:layout_height="@dimen/screen_header_icon_size"
                            android:layout_marginEnd="@dimen/space_4"
                            android:background="@android:color/transparent"
                            android:contentDescription="@string/food_plan_ux2_meals_help_description"
                            android:padding="@dimen/space_8"
                            android:src="@drawable/ic_help_outline"
                            app:tint="@color/text_secondary" />
                    </LinearLayout>
                    <LinearLayout
                        android:id="@+id/mealsContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_8"
                        android:orientation="vertical" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

             <com.google.android.material.card.MaterialCardView
                 android:id="@+id/dailyTotalCard"
                android:layout_width="match_parent"
                 android:layout_height="wrap_content"
                 android:layout_marginTop="@dimen/space_12"
                 android:visibility="gone"
                  style="@style/Widget.MyFitAI.Card">
                <LinearLayout
                    style="@style/Widget.MyFitAI.WhiteCardContent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <LinearLayout
                        android:id="@+id/dailyTotalHeader"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">
                        <com.myfitai.app.ui.widgets.SectionHeaderView
                            android:id="@+id/dailyTotalTitle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Totale giornaliero" />
                        <ImageButton
                            android:id="@+id/dailyTotalHelpButton"
                            android:layout_width="@dimen/screen_header_icon_size"
                            android:layout_height="@dimen/screen_header_icon_size"
                            android:layout_marginEnd="@dimen/space_4"
                            android:background="@android:color/transparent"
                            android:contentDescription="Spiega calorie, obiettivo di oggi, piano e consumo"
                            android:padding="@dimen/space_8"
                            android:src="@drawable/ic_help_outline"
                            app:tint="@color/text_secondary" />
                    </LinearLayout>
                    <LinearLayout
                        android:id="@+id/dailyTotalContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_8"
                        android:orientation="vertical">
                    <TextView
                        android:id="@+id/dailyTotalLegend"
                        style="@style/Text.MyFitAI.BodyCompact"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />
                    <LinearLayout
                        android:id="@+id/dailyTotalReferenceRows"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_8"
                        android:orientation="vertical"
                        android:paddingHorizontal="@dimen/space_12"
                        android:paddingVertical="@dimen/space_6"
                        android:background="@drawable/bg_card_soft">
                        <LinearLayout
                        android:id="@+id/dailyTotalRowBmr"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:minHeight="@dimen/control_compact_min_height">
                            <TextView
                                android:id="@+id/dailyBmrLabel"
                                style="@style/Text.MyFitAI.Body"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:textColor="@color/metric_label"
                                android:text="Metabolismo a riposo (BMR)" />
                            <TextView
                            android:id="@+id/totalKcalBmr"
                                style="@style/Text.MyFitAI.BodyEmphasis"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="@color/metric_label"
                                android:text="—" />
                        </LinearLayout>
                        <LinearLayout
                            android:id="@+id/dailyTotalRowTdee"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:minHeight="@dimen/control_compact_min_height">
                            <TextView
                                android:id="@+id/dailyTdeeLabel"
                                style="@style/Text.MyFitAI.Body"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Consumo giornaliero (TDEE)" />
                            <TextView
                                android:id="@+id/totalKcalTdee"
                                style="@style/Text.MyFitAI.BodyEmphasis"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="—" />
                        </LinearLayout>
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_12"
                        android:orientation="horizontal">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1.2"
                            android:text=""
                            style="@style/Text.MyFitAI.Micro" />
                        <TextView
                            style="@style/Text.MyFitAI.Caption"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="end"
                            android:text="Calorie"
                            android:textStyle="bold" />
                        <TextView
                            style="@style/Text.MyFitAI.Caption"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="end"
                            android:text="Proteine"
                            android:textStyle="bold" />
                    </LinearLayout>
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/border_width_default"
                        android:background="@color/divider" />
                    <LinearLayout
                        android:id="@+id/dailyTotalRowTarget"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:minHeight="@dimen/control_min_height">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1.2"
                            android:id="@+id/dailyTargetLabel"
                            style="@style/Text.MyFitAI.BodyEmphasis"
                            android:text="Obiettivo di oggi" />
                        <TextView
                            android:id="@+id/totalKcalTarget"
                            style="@style/Text.MyFitAI.BodyEmphasis"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="end"
                            android:text="—" />
                        <TextView
                            android:id="@+id/totalProteinTarget"
                            style="@style/Text.MyFitAI.BodyEmphasis"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="end"
                            android:text="—" />
                    </LinearLayout>
                    <LinearLayout
                        android:id="@+id/dailyTotalRowPlanned"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:minHeight="@dimen/control_min_height">
                        <TextView
                            style="@style/Text.MyFitAI.Body"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1.2"
                            android:text="Nel menu" />
                        <TextView
                            android:id="@+id/totalKcalPlanned"
                            style="@style/Text.MyFitAI.BodyEmphasis"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="end"
                            android:text="—" />
                        <TextView
                            android:id="@+id/totalProteinPlanned"
                            style="@style/Text.MyFitAI.BodyEmphasis"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="end"
                            android:text="—" />
                    </LinearLayout>
                    <LinearLayout
                        android:id="@+id/dailyTotalRowConsumed"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:minHeight="@dimen/control_min_height">
                        <TextView
                            android:id="@+id/dailyConsumedLabel"
                            style="@style/Text.MyFitAI.BodyEmphasis"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1.2"
                            android:text="Consumate · non registrate" />
                        <TextView
                            android:id="@+id/totalKcalConsumed"
                            style="@style/Text.MyFitAI.BodyEmphasis"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="end"
                            android:text="—" />
                        <TextView
                            android:id="@+id/totalProteinConsumed"
                            style="@style/Text.MyFitAI.BodyEmphasis"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="end"
                            android:text="—"
                            android:textColor="@color/accent_green_dark" />
                    </LinearLayout>
                    <TextView
                        android:id="@+id/totalConsumptionNote"
                        style="@style/Text.MyFitAI.SettingsDescription"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingTop="@dimen/space_4" />
                    <TextView
                        android:id="@+id/consumptionCoverage"
                        style="@style/Text.MyFitAI.Caption"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingTop="@dimen/space_4" />
                    <LinearLayout
                        android:id="@+id/dailyTotalMacros"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_12"
                        android:orientation="vertical"
                        android:visibility="gone">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">
                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1.2"
                                style="@style/Text.MyFitAI.Micro" />
                            <TextView
                                style="@style/Text.MyFitAI.Caption"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:gravity="end"
                                android:text="@string/food_plan_ux2_macro_carbs"
                                android:textStyle="bold" />
                            <TextView
                                style="@style/Text.MyFitAI.Caption"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:gravity="end"
                                android:text="@string/food_plan_ux2_macro_fat"
                                android:textStyle="bold" />
                        </LinearLayout>
                        <View
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/border_width_default"
                            android:background="@color/divider" />
                        <LinearLayout
                            android:id="@+id/dailyTotalRowMacrosPlanned"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:minHeight="@dimen/control_min_height">
                            <TextView
                                style="@style/Text.MyFitAI.Body"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1.2"
                                android:text="@string/food_plan_ux2_macro_in_menu" />
                            <TextView
                                android:id="@+id/totalCarbsPlanned"
                                style="@style/Text.MyFitAI.BodyEmphasis"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:gravity="end"
                                android:text="-" />
                            <TextView
                                android:id="@+id/totalFatPlanned"
                                style="@style/Text.MyFitAI.BodyEmphasis"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:gravity="end"
                                android:text="-" />
                        </LinearLayout>
                    </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

             <com.google.android.material.card.MaterialCardView
                 android:id="@+id/weekActionsCard"
                android:layout_width="match_parent"
                 android:layout_height="wrap_content"
                 android:layout_marginTop="@dimen/space_12"
                 android:visibility="gone"
                  style="@style/Widget.MyFitAI.Card">
                <LinearLayout
                    style="@style/Widget.MyFitAI.WhiteCardContent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <LinearLayout
                        android:layout_width="match_parent"
                         android:layout_height="@dimen/settings_section_header_height"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">
                        <com.myfitai.app.ui.widgets.SectionHeaderView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Azioni settimana" />
                        <ImageButton
                            android:id="@+id/weekActionsHelpButton"
                            android:layout_width="@dimen/screen_header_icon_size"
                            android:layout_height="@dimen/screen_header_icon_size"
                            android:layout_marginEnd="@dimen/space_4"
                            android:background="@android:color/transparent"
                            android:contentDescription="Spiega azioni settimana"
                            android:padding="@dimen/space_8"
                            android:src="@drawable/ic_help_outline"
                            app:tint="@color/text_secondary" />
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                     android:layout_marginTop="@dimen/space_8"
                         android:orientation="horizontal"
                         android:gravity="center_vertical">
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/shoppingButton"
                            style="@style/Widget.MyFitAI.Button.Outlined"
                            android:layout_width="0dp"
                  android:layout_height="@dimen/button_secondary_min_height"
                            android:layout_weight="1"
                            android:layout_marginEnd="@dimen/space_4"
                            android:gravity="center"
                            android:text="Lista spesa"
                            android:textAllCaps="false"
                            app:icon="@drawable/ic_cart"
                            app:iconGravity="textStart" />
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/cheatButton"
                            style="@style/Widget.MyFitAI.Button.Outlined"
                            android:layout_width="0dp"
                            android:layout_height="@dimen/button_secondary_min_height"
                            android:layout_weight="1"
                            android:layout_marginStart="@dimen/space_4"
                            android:gravity="center"
                            android:minLines="2"
                            android:text="Sgarro"
                            android:textAllCaps="false"
                            app:icon="@drawable/ic_add_circle"
                            app:iconGravity="textStart" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:id="@+id/planManagementContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <LinearLayout
                    android:id="@+id/planGenerateSlotBottom"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <LinearLayout
                        android:id="@+id/planGenerateGroup"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">
                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/aiConfigurationNoticeCard"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_12"
                            android:visibility="gone"
                            app:cardBackgroundColor="@color/surface_primary"
                            app:cardCornerRadius="@dimen/radius_card"
                            app:cardElevation="@dimen/elevation_card"
                            app:strokeColor="@color/accent_green"
                            app:strokeWidth="@dimen/border_width_default">
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:padding="@dimen/space_16">
                                <TextView
                                    style="@style/Text.MyFitAI.CardTitle"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="Nessun provider IA configurato" />
                                <TextView
                                    style="@style/Text.MyFitAI.BodyCompact"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="@dimen/space_4"
                                    android:text="Per usare Alimentazione devi scegliere Gemini o OpenAI e configurare la relativa API key personale nelle Impostazioni." />
                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/aiConfigurationNoticeButton"
                                    style="@style/Widget.MyFitAI.Button.Text"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="@dimen/space_4"
                                    android:text="Apri impostazioni IA" />
                            </LinearLayout>
                        </com.google.android.material.card.MaterialCardView>
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/generatePlanButton"
                            style="@style/Widget.MyFitAI.Button.Primary"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/button_primary_min_height"
                            android:layout_marginTop="@dimen/space_12"
                            android:text="Genera piano con IA" />
                    </LinearLayout>
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/planSettingsButton"
                    style="@style/Widget.MyFitAI.Button.Outlined"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/button_secondary_min_height"
                    android:layout_marginTop="@dimen/space_8"
                    android:text="Configura alimentazione" />

                <TextView
                    android:id="@+id/planScheduleStatusText"
                    style="@style/Text.MyFitAI.SettingsDescription"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_4"
                    android:visibility="gone" />
            </LinearLayout>


             <com.google.android.material.card.MaterialCardView
                 android:id="@+id/nutritionEstimateCard"
                 android:layout_width="match_parent"
                 android:layout_height="wrap_content"
                 android:layout_marginTop="@dimen/space_12"
                 android:visibility="gone"
                  style="@style/Widget.MyFitAI.Card">
                <LinearLayout
                    style="@style/Widget.MyFitAI.WhiteCardContent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <ImageView
                        android:layout_width="@dimen/space_24"
                        android:layout_height="@dimen/space_24"
                        android:layout_marginEnd="@dimen/space_12"
                        android:contentDescription="Informazioni sui valori nutrizionali stimati"
                        android:src="@drawable/ic_help_outline"
                        app:tint="@color/text_secondary" />
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            style="@style/Text.MyFitAI.CardTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Valori nutrizionali stimati" />
                        <TextView
                            style="@style/Text.MyFitAI.BodyCompact"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_4"
                            android:text="Le calorie e i macronutrienti indicati nel piano alimentare sono stime elaborate dall'intelligenza artificiale sulla base degli alimenti e delle quantità suggerite. I valori effettivi possono variare in funzione dei prodotti utilizzati, delle porzioni e delle modalità di preparazione. Il simbolo ≈ indica un valore approssimativo e non una misurazione esatta." />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </ScrollView>
    <include layout="@layout/view_bottom_navigation" />
</LinearLayout>
