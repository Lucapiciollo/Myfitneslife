<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_primary">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
             android:paddingHorizontal="@dimen/space_16"
             android:paddingTop="@dimen/space_8"
             android:paddingBottom="@dimen/space_24">

              <LinearLayout android:layout_width="match_parent" android:layout_height="@dimen/weekly_screen_header_height" android:orientation="horizontal" android:gravity="center_vertical" android:background="@drawable/bg_screen_header" android:paddingHorizontal="@dimen/space_8">
                 <ImageButton android:id="@+id/prevWeekButton" android:layout_width="@dimen/screen_header_icon_size" android:layout_height="@dimen/screen_header_icon_size" android:background="@android:color/transparent" android:padding="@dimen/space_8" android:src="@drawable/ic_arrow_back_white" android:contentDescription="Settimana precedente" app:tint="@color/text_primary" />
                 <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                     <TextView style="@style/Text.MyFitAI.ScreenTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:text="Piano alimentare" />
                     <TextView android:id="@+id/weekRangeLabel" style="@style/Text.MyFitAI.ScreenDate" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_4" android:gravity="center" />
                 </LinearLayout>
                  <ImageButton android:id="@+id/nextWeekButton" android:layout_width="@dimen/screen_header_icon_size" android:layout_height="@dimen/screen_header_icon_size" android:background="@android:color/transparent" android:padding="@dimen/space_8" android:rotation="180" android:src="@drawable/ic_arrow_back_white" android:contentDescription="Settimana successiva" app:tint="@color/text_primary" />
             </LinearLayout>

             <TextView
                 android:id="@+id/planVersionLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                 android:textColor="@color/text_muted"
                 style="@style/Text.MyFitAI.Micro"
                 android:visibility="gone" />

             <TextView
                 android:id="@+id/historicalPlanBanner"
                 android:layout_width="match_parent"
                 android:layout_height="wrap_content"
                 android:layout_marginTop="@dimen/space_8"
                 android:background="@color/surface_primary"
                 android:padding="@dimen/space_12"
                 android:text="@string/food_plan_historical_banner"
                  android:textColor="@color/text_secondary"
                  style="@style/Text.MyFitAI.Caption"
                 android:visibility="gone" />

            <com.myfitai.app.ui.widgets.WeekDaySelectorView
                android:id="@+id/weekDaySelector"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                 android:layout_marginTop="@dimen/space_12" />

             <TextView
                 android:id="@+id/mealCountHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_8"
                android:gravity="center"
                android:text="Pasti al giorno"
                 android:textColor="@color/text_secondary"
                 style="@style/Text.MyFitAI.Caption" />
              <TextView
                 android:id="@+id/emptyPlanText"
                 android:layout_width="match_parent"
                 android:layout_height="wrap_content"
                 android:layout_marginTop="@dimen/space_12"
                 android:gravity="start"
                 android:textAlignment="viewStart"
                 android:padding="@dimen/space_12"
                 android:text="@string/food_plan_empty_current"
                  android:textColor="@color/text_secondary"
                  style="@style/Text.MyFitAI.Body"
                 android:visibility="gone" />

             <com.google.android.material.card.MaterialCardView
                 android:id="@+id/dayMealsCard"
                android:layout_width="match_parent"
                 android:layout_height="wrap_content"
                 android:layout_marginTop="@dimen/space_12"
                 android:visibility="gone"
                  style="@style/Widget.MyFitAI.Card">
                <LinearLayout
                    style="@style/Widget.MyFitAI.WhiteCardContent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/settings_section_header_height"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">
                        <com.myfitai.app.ui.widgets.SectionHeaderView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Pasti del giorno" />
                        <ImageButton
                            android:id="@+id/dayMealsHelpButton"
                            android:layout_width="@dimen/screen_header_icon_size"
                            android:layout_height="@dimen/screen_header_icon_size"
                            android:layout_marginEnd="@dimen/space_4"
                            android:background="@android:color/transparent"
                            android:contentDescription="Spiega pasti del giorno"
                            android:padding="@dimen/space_8"
                            android:src="@drawable/ic_help_outline"
                            app:tint="@color/text_secondary" />
                    </LinearLayout>
                    <LinearLayout
                        android:id="@+id/mealsContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_8"
                        android:orientation="vertical" />
                 </LinearLayout>
             </com.google.android.material.card.MaterialCardView>

             <com.google.android.material.card.MaterialCardView
                 android:id="@+id/planStateCard"
                 android:layout_width="match_parent"
                 android:layout_height="wrap_content"
                 android:layout_marginTop="@dimen/space_12"
                 android:visibility="gone"
                 style="@style/Widget.MyFitAI.Card">
                <LinearLayout
                    style="@style/Widget.MyFitAI.WhiteCardContent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/settings_section_header_height"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">
                        <com.myfitai.app.ui.widgets.SectionHeaderView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Piano alimentare" />
                        <ImageButton
                            android:id="@+id/foodPlanHelpButton"
                            android:layout_width="@dimen/screen_header_icon_size"
                            android:layout_height="@dimen/screen_header_icon_size"
                            android:layout_marginEnd="@dimen/space_4"
                            android:background="@android:color/transparent"
                            android:contentDescription="Spiega piano alimentare"
                            android:padding="@dimen/space_8"
                            android:src="@drawable/ic_help_outline"
                            app:tint="@color/text_secondary" />
                    </LinearLayout>
                    <TextView
                        android:id="@+id/goalChangedNotice"
                        style="@style/Text.MyFitAI.BodyCompact"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_12"
                        android:background="@color/surface_primary"
                        android:padding="@dimen/space_12"
                        android:text="Hai aggiornato il profilo o aggiunto nuove misure. Puoi rigenerare il piano alimentare per aggiornarlo."
                        android:textColor="@color/text_primary"
                        android:visibility="gone" />
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/regenerateForGoalButton"
                        style="@style/Widget.MyFitAI.Button.Outlined"
                        android:layout_width="match_parent"
                  android:layout_height="@dimen/button_secondary_min_height"
                        android:layout_marginTop="@dimen/space_8"
                        android:text="Rigenera alimentazione"
                        android:textAllCaps="false"
                        android:visibility="gone" />
                    <LinearLayout
                        android:id="@+id/generationStatusContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_8"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:visibility="gone">
                        <View
                            android:id="@+id/planStateDot"
                            android:layout_width="@dimen/food_plan_status_dot_size"
                            android:layout_height="@dimen/food_plan_status_dot_size"
                            android:background="@drawable/bg_status_dot_neutral" />
                        <ProgressBar
                            android:id="@+id/generationProgress"
                            android:layout_width="@dimen/compact_progress_indicator_size"
                            android:layout_height="@dimen/compact_progress_indicator_size"
                            android:indeterminate="true"
                            android:visibility="gone" />
                        <TextView
                            android:id="@+id/generationStatusText"
                            style="@style/Text.MyFitAI.SettingsDescription"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="@dimen/space_8"
                            />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

             <com.google.android.material.button.MaterialButton
                 android:id="@+id/generatePlanButton"
                 android:layout_width="match_parent"
                  android:layout_height="@dimen/button_primary_min_height"
                 android:layout_marginTop="@dimen/space_12"
                 android:text="Genera piano con IA"
                 android:textAllCaps="false"
                 android:textStyle="bold"
                 app:backgroundTint="@color/accent_green"
                  app:cornerRadius="@dimen/radius_field" />

             <com.google.android.material.card.MaterialCardView
                 android:id="@+id/aiConfigurationNoticeCard"
                 android:layout_width="match_parent"
                 android:layout_height="wrap_content"
                 android:layout_marginTop="@dimen/space_8"
                 android:visibility="gone"
                 app:cardBackgroundColor="@color/surface_primary"
                 app:cardCornerRadius="@dimen/radius_card"
                 app:cardElevation="@dimen/elevation_card"
                 app:strokeColor="@color/accent_green"
                 app:strokeWidth="@dimen/border_width_default">
                 <LinearLayout
                     android:layout_width="match_parent"
                     android:layout_height="wrap_content"
                     android:orientation="vertical"
                     android:padding="@dimen/space_16">
                       <TextView
                           style="@style/Text.MyFitAI.CardTitle"
                           android:layout_width="match_parent"
                           android:layout_height="wrap_content"
                           android:text="Nessun provider IA configurato" />
                      <TextView
                          style="@style/Text.MyFitAI.BodyCompact"
                          android:layout_width="match_parent"
                         android:layout_height="wrap_content"
                         android:layout_marginTop="@dimen/space_4"
                          android:text="Per usare Alimentazione devi scegliere Gemini o OpenAI e configurare la relativa API key personale nelle Impostazioni." />
                     <com.google.android.material.button.MaterialButton
                         android:id="@+id/aiConfigurationNoticeButton"
                         style="@style/Widget.MyFitAI.Button.Text"
                         android:layout_width="wrap_content"
                         android:layout_height="wrap_content"
                         android:layout_marginTop="@dimen/space_4"
                         android:text="Apri impostazioni IA" />
                 </LinearLayout>
             </com.google.android.material.card.MaterialCardView>

             <com.google.android.material.button.MaterialButton
                 android:id="@+id/planSettingsButton"
                 style="@style/Widget.MyFitAI.Button.Outlined"
                 android:layout_width="match_parent"
                  android:layout_height="@dimen/button_secondary_min_height"
                 android:layout_marginTop="@dimen/space_8"
                 android:text="Configura alimentazione"
                 android:textAllCaps="false" />

             <com.google.android.material.card.MaterialCardView
                 android:id="@+id/weekActionsCard"
                android:layout_width="match_parent"
                 android:layout_height="wrap_content"
                 android:layout_marginTop="@dimen/space_12"
                 android:visibility="gone"
                  style="@style/Widget.MyFitAI.Card">
                <LinearLayout
                    style="@style/Widget.MyFitAI.WhiteCardContent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <LinearLayout
                        android:layout_width="match_parent"
                         android:layout_height="@dimen/settings_section_header_height"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">
                        <com.myfitai.app.ui.widgets.SectionHeaderView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Azioni settimana" />
                        <ImageButton
                            android:id="@+id/weekActionsHelpButton"
                            android:layout_width="@dimen/screen_header_icon_size"
                            android:layout_height="@dimen/screen_header_icon_size"
                            android:layout_marginEnd="@dimen/space_4"
                            android:background="@android:color/transparent"
                            android:contentDescription="Spiega azioni settimana"
                            android:padding="@dimen/space_8"
                            android:src="@drawable/ic_help_outline"
                            app:tint="@color/text_secondary" />
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_8"
                        android:orientation="horizontal">
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/shoppingButton"
                            style="@style/Widget.MyFitAI.Button.Outlined"
                            android:layout_width="0dp"
                  android:layout_height="@dimen/button_secondary_min_height"
                            android:layout_weight="1"
                            android:layout_marginEnd="@dimen/space_6"
                            android:text="Lista spesa"
                            android:textAllCaps="false"
                            app:icon="@drawable/ic_cart"
                            app:iconGravity="textStart" />
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/cheatButton"
                            style="@style/Widget.MyFitAI.Button.Outlined"
                            android:layout_width="0dp"
                  android:layout_height="@dimen/button_secondary_min_height"
                            android:layout_weight="1"
                            android:layout_marginStart="@dimen/space_6"
                            android:text="Registra sgarro"
                            android:textAllCaps="false"
                            app:icon="@drawable/ic_add_circle"
                            app:iconGravity="textStart" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

             <com.google.android.material.card.MaterialCardView
                 android:id="@+id/dailyTotalCard"
                android:layout_width="match_parent"
                 android:layout_height="wrap_content"
                 android:layout_marginTop="@dimen/space_12"
                 android:visibility="gone"
                  style="@style/Widget.MyFitAI.Card">
                <LinearLayout
                    style="@style/Widget.MyFitAI.WhiteCardContent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <LinearLayout
                        android:id="@+id/dailyTotalHeader"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">
                        <com.myfitai.app.ui.widgets.SectionHeaderView
                            android:id="@+id/dailyTotalTitle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Totale giornaliero" />
                        <ImageButton
                            android:id="@+id/dailyTotalHelpButton"
                            android:layout_width="@dimen/screen_header_icon_size"
                            android:layout_height="@dimen/screen_header_icon_size"
                            android:layout_marginEnd="@dimen/space_4"
                            android:background="@android:color/transparent"
                            android:contentDescription="Spiega calorie, target, piano e consumo"
                            android:padding="@dimen/space_8"
                            android:src="@drawable/ic_help_outline"
                            app:tint="@color/text_secondary" />
                    </LinearLayout>
                    <LinearLayout
                        android:id="@+id/dailyTotalContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_8"
                        android:orientation="vertical">
                  <TextView android:id="@+id/dailyTotalLegend" style="@style/Text.MyFitAI.Micro" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Target / piano / consumo registrato" />
                  <TextView android:id="@+id/consumptionCoverage" style="@style/Text.MyFitAI.SettingsDescription" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_4" android:text="Consumo: nessuna registrazione" />
                  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_8" android:orientation="horizontal">
                      <TextView style="@style/Text.MyFitAI.Caption" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1.15" android:text="Base (TDEE)" />
                      <TextView android:id="@+id/totalKcalBase" style="@style/Text.MyFitAI.BodyEmphasis" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1.3" android:gravity="center" />
                      <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="2.7" android:text="" />
                  </LinearLayout>
                  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_8" android:orientation="horizontal">
                      <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1.15" android:text="" />
                       <TextView android:id="@+id/totalTargetHeader" style="@style/Text.MyFitAI.Micro" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1.3" android:gravity="center" android:text="Calorie" android:textStyle="bold" />
                       <TextView android:id="@+id/totalPlannedHeader" style="@style/Text.MyFitAI.Micro" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="0.9" android:gravity="center" android:text="Proteine" android:textStyle="bold" />
                       <TextView android:id="@+id/totalConsumedHeader" style="@style/Text.MyFitAI.Micro" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="0.9" android:gravity="center" android:text="Carbo" android:textStyle="bold" />
                       <TextView style="@style/Text.MyFitAI.Micro" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="0.9" android:gravity="center" android:text="Grassi" android:textStyle="bold" />
                  </LinearLayout>
                   <View android:layout_width="match_parent" android:layout_height="@dimen/border_width_default" android:layout_marginTop="@dimen/space_4" android:background="@color/divider" />
                  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingVertical="@dimen/space_6">
                       <TextView style="@style/Text.MyFitAI.BodyEmphasis" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1.15" android:text="Target" />
                       <TextView android:id="@+id/totalKcalTarget" style="@style/Text.MyFitAI.Caption" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1.3" android:gravity="center" />
                       <TextView android:id="@+id/totalProteinTarget" style="@style/Text.MyFitAI.Caption" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" />
                       <TextView android:id="@+id/totalCarbsTarget" style="@style/Text.MyFitAI.Caption" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" />
                       <TextView android:id="@+id/totalFatTarget" style="@style/Text.MyFitAI.Caption" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" />
                  </LinearLayout>
                  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingVertical="@dimen/space_6">
                       <TextView style="@style/Text.MyFitAI.BodyEmphasis" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1.15" android:text="Piano" />
                       <TextView android:id="@+id/totalKcalPlanned" style="@style/Text.MyFitAI.Caption" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1.3" android:gravity="center" />
                       <TextView android:id="@+id/totalProteinPlanned" style="@style/Text.MyFitAI.Caption" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" />
                       <TextView android:id="@+id/totalCarbsPlanned" style="@style/Text.MyFitAI.Caption" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" />
                       <TextView android:id="@+id/totalFatPlanned" style="@style/Text.MyFitAI.Caption" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" />
                  </LinearLayout>
                  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingVertical="@dimen/space_6">
                       <TextView style="@style/Text.MyFitAI.BodyEmphasis" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1.15" android:text="Consumato" />
                       <TextView android:id="@+id/totalKcalConsumed" style="@style/Text.MyFitAI.Caption" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1.3" android:gravity="center" />
                       <TextView android:id="@+id/totalProteinConsumed" style="@style/Text.MyFitAI.Caption" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:textColor="@color/accent_orange" />
                       <TextView android:id="@+id/totalCarbsConsumed" style="@style/Text.MyFitAI.Caption" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:textColor="@color/accent_blue" />
                       <TextView android:id="@+id/totalFatConsumed" style="@style/Text.MyFitAI.Caption" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:textColor="@color/accent_purple" />
                  </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

             <com.google.android.material.card.MaterialCardView
                 android:id="@+id/nutritionEstimateCard"
                 android:layout_width="match_parent"
                 android:layout_height="wrap_content"
                 android:layout_marginTop="@dimen/space_12"
                 android:visibility="gone"
                  style="@style/Widget.MyFitAI.Card">
                <LinearLayout
                    style="@style/Widget.MyFitAI.WhiteCardContent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <ImageView
                        android:layout_width="@dimen/space_24"
                        android:layout_height="@dimen/space_24"
                        android:layout_marginEnd="@dimen/space_12"
                        android:contentDescription="Informazioni sui valori nutrizionali stimati"
                        android:src="@drawable/ic_help_outline"
                        app:tint="@color/text_secondary" />
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            style="@style/Text.MyFitAI.CardTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Valori nutrizionali stimati" />
                        <TextView
                            style="@style/Text.MyFitAI.BodyCompact"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_4"
                            android:text="Le calorie e i macronutrienti indicati nel piano alimentare sono stime elaborate dall'intelligenza artificiale sulla base degli alimenti e delle quantità suggerite. I valori effettivi possono variare in funzione dei prodotti utilizzati, delle porzioni e delle modalità di preparazione. Il simbolo ≈ indica un valore approssimativo e non una misurazione esatta." />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </ScrollView>
    <include layout="@layout/view_bottom_navigation" />
</LinearLayout>
