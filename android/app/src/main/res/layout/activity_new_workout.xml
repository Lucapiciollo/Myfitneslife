<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_primary"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/space_16">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:gravity="center_vertical">
            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/backButton"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@android:color/transparent"
                android:contentDescription="Indietro"
                android:padding="10dp"
                android:src="@drawable/ic_arrow_back" />
            <TextView
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Nuovo allenamento"
                android:textColor="@color/text_primary"
                android:textSize="20sp"
                android:textStyle="bold" />
            <Space android:layout_width="40dp" android:layout_height="40dp" />
        </LinearLayout>

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.MyFitAI.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_12">
        <LinearLayout
            style="@style/Widget.MyFitAI.HomeSectionContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/restDaySwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_12"
            android:text="Giornata di riposo" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_12"
            android:orientation="horizontal">
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/dateLayout"
                style="@style/Widget.MyFitAI.Input"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Data"
                app:endIconMode="custom"
                app:endIconDrawable="@drawable/ic_calendar">
                <com.google.android.material.textfield.TextInputEditText
                style="@style/Widget.MyFitAI.InputEditText"
                    android:id="@+id/dateInput"
                    android:layout_width="match_parent"
                    android:layout_height="64dp"
                    android:focusable="false"
                    android:gravity="center_vertical"
                    android:minHeight="64dp"
                    android:textSize="16sp" />
            </com.google.android.material.textfield.TextInputLayout>
            <Space android:layout_width="@dimen/space_12" android:layout_height="1dp" />
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/timeLayout"
                style="@style/Widget.MyFitAI.Input"
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_weight="1"
                android:hint="Ora"
                app:endIconMode="custom"
                app:endIconDrawable="@drawable/ic_setting_clock">
                <com.google.android.material.textfield.TextInputEditText
                style="@style/Widget.MyFitAI.InputEditText"
                    android:id="@+id/timeInput"
                    android:layout_width="match_parent"
                    android:layout_height="64dp"
                    android:focusable="false"
                    android:gravity="center_vertical"
                    android:minHeight="64dp"
                    android:textSize="16sp" />
            </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/typeLayout"
            style="@style/Widget.MyFitAI.InputDropdown"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_12"
            android:hint="Tipo">
            <AutoCompleteTextView
                        style="@style/Widget.MyFitAI.InputDropdownText"
                android:id="@+id/typeInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="none" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/titleLayout"
            style="@style/Widget.MyFitAI.Input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_12"
            android:hint="Allenamento">
            <com.google.android.material.textfield.TextInputEditText
                style="@style/Widget.MyFitAI.InputEditText"
                android:id="@+id/titleInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/durationLayout"
            style="@style/Widget.MyFitAI.Input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_12"
            android:hint="Durata (minuti)">
            <com.google.android.material.textfield.TextInputEditText
                style="@style/Widget.MyFitAI.InputEditText"
                android:id="@+id/durationInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="number" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/notesLayout"
            style="@style/Widget.MyFitAI.Input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_12"
            android:hint="Note">
            <com.google.android.material.textfield.TextInputEditText
                style="@style/Widget.MyFitAI.InputEditText"
                android:id="@+id/notesInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minLines="3"
                android:gravity="top" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/saveWorkoutButton"
            style="@style/Widget.MyFitAI.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="@dimen/space_20"
            android:layout_marginBottom="@dimen/space_24"
            android:text="Salva" />
        </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</ScrollView>
