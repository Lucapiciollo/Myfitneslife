<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_primary"
    android:orientation="vertical">

    <ScrollView
        android:id="@+id/aiSettingsScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/aiSettingsContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/space_16"
            android:paddingTop="@dimen/space_8"
            android:paddingBottom="@dimen/space_24">

            <LinearLayout style="@style/Widget.MyFitAI.ScreenHeader">
                <ImageButton
                    android:id="@+id/backButton"
                    android:layout_width="@dimen/icon_button_size"
                    android:layout_height="@dimen/icon_button_size"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Indietro"
                    android:padding="@dimen/space_8"
                    android:src="@drawable/ic_arrow_back"
                    app:tint="@color/text_primary" />
                <TextView
                    android:id="@+id/title"
                    style="@style/Text.MyFitAI.ScreenTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="@string/ai_settings_title" />
                <ImageButton
                    android:id="@+id/aiSettingsHelpButton"
                    android:layout_width="@dimen/icon_button_size"
                    android:layout_height="@dimen/icon_button_size"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/ai_settings_help_cd"
                    android:padding="@dimen/space_8"
                    android:src="@drawable/ic_help_outline"
                    app:tint="@color/text_secondary" />
            </LinearLayout>

            <TextView
                android:id="@+id/aiScopeBanner"
                style="@style/Text.MyFitAI.SettingsDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_8"
                android:background="@drawable/bg_panel_tonal"
                android:padding="@dimen/space_12"
                android:text="@string/ai_scope_global" />

            <!-- 1 · Provider attivo -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.MyFitAI.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_12">
                <LinearLayout
                    style="@style/Widget.MyFitAI.WhiteCardContent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <TextView
                        android:id="@+id/aiProviderHeader"
                        style="@style/Text.MyFitAI.CardTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/ai_group_provider" />
                    <com.myfitai.app.ui.widgets.SelectableSegmentView
                        android:id="@+id/aiProviderSegment"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_8" />
                    <TextView
                        android:id="@+id/activeProviderText"
                        style="@style/Text.MyFitAI.BodyCompact"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_12"
                        android:text="@string/ai_provider_none" />
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/useOtherProviderButton"
                        style="@style/Widget.MyFitAI.SettingsButton.Outlined"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/button_secondary_min_height"
                        android:layout_marginTop="@dimen/space_8"
                        android:textAllCaps="false"
                        android:visibility="gone" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 2 · Chiavi API -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.MyFitAI.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_12">
                <LinearLayout
                    style="@style/Widget.MyFitAI.WhiteCardContent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <TextView
                        android:id="@+id/aiKeysHeader"
                        style="@style/Text.MyFitAI.CardTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/ai_group_keys" />

                    <LinearLayout
                        android:id="@+id/geminiKeyContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_12"
                        android:orientation="vertical">
                        <TextView
                            style="@style/Text.MyFitAI.SettingsLabel"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Gemini" />
                        <TextView
                            android:id="@+id/geminiKeyStatusText"
                            style="@style/Text.MyFitAI.SettingsStatus"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_2"
                            android:text="Chiave Gemini non configurata" />
                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/geminiInputLayout"
                            style="@style/Widget.MyFitAI.InputReadableCompact"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_8"
                            android:hint="@string/ai_key_hint_gemini"
                            app:endIconMode="password_toggle">
                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/geminiApiKeyInput"
                                style="@style/Widget.MyFitAI.InputEditTextReadableCompact"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:contentDescription="@string/ai_gemini_key_input_cd"
                                android:importantForAutofill="no"
                                android:inputType="textPassword"
                                android:singleLine="true" />
                        </com.google.android.material.textfield.TextInputLayout>
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_8"
                            android:orientation="horizontal">
                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/pasteGeminiKeyButton"
                                style="@style/Widget.MyFitAI.SettingsButton.Outlined"
                                android:layout_width="0dp"
                                android:layout_height="@dimen/button_secondary_min_height"
                                android:layout_marginEnd="@dimen/space_4"
                                android:layout_weight="1"
                                android:text="Incolla" />
                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/saveGeminiKeyButton"
                                style="@style/Widget.MyFitAI.SettingsButton.Primary"
                                android:layout_width="0dp"
                                android:layout_height="@dimen/button_secondary_min_height"
                                android:layout_marginStart="@dimen/space_4"
                                android:layout_weight="1"
                                android:text="Verifica e salva" />
                        </LinearLayout>
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_6"
                            android:orientation="horizontal">
                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/replaceGeminiKeyButton"
                                style="@style/Widget.MyFitAI.SettingsButton.Outlined"
                                android:layout_width="0dp"
                                android:layout_height="@dimen/button_secondary_min_height"
                                android:layout_marginEnd="@dimen/space_4"
                                android:layout_weight="1"
                                android:text="Sostituisci" />
                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/deleteGeminiKeyButton"
                                style="@style/Widget.MyFitAI.SettingsButton.Outlined"
                                android:layout_width="0dp"
                                android:layout_height="@dimen/button_secondary_min_height"
                                android:layout_marginStart="@dimen/space_4"
                                android:layout_weight="1"
                                android:text="Elimina" />
                        </LinearLayout>
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/divider_thickness"
                        android:layout_marginTop="@dimen/space_12"
                        android:background="@color/divider" />

                    <LinearLayout
                        android:id="@+id/openAiKeyContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_12"
                        android:orientation="vertical">
                        <TextView
                            style="@style/Text.MyFitAI.SettingsLabel"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="OpenAI" />
                        <TextView
                            android:id="@+id/openAiKeyStatusText"
                            style="@style/Text.MyFitAI.SettingsStatus"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_2"
                            android:text="Nessuna chiave OpenAI salvata" />
                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/openAiInputLayout"
                            style="@style/Widget.MyFitAI.InputReadableCompact"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_8"
                            android:hint="@string/ai_key_hint_openai"
                            app:endIconMode="password_toggle"
                            app:passwordToggleTint="@color/text_secondary">
                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/openAiApiKeyInput"
                                style="@style/Widget.MyFitAI.InputEditTextReadableCompact"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:contentDescription="@string/ai_openai_key_input_cd"
                                android:importantForAutofill="no"
                                android:inputType="textPassword"
                                android:singleLine="true" />
                        </com.google.android.material.textfield.TextInputLayout>
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_8"
                            android:orientation="horizontal">
                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/pasteOpenAiKeyButton"
                                style="@style/Widget.MyFitAI.SettingsButton.Outlined"
                                android:layout_width="0dp"
                                android:layout_height="@dimen/button_secondary_min_height"
                                android:layout_marginEnd="@dimen/space_4"
                                android:layout_weight="1"
                                android:text="Incolla"
                                android:textAllCaps="false" />
                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/saveOpenAiKeyButton"
                                style="@style/Widget.MyFitAI.SettingsButton.Primary"
                                android:layout_width="0dp"
                                android:layout_height="@dimen/button_secondary_min_height"
                                android:layout_marginStart="@dimen/space_4"
                                android:layout_weight="1"
                                android:text="Verifica e salva"
                                android:textAllCaps="false" />
                        </LinearLayout>
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_6"
                            android:orientation="horizontal">
                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/replaceOpenAiKeyButton"
                                style="@style/Widget.MyFitAI.SettingsButton.Outlined"
                                android:layout_width="0dp"
                                android:layout_height="@dimen/button_secondary_min_height"
                                android:layout_marginEnd="@dimen/space_4"
                                android:layout_weight="1"
                                android:text="Sostituisci"
                                android:textAllCaps="false" />
                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/deleteOpenAiKeyButton"
                                style="@style/Widget.MyFitAI.SettingsButton.Outlined"
                                android:layout_width="0dp"
                                android:layout_height="@dimen/button_secondary_min_height"
                                android:layout_marginStart="@dimen/space_4"
                                android:layout_weight="1"
                                android:text="Rimuovi"
                                android:textAllCaps="false" />
                        </LinearLayout>
                    </LinearLayout>

                    <TextView
                        style="@style/Text.MyFitAI.SettingsDescription"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_12"
                        android:text="@string/ai_key_security_note" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 3 · Modelli -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.MyFitAI.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_12">
                <LinearLayout
                    style="@style/Widget.MyFitAI.WhiteCardContent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <TextView
                        android:id="@+id/aiModelsHeader"
                        style="@style/Text.MyFitAI.CardTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/ai_group_models" />
                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.MyFitAI.InputDropdown"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_8"
                        android:hint="Modello Gemini"
                        app:endIconMode="dropdown_menu">
                        <com.google.android.material.textfield.MaterialAutoCompleteTextView
                            android:id="@+id/geminiModelInput"
                            style="@style/Widget.MyFitAI.InputDropdownText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:contentDescription="Seleziona il modello Gemini"
                            android:inputType="none" />
                    </com.google.android.material.textfield.TextInputLayout>
                    <TextView
                        android:id="@+id/geminiModelCostText"
                        style="@style/Text.MyFitAI.SettingsDescription"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_2" />
                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.MyFitAI.InputDropdown"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_12"
                        android:hint="Modello OpenAI"
                        app:endIconMode="dropdown_menu">
                        <com.google.android.material.textfield.MaterialAutoCompleteTextView
                            android:id="@+id/openAiModelInput"
                            style="@style/Widget.MyFitAI.InputDropdownText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:contentDescription="Seleziona il modello OpenAI"
                            android:inputType="none" />
                    </com.google.android.material.textfield.TextInputLayout>
                    <TextView
                        android:id="@+id/openAiModelCostText"
                        style="@style/Text.MyFitAI.SettingsDescription"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_2" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 4 · Costi e consumi -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.MyFitAI.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_12">
                <LinearLayout
                    style="@style/Widget.MyFitAI.WhiteCardContent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <TextView
                        android:id="@+id/aiCostsHeader"
                        style="@style/Text.MyFitAI.CardTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/ai_group_costs" />
                    <LinearLayout
                        android:id="@+id/aiCostGroup"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_8"
                        android:orientation="vertical" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Automazioni: del profilo attivo, schermata separata -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.MyFitAI.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_12">
                <LinearLayout
                    style="@style/Widget.MyFitAI.WhiteCardContent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <com.myfitai.app.ui.widgets.SettingRowView
                        android:id="@+id/rowAiAutomations"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:srDescription="@string/settings_row_automations_desc"
                        app:srIcon="@drawable/ic_setting_gear"
                        app:srLabel="@string/settings_row_automations" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
