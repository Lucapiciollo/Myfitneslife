<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_primary">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingTop="@dimen/space_8"
        android:paddingBottom="@dimen/space_24">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@color/dashboard_header_bg"
                android:paddingHorizontal="@dimen/space_20"
                 android:paddingTop="@dimen/space_16"
                 android:paddingBottom="@dimen/space_20">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">
                    <Space
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1" />
                    <FrameLayout
                        android:layout_width="@dimen/dashboard_pill_height"
                        android:layout_height="@dimen/dashboard_pill_height"
                        android:background="@drawable/bg_logo_circle">
                        <ImageView
                            android:id="@+id/profileButton"
                            android:layout_width="@dimen/status_indicator_size"
                            android:layout_height="@dimen/status_indicator_size"
                            android:layout_gravity="center"
                            android:contentDescription="@string/dashboard_profile_cd"
                            android:src="@drawable/ic_profile"
                            app:tint="@color/accent_green" />
                    </FrameLayout>
                </LinearLayout>

                <TextView
                    android:id="@+id/greetingText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                     android:layout_marginTop="@dimen/space_10"
                    android:text="@string/dashboard_greeting"
                    android:textColor="@color/white"
                      android:textAppearance="@style/Text.MyFitAI.ScreenTitle" />
                <TextView
                    android:id="@+id/todayLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_4"
                    android:textColor="@color/surface_soft"
                    style="@style/Text.MyFitAI.Body" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_4"
                    android:text="@string/dashboard_subtitle"
                    android:textColor="@color/surface_soft"
                    style="@style/Text.MyFitAI.Body" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                 android:layout_marginTop="@dimen/dashboard_sheet_overlap"
                android:background="@drawable/bg_sheet_top_rounded"
                android:orientation="vertical"
                 android:padding="@dimen/space_16">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/planUpdateNoticeCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:visibility="gone"
                    app:cardBackgroundColor="@color/surface_primary"
                    app:cardCornerRadius="@dimen/radius_card"
                    app:cardElevation="@dimen/elevation_card"
                    app:strokeColor="@color/semantic_error"
                     app:strokeWidth="@dimen/border_width_default">
                      <LinearLayout
                         android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/space_16">
                        <TextView
                            style="@style/Text.MyFitAI.CardTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Il tuo piano alimentare potrebbe essere aggiornato"
                            android:textColor="@color/semantic_error" />
                        <TextView
                            style="@style/Text.MyFitAI.BodyCompact"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_4"
                            android:text="Hai modificato dati importanti. Apri il piano per rigenerarlo con le nuove informazioni."
                            android:textColor="@color/text_primary" />
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/planUpdateNoticeButton"
                            style="@style/Widget.MyFitAI.Button.Text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="end"
                            android:layout_marginTop="@dimen/space_4"
                            android:text="Rigenera alimentazione"
                            android:textColor="@color/semantic_error" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/aiConfigurationNoticeCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_8"
                    android:visibility="gone"
                    android:clickable="true"
                    android:focusable="true"
                    app:cardBackgroundColor="@color/surface_primary"
                    app:cardCornerRadius="@dimen/radius_card"
                    app:cardElevation="@dimen/elevation_card"
                    app:strokeColor="@color/accent_green"
                    app:strokeWidth="@dimen/border_width_default">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/space_16">
                        <TextView
                            style="@style/Text.MyFitAI.CardTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/home_ai_not_configured_title"
                            android:textColor="@color/text_primary" />
                        <TextView
                            style="@style/Text.MyFitAI.BodyCompact"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_4"
                            android:text="@string/home_ai_not_configured_message"
                            />
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/aiConfigurationNoticeButton"
                            style="@style/Widget.MyFitAI.Button.Text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_4"
                            android:text="@string/home_ai_not_configured_action" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.myfitai.app.ui.widgets.DashboardMetricsPanel
                    android:id="@+id/dashboardMetricsPanel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_4" />

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_12"
                    app:cardBackgroundColor="@color/white"
                    app:cardCornerRadius="@dimen/radius_card"
                    app:cardElevation="@dimen/elevation_card"
                    app:strokeColor="@color/divider"
                    app:strokeWidth="@dimen/border_width_default">
                <LinearLayout
                    style="@style/Widget.MyFitAI.HomeSectionContent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                 <FrameLayout
                     android:layout_width="match_parent"
                     android:layout_height="wrap_content">
                     <com.myfitai.app.ui.widgets.SectionHeaderView
                         android:layout_width="match_parent"
                         android:layout_height="wrap_content"
                          android:paddingEnd="@dimen/screen_header_icon_size"
                         android:text="Panoramica del corpo" />
                    <ImageButton
                        android:id="@+id/bodyOverviewHelpButton"
                         android:layout_width="@dimen/screen_header_icon_size"
                         android:layout_height="@dimen/screen_header_icon_size"
                         android:layout_gravity="top|end"
                         android:background="@android:color/transparent"
                        android:contentDescription="Spiega panoramica del corpo"
                         android:padding="@dimen/space_8"
                        android:src="@drawable/ic_help_outline"
                        app:tint="@color/text_secondary" />
                 </FrameLayout>

                <TextView
                    android:id="@+id/recompositionStateText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_12"
                     style="@style/Text.MyFitAI.Caption" />

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.MyFitAI.InputDropdown"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_12"
                    android:hint="Misura mostrata"
                    app:endIconMode="dropdown_menu">
                    <com.google.android.material.textfield.MaterialAutoCompleteTextView
                        android:id="@+id/bodyTrendMetricSelector"
                        style="@style/Widget.MyFitAI.InputDropdownText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="none"
                        android:contentDescription="Seleziona la misura del grafico" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.myfitai.app.ui.widgets.BodyMeasurementTrendView
                    android:id="@+id/bodyMeasurementTrendChart"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dashboard_chart_height"
                    android:layout_marginTop="@dimen/space_16" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_4"
                    android:text="Valori reali; seleziona una misura per cambiare vista"
                     style="@style/Text.MyFitAI.Micro" />

                <com.myfitai.app.ui.widgets.TimeRangeSelectorView
                    android:id="@+id/timeRangeSelector"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_12" />
                </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_12"
                    app:cardBackgroundColor="@color/white"
                    app:cardCornerRadius="@dimen/radius_card"
                    app:cardElevation="@dimen/elevation_card"
                    app:strokeColor="@color/divider"
                    app:strokeWidth="@dimen/border_width_default">
                <LinearLayout
                    style="@style/Widget.MyFitAI.HomeSectionContent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                 <FrameLayout
                     android:layout_width="match_parent"
                     android:layout_height="wrap_content">
                     <com.myfitai.app.ui.widgets.SectionHeaderView
                         android:layout_width="match_parent"
                         android:layout_height="wrap_content"
                          android:paddingEnd="@dimen/screen_header_icon_size"
                         android:text="Calorie base giornaliere" />
                    <ImageButton
                        android:id="@+id/caloriesHelpButton"
                         android:layout_width="@dimen/screen_header_icon_size"
                         android:layout_height="@dimen/screen_header_icon_size"
                         android:layout_gravity="top|end"
                         android:background="@android:color/transparent"
                        android:contentDescription="Spiega calorie base, TDEE e target"
                         android:padding="@dimen/space_8"
                        android:src="@drawable/ic_help_outline"
                        app:tint="@color/text_secondary" />
                 </FrameLayout>
                <TextView
                    android:id="@+id/caloriesModeText"
                    style="@style/Text.MyFitAI.StatusValue"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_4"
                    android:text="—"
                    android:textColor="@color/accent_green" />
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/caloriesCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_12"
                    android:clickable="true"
                    android:focusable="true"
                     app:cardBackgroundColor="@color/white"
                     app:cardCornerRadius="@dimen/radius_card"
                     app:cardElevation="@dimen/elevation_card"
                     app:strokeColor="@color/divider"
                     app:strokeWidth="@dimen/border_width_default">
                     <LinearLayout
                         android:id="@+id/caloriesSummaryBody"
                         android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/space_16">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">
                            <TextView
                                style="@style/Text.MyFitAI.Body"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Metabolismo (BMR)"
                                />
                            <TextView
                                android:id="@+id/caloriesBmrValue"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="—"
                                style="@style/Text.MyFitAI.CardTitle" />
                        </LinearLayout>
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_12"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">
                            <TextView
                                style="@style/Text.MyFitAI.Body"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Consumo (TDEE)"
                                />
                            <TextView
                                android:id="@+id/caloriesTdeeValue"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="—"
                                style="@style/Text.MyFitAI.CardTitle" />
                        </LinearLayout>
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_12"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">
                            <TextView
                                style="@style/Text.MyFitAI.BodyEmphasis"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Target"
                                />
                <TextView
                    android:id="@+id/caloriesTargetValue"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="—"
                                style="@style/Text.MyFitAI.CardTitle"
                    android:textColor="@color/accent_green_dark" />
            </LinearLayout>
            <TextView
                android:id="@+id/caloriesTargetSourceText"
                style="@style/Text.MyFitAI.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_6" />
        </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_12"
                    android:baselineAligned="false"
                    android:orientation="horizontal">
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="@dimen/space_4"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:padding="@dimen/space_12"
                        android:background="@drawable/bg_card_soft">
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Consumate oggi"
                            style="@style/Text.MyFitAI.Caption" />
                        <TextView
                            android:id="@+id/caloriesConsumedText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_4"
                            android:text="—"
                            style="@style/Text.MyFitAI.CardTitle" />
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_4"
                            android:text="Proteine consumate"
                            style="@style/Text.MyFitAI.Caption" />
                        <TextView
                            android:id="@+id/caloriesConsumedProteinText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_2"
                            android:text="—"
                            style="@style/Text.MyFitAI.CardTitle" />
                        <com.google.android.material.progressindicator.LinearProgressIndicator
                            android:id="@+id/caloriesConsumedProgress"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_8"
                            app:trackCornerRadius="@dimen/progress_track_corner_radius"
                            app:trackThickness="@dimen/progress_track_thickness"
                            app:indicatorColor="@color/accent_green"
                            app:trackColor="@color/divider" />
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_4"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:padding="@dimen/space_12"
                        android:background="@drawable/bg_card_soft">
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Rimangono"
                            style="@style/Text.MyFitAI.Caption" />
                        <TextView
                            android:id="@+id/caloriesRemainingText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_4"
                            android:text="—"
                            style="@style/Text.MyFitAI.CardTitle"
                            android:textColor="@color/accent_green_dark" />
                        <com.google.android.material.progressindicator.LinearProgressIndicator
                            android:id="@+id/caloriesRemainingProgress"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_8"
                            app:trackCornerRadius="@dimen/progress_track_corner_radius"
                            app:trackThickness="@dimen/progress_track_thickness"
                            app:indicatorColor="@color/text_muted"
                            app:trackColor="@color/divider" />
                    </LinearLayout>
                </LinearLayout>
                <TextView
                    android:id="@+id/caloriesConsumptionNote"
                    style="@style/Text.MyFitAI.Caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_8" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_4"
                    android:text="Le barre confrontano le calorie registrate e ancora disponibili con il target indicato sopra."
                    style="@style/Text.MyFitAI.Micro" />
                </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_12"
                    app:cardBackgroundColor="@color/white"
                    app:cardCornerRadius="@dimen/radius_card"
                    app:cardElevation="@dimen/elevation_card"
                    app:strokeColor="@color/divider"
                    app:strokeWidth="@dimen/border_width_default">
                <LinearLayout
                    style="@style/Widget.MyFitAI.HomeSectionContent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                 <FrameLayout
                     android:layout_width="match_parent"
                     android:layout_height="wrap_content">
                     <com.myfitai.app.ui.widgets.SectionHeaderView
                         android:layout_width="match_parent"
                         android:layout_height="wrap_content"
                          android:paddingEnd="@dimen/screen_header_icon_size"
                         android:text="Riserva di recupero" />
                    <ImageButton
                        android:id="@+id/recoveryHelpButton"
                         android:layout_width="@dimen/screen_header_icon_size"
                         android:layout_height="@dimen/screen_header_icon_size"
                         android:layout_gravity="top|end"
                         android:background="@android:color/transparent"
                        android:contentDescription="Spiega la riserva di recupero"
                         android:padding="@dimen/space_8"
                        android:src="@drawable/ic_help_outline"
                        app:tint="@color/text_secondary" />
                 </FrameLayout>
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_12"
                     app:cardBackgroundColor="@color/white"
                    app:cardCornerRadius="@dimen/radius_card"
                    app:cardElevation="@dimen/elevation_card"
                    app:strokeColor="@color/divider"
                    app:strokeWidth="@dimen/border_width_default">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/space_16">
                        <TextView
                            android:id="@+id/recoveryValueText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="—"
                            style="@style/Text.MyFitAI.CardValue" />
                        <TextView
                            android:id="@+id/recoveryHintText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_8"
                            android:text="Kcal extra ancora da distribuire nei prossimi giorni."
                            style="@style/Text.MyFitAI.Caption" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
                </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/weeklyExpectationCard"
                    style="@style/Widget.MyFitAI.Dialog.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_12">

                    <LinearLayout
                        style="@style/Widget.MyFitAI.HomeSectionContent"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <com.myfitai.app.ui.widgets.SectionHeaderView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Possibile calo teorico" />

                            <ImageButton
                                android:id="@+id/weeklyExpectationHelpButton"
                                 android:layout_width="@dimen/screen_header_icon_size"
                                 android:layout_height="@dimen/screen_header_icon_size"
                                android:background="@android:color/transparent"
                                android:contentDescription="Spiega il possibile calo teorico"
                                 android:padding="@dimen/space_8"
                                android:src="@drawable/ic_help_outline"
                                app:tint="@color/text_secondary" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/weeklyExpectationStatus"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_12"
                            android:text="Caricamento del piano settimanale…"
                            style="@style/Text.MyFitAI.CardValue"
                            android:textColor="@color/accent_green_dark" />

                        <TextView
                            android:id="@+id/weeklyExpectationDetail"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_8"
                            style="@style/Text.MyFitAI.Body" />

                        <TextView
                            android:id="@+id/weeklyExpectationCaution"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_8"
                            android:text="Indicazione basata sul piano, non una previsione certa del peso."
                            style="@style/Text.MyFitAI.Micro" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_12"
                    app:cardBackgroundColor="@color/white"
                    app:cardCornerRadius="@dimen/radius_card"
                    app:cardElevation="@dimen/elevation_card"
                    app:strokeColor="@color/divider"
                    app:strokeWidth="@dimen/border_width_default">
                <LinearLayout
                    style="@style/Widget.MyFitAI.HomeSectionContent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                 <FrameLayout
                     android:layout_width="match_parent"
                     android:layout_height="wrap_content">
                     <com.myfitai.app.ui.widgets.SectionHeaderView
                         android:layout_width="match_parent"
                         android:layout_height="wrap_content"
                          android:paddingEnd="@dimen/screen_header_icon_size"
                         android:text="Prossimi pasti" />
                    <ImageButton
                        android:id="@+id/nextMealHelpButton"
                         android:layout_width="@dimen/screen_header_icon_size"
                         android:layout_height="@dimen/screen_header_icon_size"
                         android:layout_gravity="top|end"
                         android:background="@android:color/transparent"
                        android:contentDescription="Spiega il prossimo pasto"
                         android:padding="@dimen/space_8"
                        android:src="@drawable/ic_help_outline"
                        app:tint="@color/text_secondary" />
                 </FrameLayout>

                <com.myfitai.app.ui.widgets.MealCardView android:id="@+id/nextMealCard" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_12" />
                <com.myfitai.app.ui.widgets.MealCardView
                    android:id="@+id/secondNextMealCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_8"
                    android:alpha="0.58" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/todayMenuButton"
                    style="@style/Widget.MyFitAI.Button.Text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_4"
                    android:text="Vedi i prossimi pasti"
                    android:textAllCaps="false" />
                </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/workoutSectionCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_12"
                    app:cardBackgroundColor="@color/white"
                    app:cardCornerRadius="@dimen/radius_card"
                    app:cardElevation="@dimen/elevation_card"
                    app:strokeColor="@color/divider"
                    app:strokeWidth="@dimen/border_width_default">
                <LinearLayout
                    style="@style/Widget.MyFitAI.HomeSectionContent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                 <FrameLayout
                     android:layout_width="match_parent"
                     android:layout_height="wrap_content">
                     <com.myfitai.app.ui.widgets.SectionHeaderView
                         android:layout_width="match_parent"
                         android:layout_height="wrap_content"
                          android:paddingEnd="@dimen/screen_header_icon_size"
                         android:text="@string/dashboard_next_workout_title" />
                    <ImageButton
                        android:id="@+id/nextWorkoutHelpButton"
                         android:layout_width="@dimen/screen_header_icon_size"
                         android:layout_height="@dimen/screen_header_icon_size"
                         android:layout_gravity="top|end"
                         android:background="@android:color/transparent"
                        android:contentDescription="Spiega il prossimo allenamento"
                         android:padding="@dimen/space_8"
                        android:src="@drawable/ic_help_outline"
                        app:tint="@color/text_secondary" />
                 </FrameLayout>
                <com.myfitai.app.ui.widgets.WorkoutCardView android:id="@+id/nextWorkoutCard" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_12" />
                </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_12"
                    app:cardBackgroundColor="@color/white"
                    app:cardCornerRadius="@dimen/radius_card"
                    app:cardElevation="@dimen/elevation_card"
                    app:strokeColor="@color/divider"
                    app:strokeWidth="@dimen/border_width_default">
                    <LinearLayout
                        style="@style/Widget.MyFitAI.HomeSectionContent"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">
                        <com.myfitai.app.ui.widgets.SectionHeaderView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Azioni rapide" />
                         <LinearLayout
                             android:id="@+id/quickActionsRow"
                             android:layout_width="match_parent"
                             android:layout_height="wrap_content"
                             android:layout_marginTop="@dimen/space_12"
                             android:orientation="vertical">
                             <com.google.android.material.button.MaterialButton
                                 android:id="@+id/measurementsButton"
                                 style="@style/Widget.MyFitAI.Button.Outlined"
                                 android:layout_width="match_parent"
                                 android:layout_height="@dimen/button_secondary_min_height"
                                 android:gravity="center"
                                 android:minWidth="0dp"
                                 android:text="Aggiungi rilevazione"
                                 android:textAllCaps="false" />
                             <com.google.android.material.button.MaterialButton
                                 android:id="@+id/addExtraButton"
                                 style="@style/Widget.MyFitAI.Button.Outlined"
                                 android:layout_width="match_parent"
                                 android:layout_height="@dimen/button_secondary_min_height"
                                 android:layout_marginTop="@dimen/space_8"
                                 android:gravity="center"
                                 android:minWidth="0dp"
                                 android:text="Inserisci extra"
                                 android:textAllCaps="false" />
                         </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <include layout="@layout/view_bottom_navigation" />
</LinearLayout>
