<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_primary">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingBottom="@dimen/space_24">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/space_16">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/screen_header_height"
                android:gravity="center_vertical"
                android:background="@drawable/bg_screen_header"
                android:paddingHorizontal="@dimen/space_8">

                <androidx.appcompat.widget.AppCompatImageButton
                    android:id="@+id/backButton"
                    android:layout_width="@dimen/screen_header_icon_size"
                    android:layout_height="@dimen/screen_header_icon_size"
                    android:background="@android:color/transparent"
                    android:contentDescription="Indietro"
                    android:padding="@dimen/space_10"
                    android:src="@drawable/ic_arrow_back" />

                <TextView
                    style="@style/Text.MyFitAI.ScreenTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="Bioimpedenziometria" />

                <Space
                    android:layout_width="@dimen/screen_header_icon_size"
                    android:layout_height="@dimen/screen_header_icon_size" />
            </LinearLayout>

            <com.myfitai.app.ui.widgets.BiaSegmentView
                android:id="@+id/biaSegment"
                android:layout_width="match_parent"
                android:layout_height="@dimen/control_min_height"
                android:layout_marginTop="@dimen/space_8" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/aiConfigurationNoticeCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_8"
                android:visibility="gone"
                app:cardBackgroundColor="@color/surface_primary"
                app:cardCornerRadius="@dimen/radius_card"
                app:cardElevation="@dimen/elevation_card"
                app:strokeColor="@color/accent_green"
                app:strokeWidth="@dimen/border_width_default">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/space_16">
                    <TextView
                        style="@style/Text.MyFitAI.CardTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Nessun provider IA configurato" />
                    <TextView
                        style="@style/Text.MyFitAI.BodyCompact"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_4"
                        android:text="Per usare le funzioni IA della bioimpedenziometria devi scegliere Gemini o OpenAI e configurare la relativa API key personale nelle Impostazioni." />
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/aiConfigurationNoticeButton"
                        style="@style/Widget.MyFitAI.Button.Text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_4"
                        android:text="Apri impostazioni IA" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:id="@+id/newMeasurementContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                 <com.google.android.material.card.MaterialCardView
                     android:id="@+id/biaDateCard"
                     android:layout_width="match_parent"
                     android:layout_height="wrap_content"
                     android:layout_marginTop="@dimen/space_12"
                     style="@style/Widget.MyFitAI.Card">
                    <LinearLayout
                        style="@style/Widget.MyFitAI.TabCardContent"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/settings_section_header_height"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Data e ora"
                            android:textColor="@color/text_secondary"
                            android:textStyle="bold" />
                        <ImageButton
                            android:id="@+id/biaDateHelpButton"
                            android:layout_width="@dimen/screen_header_icon_size"
                            android:layout_height="@dimen/screen_header_icon_size"
                            android:background="@android:color/transparent"
                            android:contentDescription="Spiega data e ora"
                            android:padding="@dimen/space_8"
                            android:src="@drawable/ic_help_outline"
                            app:tint="@color/text_secondary" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/Widget.MyFitAI.InputReadableCompact"
                            android:id="@+id/dateInputLayout"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:hint="Data rilevazione"
                            app:endIconDrawable="@drawable/ic_calendar"
                            app:endIconMode="custom">

                            <com.google.android.material.textfield.TextInputEditText
                style="@style/Widget.MyFitAI.InputEditTextReadableCompact"
                                android:id="@+id/dateInput"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:clickable="true"
                                 android:focusable="false"
                                 android:gravity="center_vertical"
                                 android:inputType="none"
                                 android:includeFontPadding="false"
                                 android:maxLines="1"
                                 android:singleLine="true"
                                  android:ellipsize="end"
                                  android:textColor="@color/text_primary" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.textfield.TextInputLayout
                             style="@style/Widget.MyFitAI.InputReadableCompact"
                            android:id="@+id/timeInputLayout"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/space_8"
                            android:hint="Ora"
                            app:endIconDrawable="@drawable/ic_setting_clock"
                            app:endIconMode="custom">

                            <com.google.android.material.textfield.TextInputEditText
                style="@style/Widget.MyFitAI.InputEditTextReadableCompact"
                                android:id="@+id/timeInput"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:clickable="true"
                                android:focusable="false"
                                android:gravity="center_vertical"
                                android:inputType="none"
                                android:minHeight="@dimen/control_min_height"
                                android:textColor="@color/text_primary"
                                android:textSize="16sp"
 />
                        </com.google.android.material.textfield.TextInputLayout>
                    </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                 <com.google.android.material.card.MaterialCardView
                     android:id="@+id/biaConditionsCard"
                     android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_8"
                    style="@style/Widget.MyFitAI.Card">
                    <LinearLayout
                        style="@style/Widget.MyFitAI.TabCardContent"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/settings_section_header_height"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">
                        <com.myfitai.app.ui.widgets.SectionHeaderView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Condizioni della misura" />
                        <ImageButton
                            android:id="@+id/biaConditionsHelpButton"
                            android:layout_width="@dimen/screen_header_icon_size"
                            android:layout_height="@dimen/screen_header_icon_size"
                            android:background="@android:color/transparent"
                            android:contentDescription="Spiega condizioni della misura"
                            android:padding="@dimen/space_8"
                            android:src="@drawable/ic_help_outline"
                            app:tint="@color/text_secondary" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <com.google.android.material.checkbox.MaterialCheckBox
                            style="@style/Widget.MyFitAI.MeasurementCheck"
                            android:id="@+id/checkFasting"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="A digiuno" />

                        <com.google.android.material.checkbox.MaterialCheckBox
                            style="@style/Widget.MyFitAI.MeasurementCheck"
                            android:id="@+id/checkJustWoken"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Appena sveglio" />
                        <com.google.android.material.checkbox.MaterialCheckBox
                            style="@style/Widget.MyFitAI.MeasurementCheck"
                            android:id="@+id/checkAfterShower"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Dopo bagno" />

                        <com.google.android.material.checkbox.MaterialCheckBox
                            style="@style/Widget.MyFitAI.MeasurementCheck"
                            android:id="@+id/checkNoWorkout"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="No allenamento" />
                    </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                 <com.google.android.material.card.MaterialCardView
                     android:id="@+id/biaResultsCard"
                     android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_8"
                    style="@style/Widget.MyFitAI.Card">
                    <LinearLayout
                        style="@style/Widget.MyFitAI.TabCardContent"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/settings_section_header_height"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">
                        <com.myfitai.app.ui.widgets.SectionHeaderView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Risultati" />
                        <ImageButton
                            android:id="@+id/biaResultsHelpButton"
                            android:layout_width="@dimen/screen_header_icon_size"
                            android:layout_height="@dimen/screen_header_icon_size"
                            android:background="@android:color/transparent"
                            android:contentDescription="Spiega risultati BIA"
                            android:padding="@dimen/space_8"
                            android:src="@drawable/ic_help_outline"
                            app:tint="@color/text_secondary" />
                    </LinearLayout>

                    <com.myfitai.app.ui.widgets.MeasurementRowView android:id="@+id/rowWeight" android:layout_width="match_parent" android:layout_height="wrap_content" />
                    <com.myfitai.app.ui.widgets.MeasurementRowView android:id="@+id/rowBodyFat" android:layout_width="match_parent" android:layout_height="wrap_content" />
                    <com.myfitai.app.ui.widgets.MeasurementRowView android:id="@+id/rowVisceralFat" android:layout_width="match_parent" android:layout_height="wrap_content" />
                    <com.myfitai.app.ui.widgets.MeasurementRowView android:id="@+id/rowMuscleMass" android:layout_width="match_parent" android:layout_height="wrap_content" />
                    <com.myfitai.app.ui.widgets.MeasurementRowView android:id="@+id/rowSkeletalMuscle" android:layout_width="match_parent" android:layout_height="wrap_content" />
                    <com.myfitai.app.ui.widgets.MeasurementRowView android:id="@+id/rowBodyWater" android:layout_width="match_parent" android:layout_height="wrap_content" />
                    <com.myfitai.app.ui.widgets.MeasurementRowView android:id="@+id/rowBmr" android:layout_width="match_parent" android:layout_height="wrap_content" />
                    <com.myfitai.app.ui.widgets.MeasurementRowView android:id="@+id/rowFatMass" android:layout_width="match_parent" android:layout_height="wrap_content" />
                    <com.myfitai.app.ui.widgets.MeasurementRowView android:id="@+id/rowLeanMass" android:layout_width="match_parent" android:layout_height="wrap_content" />
                    <com.myfitai.app.ui.widgets.MeasurementRowView android:id="@+id/rowBodyWaterKg" android:layout_width="match_parent" android:layout_height="wrap_content" />
                    <com.myfitai.app.ui.widgets.MeasurementRowView android:id="@+id/rowSubcutaneousFat" android:layout_width="match_parent" android:layout_height="wrap_content" />
                    <com.myfitai.app.ui.widgets.MeasurementRowView android:id="@+id/rowBoneMass" android:layout_width="match_parent" android:layout_height="wrap_content" />
                    <com.myfitai.app.ui.widgets.MeasurementRowView android:id="@+id/rowProteinPercent" android:layout_width="match_parent" android:layout_height="wrap_content" />
                    <com.myfitai.app.ui.widgets.MeasurementRowView android:id="@+id/rowProteinKg" android:layout_width="match_parent" android:layout_height="wrap_content" />
                    <com.myfitai.app.ui.widgets.MeasurementRowView android:id="@+id/rowBodyAge" android:layout_width="match_parent" android:layout_height="wrap_content" />
                    <com.myfitai.app.ui.widgets.MeasurementRowView android:id="@+id/rowBmi" android:layout_width="match_parent" android:layout_height="wrap_content" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.textview.MaterialTextView
                    style="@style/Text.MyFitAI.Micro"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_4"
                    android:paddingHorizontal="@dimen/space_4"
                    android:text="Tocca un valore per inserirlo o modificarlo." />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_12"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/importPhotoButton"
                        style="@style/Widget.MyFitAI.Button.Outlined"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/button_secondary_min_height"
                        android:layout_weight="1"
                        android:text="Importa foto"
                        android:textAllCaps="false" />

                    <Space
                        android:layout_width="@dimen/space_8"
                        android:layout_height="1dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/saveButton"
                        style="@style/Widget.MyFitAI.Button.Primary"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/button_primary_min_height"
                        android:layout_weight="1"
                        android:text="Salva" />
                </LinearLayout>

                 <com.google.android.material.textview.MaterialTextView
                     android:id="@+id/importStatusText"
                     style="@style/Text.MyFitAI.BodyCompact"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_8"
                     android:visibility="gone" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/historyContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                 <com.google.android.material.button.MaterialButton
                     android:id="@+id/addBiaFromHistoryButton"
                    style="@style/Widget.MyFitAI.Button.Primary"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/button_primary_min_height"
                    android:layout_marginTop="@dimen/space_12"
                     android:text="Inserisci nuova BIA"
                     android:textAllCaps="false" />

                  <com.google.android.material.textview.MaterialTextView
                      android:id="@+id/historyEmptyText"
                      style="@style/Text.MyFitAI.Body"
                     android:layout_width="match_parent"
                     android:layout_height="wrap_content"
                     android:layout_marginTop="@dimen/space_12"
                     android:text="Nessuna misurazione BIA salvata per questo profilo."
                      android:visibility="gone" />

                  <com.google.android.material.textview.MaterialTextView
                      android:id="@+id/historySummary"
                      style="@style/Text.MyFitAI.Body"
                     android:layout_width="match_parent"
                     android:layout_height="wrap_content"
                     android:layout_marginTop="@dimen/space_12"
                      android:background="@drawable/bg_card"
                     android:padding="@dimen/space_16"
                      android:textColor="@color/text_primary"
                     android:visibility="gone" />

                 <com.google.android.material.button.MaterialButton
                     android:id="@+id/analyzeBiaButton"
                    style="@style/Widget.MyFitAI.Button.Outlined"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/button_secondary_min_height"
                    android:layout_marginTop="@dimen/space_8"
                     android:text="Analisi sportiva BIA"
                     android:textAllCaps="false"
                     android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/historyList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_8"
                    android:orientation="vertical" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <include layout="@layout/view_bottom_navigation" />
</LinearLayout>
