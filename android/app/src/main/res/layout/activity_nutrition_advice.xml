<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_primary">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/space_16"
            android:paddingTop="@dimen/space_8"
            android:paddingBottom="@dimen/space_24">

            <LinearLayout style="@style/Widget.MyFitAI.ScreenHeader"
                android:layout_width="match_parent"
                android:layout_height="@dimen/screen_header_height"
                android:gravity="center_vertical">
                <ImageButton
                    android:id="@+id/backButton"
                    android:layout_width="@dimen/screen_header_icon_size"
                    android:layout_height="@dimen/screen_header_icon_size"
                     android:background="?attr/selectableItemBackgroundBorderless"
                     android:contentDescription="Indietro"
                     android:padding="@dimen/space_8"
                     android:src="@drawable/ic_arrow_back"
                     app:tint="@color/text_primary" />
                <TextView
                    android:id="@+id/title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="Chiedi all'IA"
                    android:textColor="@color/text_primary"
                     style="@style/Text.MyFitAI.ScreenTitle" />
                <Space
                    android:layout_width="@dimen/screen_header_icon_size"
                    android:layout_height="1dp" />
            </LinearLayout>

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.MyFitAI.Card"
                app:cardBackgroundColor="@color/white"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_8">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    style="@style/Widget.MyFitAI.TabCardContent">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Consulente alimentare"
                        android:textColor="@color/text_primary"
                        style="@style/Text.MyFitAI.Section" />
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_4"
                        android:text="Chiedi cosa potresti mangiare senza stravolgere il piano. Questa chat non viene storicizzata e l'agente risponde esclusivamente a richieste alimentari e nutrizionali."
                        style="@style/Text.MyFitAI.Body" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.MyFitAI.Card"
                app:cardBackgroundColor="@color/white"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                 android:layout_marginTop="@dimen/space_12">
            <LinearLayout
                style="@style/Widget.MyFitAI.TabCardContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
            <com.myfitai.app.ui.widgets.SectionHeaderView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Cosa vuoi mangiare o sapere?" />

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.MyFitAI.Input"
                app:boxBackgroundColor="@color/white"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_8"
                android:hint="Es. Stasera vorrei una pizza: cosa mi consigli per restare vicino al piano?">
                <com.google.android.material.textfield.TextInputEditText
                style="@style/Widget.MyFitAI.InputEditText"
                    android:id="@+id/questionInput"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/nutrition_question_field_height"
                    android:gravity="top|start"
                    android:inputType="textMultiLine|textCapSentences"
                    android:maxLines="5" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/askButton"
                style="@style/Widget.MyFitAI.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="@dimen/button_primary_min_height"
                android:layout_marginTop="@dimen/space_12"
                android:text="Chiedi consiglio"
                android:textAllCaps="false" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/aiConfigurationNoticeCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_8"
                android:visibility="gone"
                app:cardBackgroundColor="@color/surface_primary"
                app:cardCornerRadius="@dimen/radius_card"
                app:cardElevation="@dimen/elevation_card"
                app:strokeColor="@color/accent_green"
                app:strokeWidth="@dimen/border_width_default">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/space_16">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Nessun provider IA configurato"
                        android:textColor="@color/text_primary"
                        style="@style/Text.MyFitAI.CardTitle" />
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_4"
                        android:text="Per usare Alimentazione devi scegliere Gemini o OpenAI e configurare la relativa API key personale nelle Impostazioni."
                        android:textColor="@color/text_secondary"
                        style="@style/Text.MyFitAI.Body" />
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/aiConfigurationNoticeButton"
                        style="@style/Widget.MyFitAI.Button.Text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_4"
                        android:text="Apri impostazioni IA" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:id="@+id/loadingRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_12"
                android:gravity="start"
                android:orientation="horizontal"
                android:visibility="gone">
                <ProgressBar
                    android:layout_width="@dimen/progress_compact_size"
                    android:layout_height="@dimen/progress_compact_size" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_8"
                    android:text="Sto valutando il piano e la tua richiesta…"
                    android:textColor="@color/text_secondary"
                    style="@style/Text.MyFitAI.Body" />
            </LinearLayout>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/answerCard"
                style="@style/Widget.MyFitAI.Card"
                app:cardBackgroundColor="@color/white"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_16"
                android:visibility="gone"
                >
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    style="@style/Widget.MyFitAI.TabCardContent">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Risposta IA"
                        style="@style/Text.MyFitAI.Section" />
                    <TextView
                        android:id="@+id/providerText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_2"
                        style="@style/Text.MyFitAI.Caption"
                        android:visibility="gone" />
                    <TextView
                        android:id="@+id/answerText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_8"
                        style="@style/Text.MyFitAI.Body" />
                    <TextView
                        android:id="@+id/assumptionsText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_8"
                        style="@style/Text.MyFitAI.Caption"
                        android:visibility="gone" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:id="@+id/suggestionsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_12"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/statusText"
                style="@style/Text.MyFitAI.BodyCompact"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_12"
                android:gravity="center"
                android:visibility="gone" />

        </LinearLayout>
    </ScrollView>

    <include layout="@layout/view_bottom_navigation" />
</LinearLayout>
