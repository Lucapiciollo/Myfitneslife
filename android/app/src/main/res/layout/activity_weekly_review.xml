<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_primary">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
             android:paddingHorizontal="@dimen/space_16"
             android:paddingTop="@dimen/space_8"
             android:paddingBottom="@dimen/space_24">

             <LinearLayout android:layout_width="match_parent" android:layout_height="@dimen/weekly_screen_header_height" android:background="@drawable/bg_screen_header" android:gravity="center_vertical" android:paddingHorizontal="@dimen/space_8">
                <androidx.appcompat.widget.AppCompatImageButton
                    android:id="@+id/backButton"
                    android:layout_width="@dimen/screen_header_icon_size"
                    android:layout_height="@dimen/screen_header_icon_size"
                     android:background="?attr/selectableItemBackgroundBorderless"
                    android:padding="@dimen/space_8"
                    android:src="@drawable/ic_arrow_back"
                    android:contentDescription="Indietro"
                    app:tint="@color/text_primary" />
                <androidx.appcompat.widget.AppCompatImageButton
                    android:id="@+id/prevWeekButton"
                    android:layout_width="@dimen/week_navigation_icon_size"
                    android:layout_height="@dimen/week_navigation_icon_size"
                    android:background="@android:color/transparent"
                    android:padding="@dimen/space_8"
                    android:src="@drawable/ic_arrow_back"
                    android:contentDescription="Settimana precedente"
                    app:tint="@color/text_primary" />
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                    <TextView style="@style/Text.MyFitAI.ScreenTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:text="Review settimanale" />
                    <TextView android:id="@+id/weekLabel" style="@style/Text.MyFitAI.ScreenDate" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_4" android:gravity="center" />
                </LinearLayout>
                <androidx.appcompat.widget.AppCompatImageButton
                    android:id="@+id/nextWeekButton"
                    android:layout_width="@dimen/week_navigation_icon_size"
                    android:layout_height="@dimen/week_navigation_icon_size"
                    android:background="@android:color/transparent"
                    android:padding="@dimen/space_8"
                    android:rotation="180"
                    android:src="@drawable/ic_arrow_back"
                    android:contentDescription="Settimana successiva"
                    app:tint="@color/text_primary" />
            </LinearLayout>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/reviewStatusCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                 android:layout_marginTop="@dimen/space_12"
                style="@style/Widget.MyFitAI.Card">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                      android:background="@color/white"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/space_16"
                    android:paddingTop="@dimen/space_12"
                    android:paddingEnd="@dimen/space_16"
                    android:paddingBottom="@dimen/space_16">
                    <ImageView android:layout_width="@dimen/space_24" android:layout_height="@dimen/space_24" android:importantForAccessibility="no" android:src="@drawable/ic_check_circle" />
                    <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="@dimen/space_12" android:orientation="vertical">
                        <TextView android:id="@+id/reviewTitle" style="@style/Text.MyFitAI.CardTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Review settimanale" />
                        <TextView android:id="@+id/reviewSummary" style="@style/Text.MyFitAI.Body" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_2" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

                         <com.google.android.material.card.MaterialCardView style="@style/Widget.MyFitAI.Card" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_12">
                            <LinearLayout style="@style/Widget.MyFitAI.HomeSectionContent" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center">
                    <TextView style="@style/Text.MyFitAI.Caption" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Pasti segnati" />
                     <TextView android:id="@+id/adherenceValue" style="@style/Text.MyFitAI.CardTitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_4" android:text="—" />
                </LinearLayout>
                <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center">
                    <TextView style="@style/Text.MyFitAI.Caption" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Sgarri" />
                     <TextView android:id="@+id/cheatsValue" style="@style/Text.MyFitAI.CardTitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_4" android:text="—" />
                </LinearLayout>
                <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center">
                    <TextView style="@style/Text.MyFitAI.Caption" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Allenamenti" />
                     <TextView android:id="@+id/workoutsValue" style="@style/Text.MyFitAI.CardTitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_4" android:text="—" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_8"
                 android:id="@+id/trackingCoverageText"
                 android:text="Piano seguito: percentuale dei pasti segnati come consumati rispetto a quelli previsti."
                style="@style/Text.MyFitAI.Micro"
                                 android:gravity="start" />
                            </LinearLayout>
                        </com.google.android.material.card.MaterialCardView>

             <com.google.android.material.card.MaterialCardView style="@style/Widget.MyFitAI.Card" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_12">
                            <LinearLayout style="@style/Widget.MyFitAI.HomeSectionContent" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                        <com.myfitai.app.ui.widgets.SectionHeaderView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Piano nutrizionale medio" />
                        <TextView android:id="@+id/avgKcalValue" style="@style/Text.MyFitAI.CardValue" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_4" android:text="—" />
                        <TextView android:id="@+id/targetKcalValue" style="@style/Text.MyFitAI.Body" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Target: —" />

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_20" android:orientation="horizontal">
                <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
                    <TextView style="@style/Text.MyFitAI.Caption" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Proteine" />
                    <TextView android:id="@+id/avgProteinValue" style="@style/Text.MyFitAI.CardTitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_4" android:text="—" />
                    <TextView android:id="@+id/targetProteinValue" style="@style/Text.MyFitAI.Caption" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Target: —" />
                </LinearLayout>
                <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
                    <TextView style="@style/Text.MyFitAI.Caption" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Carboidrati" />
                    <TextView android:id="@+id/avgCarbsValue" style="@style/Text.MyFitAI.CardTitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_4" android:text="—" />
                    <TextView android:id="@+id/targetCarbsValue" style="@style/Text.MyFitAI.Caption" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Target: —" />
                </LinearLayout>
                <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
                    <TextView style="@style/Text.MyFitAI.Caption" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Grassi" />
                    <TextView android:id="@+id/avgFatValue" style="@style/Text.MyFitAI.CardTitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_4" android:text="—" />
                    <TextView android:id="@+id/targetFatValue" style="@style/Text.MyFitAI.Caption" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Target: —" />
                </LinearLayout>
                        </LinearLayout>
                            </LinearLayout>
                        </com.google.android.material.card.MaterialCardView>

             <com.google.android.material.card.MaterialCardView style="@style/Widget.MyFitAI.Card" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_12">
                <LinearLayout style="@style/Widget.MyFitAI.HomeSectionContent" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                    <com.myfitai.app.ui.widgets.SectionHeaderView android:id="@+id/bodyChangesHeader" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Variazioni osservate" />
                    <TextView android:id="@+id/bodyChangesText" style="@style/Text.MyFitAI.Body" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_8" android:textColor="@color/text_primary" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

             <com.google.android.material.card.MaterialCardView android:id="@+id/observationsCard" style="@style/Widget.MyFitAI.Card" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_12" android:visibility="gone">
                <LinearLayout style="@style/Widget.MyFitAI.HomeSectionContent" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                    <com.myfitai.app.ui.widgets.SectionHeaderView android:id="@+id/observationsHeader" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Osservazioni" />
                    <LinearLayout android:id="@+id/observationsContainer" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="@dimen/space_8" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

             <com.google.android.material.card.MaterialCardView android:id="@+id/guidanceCard" style="@style/Widget.MyFitAI.Card" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_12" android:visibility="gone">
                <LinearLayout style="@style/Widget.MyFitAI.HomeSectionContent" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                    <com.myfitai.app.ui.widgets.SectionHeaderView android:id="@+id/guidanceHeader" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Prossima settimana" />
                    <LinearLayout android:id="@+id/guidanceContainer" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="@dimen/space_8" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

              <TextView android:id="@+id/statusText" style="@style/Text.MyFitAI.Caption" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_16" android:gravity="start" android:visibility="gone" />
            <ProgressBar android:id="@+id/reviewProgress" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center_horizontal" android:layout_marginTop="@dimen/space_12" android:visibility="gone" />
             <com.google.android.material.button.MaterialButton
                 android:id="@+id/generateReviewButton"
                 style="@style/Widget.MyFitAI.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="@dimen/button_primary_min_height"
                android:layout_marginTop="@dimen/space_16"
                android:text="Genera review settimanale"
                android:textAllCaps="false"
                 android:textStyle="bold" />
        </LinearLayout>
    </ScrollView>
    <include layout="@layout/view_bottom_navigation" />
</LinearLayout>
