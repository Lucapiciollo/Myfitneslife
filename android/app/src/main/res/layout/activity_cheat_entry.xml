<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_primary">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
             android:paddingHorizontal="@dimen/space_16"
             android:paddingTop="@dimen/space_8"
             android:paddingBottom="@dimen/space_24">

            <LinearLayout style="@style/Widget.MyFitAI.ScreenHeader"
                android:layout_width="match_parent"
                android:layout_height="@dimen/screen_header_height"
                android:gravity="center_vertical">
                <ImageButton
                    android:id="@+id/backButton"
                    android:layout_width="@dimen/screen_header_icon_size"
                    android:layout_height="@dimen/screen_header_icon_size"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Indietro"
                    android:padding="@dimen/space_8"
                    android:src="@drawable/ic_arrow_back"
                    app:tint="@color/text_primary" />
                 <TextView
                     style="@style/Text.MyFitAI.ScreenTitle"
                     android:layout_width="0dp"
                     android:layout_height="wrap_content"
                     android:layout_weight="1"
                     android:gravity="center"
                     android:text="Registra sgarro" />
            </LinearLayout>

            <com.myfitai.app.ui.widgets.SelectableSegmentView
                android:id="@+id/modeSegment"
                android:layout_width="match_parent"
                android:layout_height="@dimen/control_compact_min_height" />

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.MyFitAI.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_12">
            <LinearLayout
                style="@style/Widget.MyFitAI.HomeSectionContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
            <com.myfitai.app.ui.widgets.SectionHeaderView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Cosa hai mangiato?" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/foodChipGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_8"
                app:singleSelection="true"
                app:chipSpacingHorizontal="@dimen/space_8"
                app:chipSpacingVertical="@dimen/space_8">
                <com.google.android.material.chip.Chip android:id="@+id/chipPizza" style="@style/Widget.Material3.Chip.Filter" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Pizza" android:checkable="true" app:chipBackgroundColor="@color/chip_background_selector" android:textColor="@color/chip_text_selector" app:checkedIconVisible="false" app:chipStrokeColor="@color/divider" app:chipStrokeWidth="@dimen/border_width_default" />
                <com.google.android.material.chip.Chip android:id="@+id/chipGelato" style="@style/Widget.Material3.Chip.Filter" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Gelato" android:checkable="true" app:chipBackgroundColor="@color/chip_background_selector" android:textColor="@color/chip_text_selector" app:checkedIconVisible="false" app:chipStrokeColor="@color/divider" app:chipStrokeWidth="@dimen/border_width_default" />
                <com.google.android.material.chip.Chip android:id="@+id/chipSushi" style="@style/Widget.Material3.Chip.Filter" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Sushi" android:checkable="true" app:chipBackgroundColor="@color/chip_background_selector" android:textColor="@color/chip_text_selector" app:checkedIconVisible="false" app:chipStrokeColor="@color/divider" app:chipStrokeWidth="@dimen/border_width_default" />
                <com.google.android.material.chip.Chip android:id="@+id/chipDolci" style="@style/Widget.Material3.Chip.Filter" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Dolci" android:checkable="true" app:chipBackgroundColor="@color/chip_background_selector" android:textColor="@color/chip_text_selector" app:checkedIconVisible="false" app:chipStrokeColor="@color/divider" app:chipStrokeWidth="@dimen/border_width_default" />
                <com.google.android.material.chip.Chip android:id="@+id/chipFastFood" style="@style/Widget.Material3.Chip.Filter" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Fast food" android:checkable="true" app:chipBackgroundColor="@color/chip_background_selector" android:textColor="@color/chip_text_selector" app:checkedIconVisible="false" app:chipStrokeColor="@color/divider" app:chipStrokeWidth="@dimen/border_width_default" />
                <com.google.android.material.chip.Chip android:id="@+id/chipAltro" style="@style/Widget.Material3.Chip.Filter" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Altro" android:checkable="true" app:chipBackgroundColor="@color/chip_background_selector" android:textColor="@color/chip_text_selector" app:checkedIconVisible="false" app:chipStrokeColor="@color/divider" app:chipStrokeWidth="@dimen/border_width_default" />
            </com.google.android.material.chip.ChipGroup>

            <com.google.android.material.textfield.TextInputLayout
                 style="@style/Widget.MyFitAI.InputCompact"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_12"
                android:hint="Descrivi cosa hai mangiato">
                <com.google.android.material.textfield.TextInputEditText
                 style="@style/Widget.MyFitAI.InputEditTextCompact"
                    android:id="@+id/descriptionInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textCapSentences"
                    android:maxLines="3" />
            </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/labelPhotoCard"
                style="@style/Widget.MyFitAI.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_12"
                >
                <LinearLayout style="@style/Widget.MyFitAI.HomeSectionContent" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                    <TextView style="@style/Text.MyFitAI.Section" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Etichetta nutrizionale (opzionale)" />
                    <TextView style="@style/Text.MyFitAI.Body" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_4" android:text="Aggiungi la foto solo se il prodotto ha un'etichetta: verrà usata dall'IA per rendere più precisa la stima e non sarà salvata." />
                    <com.google.android.material.button.MaterialButton android:id="@+id/addLabelPhotoButton" style="@style/Widget.MyFitAI.Button.Outlined" android:layout_width="match_parent" android:layout_height="@dimen/button_secondary_min_height" android:layout_marginTop="@dimen/space_10" android:text="+ Foto etichetta nutrizionale" android:textAllCaps="false" />
                    <LinearLayout android:id="@+id/labelPhotoStatusRow" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_8" android:gravity="center_vertical" android:visibility="gone">
                        <TextView android:id="@+id/labelPhotoStatus" style="@style/Text.MyFitAI.SettingsDescription" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Etichetta pronta ✓" android:textColor="@color/semantic_positive" android:textStyle="bold" />
                        <TextView android:id="@+id/removeLabelPhotoButton" style="@style/Text.MyFitAI.SettingsDescription" android:layout_width="wrap_content" android:layout_height="@dimen/screen_header_icon_size" android:gravity="center" android:paddingHorizontal="@dimen/space_10" android:text="Rimuovi" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/whenCard"
                style="@style/Widget.MyFitAI.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_12">
            <LinearLayout
                style="@style/Widget.MyFitAI.HomeSectionContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
            <com.myfitai.app.ui.widgets.SectionHeaderView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Quando?" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_8" android:orientation="horizontal">
                <LinearLayout android:id="@+id/dateField" android:layout_width="0dp" android:layout_weight="1" android:layout_height="@dimen/date_time_field_height" android:orientation="horizontal" android:gravity="center_vertical" android:background="@drawable/bg_input" android:padding="@dimen/space_12">
                    <ImageView android:layout_width="@dimen/inline_icon_size" android:layout_height="@dimen/inline_icon_size" android:src="@drawable/ic_calendar" android:importantForAccessibility="no" />
                    <TextView android:id="@+id/dateValue" style="@style/Text.MyFitAI.StatusLabel" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="@dimen/space_8" android:gravity="center_vertical" />
                </LinearLayout>
                <Space android:layout_width="@dimen/space_12" android:layout_height="1dp" />
                <LinearLayout android:id="@+id/timeField" android:layout_width="0dp" android:layout_weight="1" android:layout_height="@dimen/date_time_field_height" android:orientation="horizontal" android:gravity="center_vertical" android:background="@drawable/bg_input" android:padding="@dimen/space_12">
                    <ImageView android:layout_width="@dimen/inline_icon_size" android:layout_height="@dimen/inline_icon_size" android:src="@drawable/ic_setting_clock" android:importantForAccessibility="no" />
                    <TextView android:id="@+id/timeValue" style="@style/Text.MyFitAI.StatusLabel" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="@dimen/space_8" android:gravity="center_vertical" />
                </LinearLayout>
            </LinearLayout>
            </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/quantityCard"
                style="@style/Widget.MyFitAI.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_12">
                <LinearLayout
                    style="@style/Widget.MyFitAI.HomeSectionContent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <com.myfitai.app.ui.widgets.SectionHeaderView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Quantità" />
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/quantityLayout"
                        style="@style/Widget.MyFitAI.InputDropdownCompact"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_8">
                        <AutoCompleteTextView
                            style="@style/Widget.MyFitAI.InputDropdownTextCompact"
                            android:id="@+id/quantityInput"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="none" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/notesCard"
                style="@style/Widget.MyFitAI.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_12">
                <LinearLayout
                    style="@style/Widget.MyFitAI.HomeSectionContent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <com.myfitai.app.ui.widgets.SectionHeaderView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Note (opzionale)" />
                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.MyFitAI.InputReadableCompact"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_8"
                        android:hint="Es. con amici, fuori casa...">
                        <com.google.android.material.textfield.TextInputEditText
                            style="@style/Widget.MyFitAI.InputEditTextReadableCompact"
                            android:id="@+id/notesInput"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/multiline_notes_field_height"
                            android:gravity="top|start"
                            android:inputType="textMultiLine|textCapSentences"
                            android:maxLines="4" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

             <com.google.android.material.button.MaterialButton
                 android:id="@+id/analyzeButton"
                 style="@style/Widget.MyFitAI.Button.Primary"
                 android:layout_width="match_parent"
                 android:layout_height="@dimen/button_primary_min_height"
                 android:layout_marginTop="@dimen/space_12"
                 android:textColor="@color/white"
                 app:backgroundTint="@color/accent_green_dark"
                 android:text="Fai capire lo sgarro all'IA"
                android:textAllCaps="false"
                android:textStyle="bold" />

            <ProgressBar android:id="@+id/progress" android:layout_width="@dimen/progress_indicator_size" android:layout_height="@dimen/progress_indicator_size" android:layout_gravity="center_horizontal" android:layout_marginTop="@dimen/space_12" android:visibility="gone" />
            <TextView android:id="@+id/statusText" style="@style/Text.MyFitAI.BodyCompact" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_8" android:gravity="center" android:visibility="gone" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/aiUnderstandingCard"
                style="@style/Widget.MyFitAI.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_16"
                android:visibility="gone"
                >
                <LinearLayout style="@style/Widget.MyFitAI.HomeSectionContent" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                    <TextView style="@style/Text.MyFitAI.Section" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Cosa ha capito l'IA" />
                    <TextView style="@style/Text.MyFitAI.Body" android:id="@+id/aiUnderstoodFood" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_8" />
                    <TextView style="@style/Text.MyFitAI.SettingsLabel" android:id="@+id/aiEstimate" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_10" />
                    <TextView style="@style/Text.MyFitAI.SettingsDescription" android:id="@+id/aiEstimateNotes" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_6" />
                     <TextView style="@style/Text.MyFitAI.SettingsDescription" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_16" android:text="Non ha capito bene? Spiega meglio e fai rivalutare prima di confermare." />
                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.MyFitAI.InputReadableCompact"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                         android:layout_marginTop="@dimen/space_8"
                        android:hint="Es. ne ho mangiati 80 g, non tutta la confezione...">
                        <com.google.android.material.textfield.TextInputEditText
                style="@style/Widget.MyFitAI.InputEditTextReadableCompact"
                            android:id="@+id/clarificationInput"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/cheat_clarification_field_height"
                            android:gravity="top|start"
                            android:inputType="textMultiLine|textCapSentences"
                            android:maxLines="4" />
                    </com.google.android.material.textfield.TextInputLayout>
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/reevaluateButton"
                        style="@style/Widget.MyFitAI.Button.Outlined"
                        android:layout_width="match_parent"
                          android:layout_height="@dimen/button_secondary_min_height"
                         android:layout_marginTop="@dimen/space_10"
                        android:text="Rivaluta con la mia spiegazione"
                        android:textAllCaps="false" />
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/confirmButton"
                        android:layout_width="match_parent"
                          android:layout_height="@dimen/button_primary_min_height"
                         android:layout_marginTop="@dimen/space_10"
                        android:text="Ha capito · Conferma e salva"
                        android:textAllCaps="false"
                        android:textStyle="bold"
                         style="@style/Widget.MyFitAI.Button.Primary" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
