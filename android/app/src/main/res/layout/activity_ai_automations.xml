<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_primary"
    android:orientation="vertical">

    <ScrollView
        android:id="@+id/aiAutomationsScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/aiAutomationsContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/space_16"
            android:paddingTop="@dimen/space_8"
            android:paddingBottom="@dimen/space_24">

            <LinearLayout style="@style/Widget.MyFitAI.ScreenHeader">
                <ImageButton
                    android:id="@+id/backButton"
                    android:layout_width="@dimen/icon_button_size"
                    android:layout_height="@dimen/icon_button_size"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Indietro"
                    android:padding="@dimen/space_8"
                    android:src="@drawable/ic_arrow_back"
                    app:tint="@color/text_primary" />
                <TextView
                    android:id="@+id/title"
                    style="@style/Text.MyFitAI.ScreenTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="@string/ai_automations_title" />
                <Space
                    android:layout_width="@dimen/icon_button_size"
                    android:layout_height="@dimen/layout_geometry_shim_thickness" />
            </LinearLayout>

            <TextView
                android:id="@+id/aiAutomationsScope"
                style="@style/Text.MyFitAI.SettingsDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_8"
                android:background="@drawable/bg_panel_tonal"
                android:padding="@dimen/space_12"
                android:text="@string/ai_automations_scope_unnamed" />

            <LinearLayout
                android:id="@+id/aiAutomationsProviderBanner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_12"
                android:background="@drawable/bg_panel_tonal"
                android:orientation="vertical"
                android:padding="@dimen/space_12"
                android:visibility="gone">
                <TextView
                    style="@style/Text.MyFitAI.SettingsDescription"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/ai_automations_provider_missing" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/openAiSettingsButton"
                    style="@style/Widget.MyFitAI.SettingsButton.Outlined"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/button_secondary_min_height"
                    android:layout_marginTop="@dimen/space_8"
                    android:text="@string/ai_automations_open_ai_settings"
                    android:textAllCaps="false" />
            </LinearLayout>

            <TextView
                android:id="@+id/aiAutomationsNoProfile"
                style="@style/Text.MyFitAI.BodyCompact"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_12"
                android:text="@string/ai_automations_no_profile"
                android:visibility="gone" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/aiAutomationsCard"
                style="@style/Widget.MyFitAI.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_12">
                <LinearLayout
                    android:id="@+id/aiAutomationsSection"
                    style="@style/Widget.MyFitAI.WhiteCardContent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
