<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@color/bg_primary">
<ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
<LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:gravity="center_vertical"><TextView android:id="@+id/backButton" android:layout_width="40dp" android:layout_height="40dp" android:gravity="center" android:text="‹" android:textSize="30sp" android:textColor="@color/text_primary"/><TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="Misure corporee" android:textStyle="bold" android:textSize="20sp" android:textColor="@color/text_primary"/><Space android:layout_width="40dp" android:layout_height="40dp"/></LinearLayout>
<LinearLayout android:layout_width="match_parent" android:layout_height="44dp" android:background="@drawable/bg_card_soft" android:padding="4dp"><TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:background="@drawable/bg_positive" android:text="Misura" android:textColor="@color/text_primary"/><TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="Storico" android:textColor="@color/text_secondary"/></LinearLayout>
<LinearLayout android:layout_width="match_parent" android:layout_height="290dp" android:gravity="center" android:orientation="horizontal" android:layout_marginTop="12dp"><ImageView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:src="@drawable/body_front" android:contentDescription="Corpo fronte"/><ImageView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:src="@drawable/body_back" android:contentDescription="Corpo retro"/></LinearLayout>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Punti di misura: Torace • Braccio • Vita • Addome • Coscia • Spalle • Glutei • Polpaccio" android:textColor="@color/text_secondary" android:textSize="12sp" android:gravity="center"/>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:text="Valori attuali (cm)                                      14/09/2026" android:textStyle="bold" android:textColor="@color/text_primary"/>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:padding="14dp" android:background="@drawable/bg_card" android:text="Torace                         102\nVita                              84\nAddome                         88\nBraccio sx                     36\nBraccio dx                     35\nCoscia sx                       58\nCoscia dx                       57\nPolpaccio sx                  37\nPolpaccio dx                  37" android:lineSpacingExtra="10dp" android:textColor="@color/text_primary"/>
