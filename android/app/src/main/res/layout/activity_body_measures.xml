<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_primary">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/space_16">

            <LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:gravity="center_vertical">
                <TextView android:id="@+id/backButton" android:layout_width="40dp" android:layout_height="40dp" android:gravity="center" android:text="‹" android:textSize="30sp" android:textColor="@color/text_primary" />
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="Misure corporee" android:textStyle="bold" android:textSize="20sp" android:textColor="@color/text_primary" />
                <Space android:layout_width="40dp" android:layout_height="40dp" />
            </LinearLayout>

            <com.myfitai.app.ui.widgets.SelectableSegmentView
                android:id="@+id/measureSegment"
                android:layout_width="match_parent"
                android:layout_height="44dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="290dp"
                android:layout_marginTop="@dimen/space_12"
                android:orientation="horizontal">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="match_parent">
                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="fitCenter"
                        android:src="@drawable/img_body_front"
                        android:contentDescription="Corpo fronte"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent" />
                    <LinearLayout android:id="@+id/markerChest" style="@style/Widget.MyFitAI.BodyMarker" app:layout_constraintHorizontal_bias="0.62" app:layout_constraintVertical_bias="0.16" app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent">
                        <View style="@style/Widget.MyFitAI.BodyMarkerDot" />
                        <TextView style="@style/Widget.MyFitAI.BodyMarkerLabel" android:text="Torace" />
                    </LinearLayout>
                    <LinearLayout android:id="@+id/markerArm" style="@style/Widget.MyFitAI.BodyMarker" app:layout_constraintHorizontal_bias="0.18" app:layout_constraintVertical_bias="0.30" app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent">
                        <View style="@style/Widget.MyFitAI.BodyMarkerDot" />
                        <TextView style="@style/Widget.MyFitAI.BodyMarkerLabel" android:text="Braccio" />
                    </LinearLayout>
                    <LinearLayout android:id="@+id/markerWaist" style="@style/Widget.MyFitAI.BodyMarker" app:layout_constraintHorizontal_bias="0.22" app:layout_constraintVertical_bias="0.50" app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent">
                        <View style="@style/Widget.MyFitAI.BodyMarkerDot" />
                        <TextView style="@style/Widget.MyFitAI.BodyMarkerLabel" android:text="Vita" />
                    </LinearLayout>
                    <LinearLayout android:id="@+id/markerThigh" style="@style/Widget.MyFitAI.BodyMarker" app:layout_constraintHorizontal_bias="0.30" app:layout_constraintVertical_bias="0.72" app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent">
                        <View style="@style/Widget.MyFitAI.BodyMarkerDot" />
                        <TextView style="@style/Widget.MyFitAI.BodyMarkerLabel" android:text="Coscia" />
                    </LinearLayout>
                </androidx.constraintlayout.widget.ConstraintLayout>

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="match_parent">
                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="fitCenter"
                        android:src="@drawable/img_body_back"
                        android:contentDescription="Corpo retro"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent" />
                    <LinearLayout android:id="@+id/markerShoulders" style="@style/Widget.MyFitAI.BodyMarker" app:layout_constraintHorizontal_bias="0.78" app:layout_constraintVertical_bias="0.14" app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent">
                        <View style="@style/Widget.MyFitAI.BodyMarkerDot" />
                        <TextView style="@style/Widget.MyFitAI.BodyMarkerLabel" android:text="Spalle" />
                    </LinearLayout>
                    <LinearLayout android:id="@+id/markerAbdomen" style="@style/Widget.MyFitAI.BodyMarker" app:layout_constraintHorizontal_bias="0.68" app:layout_constraintVertical_bias="0.42" app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent">
                        <View style="@style/Widget.MyFitAI.BodyMarkerDot" />
                        <TextView style="@style/Widget.MyFitAI.BodyMarkerLabel" android:text="Addome" />
                    </LinearLayout>
                    <LinearLayout android:id="@+id/markerGlutes" style="@style/Widget.MyFitAI.BodyMarker" app:layout_constraintHorizontal_bias="0.62" app:layout_constraintVertical_bias="0.58" app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent">
                        <View style="@style/Widget.MyFitAI.BodyMarkerDot" />
                        <TextView style="@style/Widget.MyFitAI.BodyMarkerLabel" android:text="Glutei" />
                    </LinearLayout>
                    <LinearLayout android:id="@+id/markerCalf" style="@style/Widget.MyFitAI.BodyMarker" app:layout_constraintHorizontal_bias="0.70" app:layout_constraintVertical_bias="0.80" app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent">
                        <View style="@style/Widget.MyFitAI.BodyMarkerDot" />
                        <TextView style="@style/Widget.MyFitAI.BodyMarkerLabel" android:text="Polpaccio" />
                    </LinearLayout>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </LinearLayout>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_16" android:orientation="horizontal">
                <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="Valori attuali (cm)" android:textStyle="bold" android:textColor="@color/text_primary" android:textSize="15sp" />
                <TextView android:id="@+id/measureDate" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="14/09/2026" android:textColor="@color/text_secondary" android:textSize="13sp" />
            </LinearLayout>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_8" android:background="@drawable/bg_card" android:orientation="vertical" android:paddingHorizontal="@dimen/space_16">
                <com.myfitai.app.ui.widgets.MeasurementRowView android:id="@+id/rowChest" android:layout_width="match_parent" android:layout_height="wrap_content" />
                <com.myfitai.app.ui.widgets.MeasurementRowView android:id="@+id/rowWaist" android:layout_width="match_parent" android:layout_height="wrap_content" />
                <com.myfitai.app.ui.widgets.MeasurementRowView android:id="@+id/rowAbdomen" android:layout_width="match_parent" android:layout_height="wrap_content" />
                <com.myfitai.app.ui.widgets.MeasurementRowView android:id="@+id/rowArmLeft" android:layout_width="match_parent" android:layout_height="wrap_content" />
                <com.myfitai.app.ui.widgets.MeasurementRowView android:id="@+id/rowArmRight" android:layout_width="match_parent" android:layout_height="wrap_content" />
                <com.myfitai.app.ui.widgets.MeasurementRowView android:id="@+id/rowThighLeft" android:layout_width="match_parent" android:layout_height="wrap_content" />
                <com.myfitai.app.ui.widgets.MeasurementRowView android:id="@+id/rowThighRight" android:layout_width="match_parent" android:layout_height="wrap_content" />
                <com.myfitai.app.ui.widgets.MeasurementRowView android:id="@+id/rowCalfLeft" android:layout_width="match_parent" android:layout_height="wrap_content" />
                <com.myfitai.app.ui.widgets.MeasurementRowView android:id="@+id/rowCalfRight" android:layout_width="match_parent" android:layout_height="wrap_content" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/saveButton"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="@dimen/space_16"
                android:text="+  Nuova misurazione"
                android:textAllCaps="false"
                android:textStyle="bold"
                app:cornerRadius="12dp"
                app:backgroundTint="@color/accent_green" />
        </LinearLayout>
    </ScrollView>
    <include layout="@layout/view_bottom_navigation" />
</LinearLayout>