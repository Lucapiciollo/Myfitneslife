<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_primary">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/space_16"
            android:paddingTop="@dimen/space_8"
            android:paddingBottom="@dimen/space_24">

            <LinearLayout style="@style/Widget.MyFitAI.ScreenHeader"
                android:layout_width="match_parent"
                android:layout_height="@dimen/screen_header_height"
                android:gravity="center_vertical">
                <TextView
                    android:id="@+id/backButton"
                    android:layout_width="@dimen/icon_button_size"
                    android:layout_height="@dimen/icon_button_size"
                    android:gravity="center"
                     android:background="?attr/selectableItemBackgroundBorderless"
                     android:contentDescription="Indietro"
                     android:padding="@dimen/space_8"
                     android:src="@drawable/ic_arrow_back"
                     app:tint="@color/text_primary" />
                <TextView
                    android:id="@+id/resultTitle"
                    style="@style/Text.MyFitAI.ScreenTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="Piano aggiornato" />
                <Space
                    android:layout_width="@dimen/icon_button_size"
                    android:layout_height="1dp" />
            </LinearLayout>

             <com.google.android.material.card.MaterialCardView
                style="@style/Widget.MyFitAI.Card"
                 android:layout_width="match_parent"
                 android:layout_height="wrap_content"
                   android:layout_marginTop="@dimen/space_12"
                 app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="@dimen/radius_card"
                app:cardElevation="@dimen/elevation_card"
                app:strokeColor="@color/divider"
                app:strokeWidth="@dimen/border_width_default">
                <LinearLayout style="@style/Widget.MyFitAI.HomeSectionContent" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                    <TextView
                        android:id="@+id/resultDescription"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        style="@style/Text.MyFitAI.BodyEmphasis" />
                    <TextView
                        android:id="@+id/resultSummary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_12"
                        android:padding="@dimen/space_16"
                         android:background="@color/surface_primary"
                        style="@style/Text.MyFitAI.Body" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

             <com.google.android.material.card.MaterialCardView
                 android:id="@+id/modifiedMealsCard"
                style="@style/Widget.MyFitAI.Card"
                android:layout_width="match_parent"
                 android:layout_height="wrap_content"
                 android:layout_marginTop="@dimen/space_12"
                 android:visibility="gone"
                 app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="@dimen/radius_card"
                app:cardElevation="@dimen/elevation_card"
                app:strokeColor="@color/divider"
                app:strokeWidth="@dimen/border_width_default">
                <LinearLayout style="@style/Widget.MyFitAI.HomeSectionContent" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                    <TextView
                        android:id="@+id/modifiedHeader"
                        style="@style/Text.MyFitAI.Section"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Pasti futuri aggiornati" />
                    <LinearLayout
                        android:id="@+id/modifiedMealsContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_8"
                        android:orientation="vertical" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                  android:layout_height="wrap_content"
                  android:layout_marginTop="@dimen/space_12"
                  android:visibility="gone"
                  app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="@dimen/radius_card"
                app:cardElevation="@dimen/elevation_card"
                app:strokeColor="@color/divider"
                app:strokeWidth="@dimen/border_width_default">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="@dimen/space_16"
                    android:text="Le modifiche riguardano solo i pasti successivi allo sgarro nella stessa giornata. I pasti passati e i giorni successivi restano invariati; se il bilanciamento richiederebbe restrizioni eccessive, l'app registra lo sgarro senza compensarlo."
                     style="@style/Text.MyFitAI.Body" />
            </com.google.android.material.card.MaterialCardView>

             <com.google.android.material.button.MaterialButton
                 android:id="@+id/okButton"
                 style="@style/Widget.MyFitAI.Button.Primary"
                android:layout_width="match_parent"
                 android:layout_height="@dimen/button_primary_min_height"
                 android:layout_marginTop="@dimen/space_16"
                android:gravity="center"
                 android:text="Vedi piano"
                android:textAllCaps="false" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
