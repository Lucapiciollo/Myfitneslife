<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_primary">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/screen_header_height"
        android:gravity="center_vertical"
        android:background="@drawable/bg_screen_header"
        android:paddingHorizontal="@dimen/space_8">
        <ImageButton
            android:id="@+id/backButton"
            android:layout_width="@dimen/icon_button_size"
            android:layout_height="@dimen/icon_button_size"
            android:background="@android:color/transparent"
            android:contentDescription="Indietro"
            android:padding="@dimen/space_8"
            android:src="@drawable/ic_arrow_back" />
        <TextView
            style="@style/Text.MyFitAI.ScreenTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Preferenze alimentari" />
        <Space android:layout_width="@dimen/icon_button_size" android:layout_height="@dimen/icon_button_size" />
    </LinearLayout>
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:paddingBottom="@dimen/space_24">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/space_16">
            <LinearLayout
                android:id="@+id/dietaryUnreadableBanner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_12"
                android:background="@drawable/bg_error_soft"
                android:orientation="vertical"
                android:padding="@dimen/card_content_padding_compact"
                android:visibility="gone">
                <TextView
                    android:id="@+id/dietaryUnreadableTitle"
                    style="@style/Text.MyFitAI.BodyEmphasis"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:accessibilityHeading="true"
                    android:accessibilityLiveRegion="assertive"
                    android:focusable="true"
                    android:text="@string/dietary_unreadable_title"
                    android:textColor="@color/text_primary"
                    tools:targetApi="p" />
                <TextView
                    android:id="@+id/dietaryUnreadableRawLabel"
                    style="@style/Text.MyFitAI.Supporting"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_8"
                    android:text="@string/dietary_unreadable_raw_label"
                    android:textColor="@color/text_primary" />
                <TextView
                    android:id="@+id/dietaryUnreadableRaw"
                    style="@style/Text.MyFitAI.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_4"
                    android:background="@drawable/bg_panel_tonal"
                    android:focusable="true"
                    android:minHeight="@dimen/control_min_height"
                    android:padding="@dimen/card_content_padding_compact"
                    android:textColor="@color/text_primary"
                    android:textIsSelectable="true" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/dietaryUnreadableCopyButton"
                    style="@style/Widget.MyFitAI.Button.Outlined"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_8"
                    android:contentDescription="@string/dietary_unreadable_copy_description"
                    android:minHeight="@dimen/control_min_height"
                    android:text="@string/dietary_unreadable_copy" />
                <TextView
                    android:id="@+id/dietaryUnreadableFix"
                    style="@style/Text.MyFitAI.Supporting"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_8"
                    android:text="@string/dietary_unreadable_fix"
                    android:textColor="@color/text_primary" />
            </LinearLayout>
             <com.google.android.material.card.MaterialCardView
                 style="@style/Widget.MyFitAI.FormCard"
                 app:cardBackgroundColor="@color/surface_primary"
                 android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_12">
                <LinearLayout
                    style="@style/Widget.MyFitAI.WhiteCardContent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <TextView style="@style/Text.MyFitAI.Section" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Preferenze e vincoli" />
                    <TextView style="@style/Text.MyFitAI.SettingsDescription" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_4" android:background="@drawable/bg_panel_tonal" android:padding="@dimen/card_content_padding_compact" android:text="@string/dietary_intro" />
                    <TextView android:id="@+id/dietaryLoadError" style="@style/Text.MyFitAI.Body" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_8" android:background="@drawable/bg_error_soft" android:padding="@dimen/card_content_padding_compact" android:accessibilityLiveRegion="assertive" android:textColor="@color/text_primary" android:visibility="gone" />
                    <LinearLayout android:id="@+id/dietaryCategoriesContainer" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_12" android:orientation="vertical" />
                    <com.google.android.material.textfield.TextInputLayout style="@style/Widget.MyFitAI.InputDropdownCompact" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_8" android:hint="Stile alimentare">
                        <com.google.android.material.textfield.MaterialAutoCompleteTextView android:id="@+id/dietStyleInput" style="@style/Widget.MyFitAI.InputDropdownTextCompact" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="none" />
                    </com.google.android.material.textfield.TextInputLayout>
                    <TextView android:id="@+id/dietStyleNotice" style="@style/Text.MyFitAI.Supporting" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_4" android:background="@drawable/bg_panel_tonal" android:padding="@dimen/card_content_padding_compact" android:textColor="@color/text_primary" android:visibility="gone" />
                    <com.google.android.material.textfield.TextInputLayout style="@style/Widget.MyFitAI.InputCompact" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_8" android:hint="Note alimentari" app:helperTextEnabled="true" app:helperText="@string/dietary_notes_helper">
                        <com.google.android.material.textfield.TextInputEditText android:id="@+id/preferencesInput" style="@style/Widget.MyFitAI.InputEditTextCompact" android:layout_width="match_parent" android:layout_height="@dimen/multiline_notes_field_height" android:gravity="top|start" android:inputType="textMultiLine|textCapSentences" android:minLines="3" android:maxLines="6" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <TextView android:id="@+id/dietarySaveError" style="@style/Text.MyFitAI.Body" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_12" android:background="@drawable/bg_error_soft" android:padding="@dimen/card_content_padding_compact" android:accessibilityLiveRegion="assertive" android:textColor="@color/text_primary" android:visibility="gone" />
            <com.google.android.material.button.MaterialButton android:id="@+id/saveDietaryPreferencesButton" style="@style/Widget.MyFitAI.Button.Primary" android:layout_width="match_parent" android:layout_height="@dimen/button_primary_min_height" android:layout_marginTop="@dimen/space_16" android:text="Salva preferenze" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
