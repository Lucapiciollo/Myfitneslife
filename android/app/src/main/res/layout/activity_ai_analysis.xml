<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@color/bg_primary">
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:gravity="center_vertical">
                <TextView android:id="@+id/backButton" android:layout_width="40dp" android:layout_height="40dp" android:gravity="center" android:text="‹" android:textSize="30sp" android:textColor="@color/text_primary" />
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="Analisi andamento" android:textColor="@color/text_primary" android:textStyle="bold" android:textSize="17sp" />
                <Space android:layout_width="40dp" android:layout_height="1dp" />
            </LinearLayout>
            <com.myfitai.app.ui.widgets.SelectableSegmentView android:id="@+id/analysisRangeSegment" android:layout_width="match_parent" android:layout_height="44dp" />
            <TextView style="@style/Text.MyFitAI.Section" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="Sintesi del periodo" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:padding="14dp" android:orientation="vertical" android:background="@drawable/bg_positive_soft">
                <TextView android:id="@+id/analysisSummaryTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Caricamento…" android:textColor="@color/text_primary" android:textStyle="bold" />
                <TextView android:id="@+id/analysisSummaryText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="" android:textColor="@color/text_secondary" />
            </LinearLayout>
            <TextView style="@style/Text.MyFitAI.Section" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:text="Pattern osservati" />
            <TextView android:id="@+id/analysisPatternsText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Nessun pattern disponibile." android:textColor="@color/text_primary" android:lineSpacingExtra="6dp" />
            <TextView style="@style/Text.MyFitAI.Section" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:text="Interpretazione" />
            <TextView android:id="@+id/analysisCautionText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Le associazioni osservate non dimostrano causalità e non sostituiscono una valutazione sanitaria." android:textColor="@color/text_secondary" />
            <TextView android:id="@+id/deepenButton" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="20dp" android:gravity="center" android:background="@drawable/bg_button_green" android:text="Apri review settimanale" android:textColor="@color/bg_primary" android:textStyle="bold" android:textSize="15sp" />
        </LinearLayout>
    </ScrollView>
    <include layout="@layout/view_bottom_navigation" />
</LinearLayout>
