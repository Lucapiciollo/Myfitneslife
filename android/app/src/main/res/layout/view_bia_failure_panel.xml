<?xml version="1.0" encoding="utf-8"?>
<!-- Errore IA persistente in scheda (non Toast): frase della tabella centrale, azioni solo se applicabili, dettagli espandibili. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/space_8"
    android:background="@drawable/bg_error_soft"
    android:orientation="vertical"
    android:padding="@dimen/space_12"
    android:visibility="gone">

    <TextView
        android:id="@+id/biaFailureMessage"
        style="@style/Text.MyFitAI.Body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:accessibilityLiveRegion="polite" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/biaFailureRetry"
        style="@style/Widget.MyFitAI.Button.Outlined"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_8"
        android:minHeight="@dimen/control_min_height"
        android:text="@string/ai_failure_retry"
        android:textAllCaps="false" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/biaFailureSettings"
        style="@style/Widget.MyFitAI.Button.Text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/control_min_height"
        android:text="@string/ai_failure_action_open_settings"
        android:textAllCaps="false" />

    <TextView
        android:id="@+id/biaFailureDetails"
        style="@style/Text.MyFitAI.Micro"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/biaFailureDetailsToggle"
        style="@style/Widget.MyFitAI.Button.Text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/control_min_height"
        android:text="@string/ai_failure_details"
        android:textAllCaps="false" />
</LinearLayout>
