<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_primary">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingBottom="@dimen/space_24">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/space_16"
            android:paddingTop="@dimen/space_8">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/screen_header_height"
                android:background="@drawable/bg_screen_header"
                android:gravity="center_vertical"
                android:paddingHorizontal="@dimen/space_8">
                <ImageButton
                    android:id="@+id/backButton"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Indietro"
                    android:padding="8dp"
                    android:src="@drawable/ic_arrow_back"
                    app:tint="@color/text_primary" />
                <TextView
                    style="@style/Text.MyFitAI.ScreenTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="Evoluzione fisica" />
                <Space android:layout_width="40dp" android:layout_height="1dp" />
            </LinearLayout>

            <com.myfitai.app.ui.widgets.SelectableSegmentView
                android:id="@+id/metricSegment"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="@dimen/space_12" />

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.MyFitAI.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_12">
                <LinearLayout
                    style="@style/Widget.MyFitAI.WhiteCardContent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">
                        <TextView
                            android:id="@+id/metricLabel"
                            style="@style/Text.MyFitAI.Section"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Peso" />
                        <ImageButton
                            android:id="@+id/progressMetricHelpButton"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:background="@android:color/transparent"
                            android:contentDescription="Spiega il progresso"
                            android:padding="8dp"
                            android:src="@drawable/ic_help_outline"
                            app:tint="@color/text_secondary" />
                    </LinearLayout>
                    <TextView
                        android:id="@+id/metricValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_4"
                        android:text="—"
                        android:textColor="@color/metric_value"
                        android:textSize="32sp"
                        android:textStyle="bold" />
                    <TextView
                        android:id="@+id/metricDelta"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_2"
                        android:text="Dati insufficienti"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp" />
                    <com.myfitai.app.ui.widgets.WeightTrendChartView
                        android:id="@+id/evolutionChart"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/dashboard_chart_height"
                        android:layout_marginTop="@dimen/space_16" />
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_4"
                        android:text="Il grafico mostra le rilevazioni disponibili nel periodo selezionato."
                        android:textColor="@color/text_muted"
                        android:textSize="11sp" />
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">
                        <TextView android:id="@+id/dateLabel1" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="start" android:text="—" android:textColor="@color/text_muted" android:textSize="11sp" />
                        <TextView android:id="@+id/dateLabel2" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="—" android:textColor="@color/text_muted" android:textSize="11sp" />
                        <TextView android:id="@+id/dateLabel3" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="—" android:textColor="@color/text_muted" android:textSize="11sp" />
                        <TextView android:id="@+id/dateLabel4" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="—" android:textColor="@color/text_muted" android:textSize="11sp" />
                        <TextView android:id="@+id/dateLabel5" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="end" android:text="—" android:textColor="@color/text_muted" android:textSize="11sp" />
                    </LinearLayout>
                    <com.myfitai.app.ui.widgets.TimeRangeSelectorView
                        android:id="@+id/timeRangeSelector"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/dashboard_pill_height"
                        android:layout_marginTop="@dimen/space_12" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.MyFitAI.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_12">
                <LinearLayout
                    style="@style/Widget.MyFitAI.WhiteCardContent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <LinearLayout
                        android:id="@+id/otherIndicatorsHeader"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">
                        <com.myfitai.app.ui.widgets.SectionHeaderView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Altri indicatori corporei" />
                        <ImageButton
                            android:id="@+id/otherIndicatorsHelpButton"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:background="@android:color/transparent"
                            android:contentDescription="Spiega altri indicatori"
                            android:padding="8dp"
                            android:src="@drawable/ic_help_outline"
                            app:tint="@color/text_secondary" />
                    </LinearLayout>
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:paddingVertical="@dimen/space_6">
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Grasso corporeo" android:textColor="@color/text_secondary" android:textSize="13sp" android:textStyle="bold" />
                            <TextView android:id="@+id/otherIndicatorFatDelta" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_2" android:text="—" android:textColor="@color/text_muted" android:textSize="11sp" />
                        </LinearLayout>
                        <TextView android:id="@+id/otherIndicatorFatValue" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="—" android:textColor="@color/metric_value" android:textSize="16sp" android:textStyle="bold" />
                    </LinearLayout>
                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/divider" />
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:paddingVertical="@dimen/space_6">
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Massa muscolare" android:textColor="@color/text_secondary" android:textSize="13sp" android:textStyle="bold" />
                            <TextView android:id="@+id/otherIndicatorMuscleDelta" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_2" android:text="—" android:textColor="@color/text_muted" android:textSize="11sp" />
                        </LinearLayout>
                        <TextView android:id="@+id/otherIndicatorMuscleValue" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="—" android:textColor="@color/metric_value" android:textSize="16sp" android:textStyle="bold" />
                    </LinearLayout>
                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/divider" />
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:paddingVertical="@dimen/space_6">
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Acqua corporea" android:textColor="@color/text_secondary" android:textSize="13sp" android:textStyle="bold" />
                            <TextView android:id="@+id/otherIndicatorWaterDelta" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_2" android:text="—" android:textColor="@color/text_muted" android:textSize="11sp" />
                        </LinearLayout>
                        <TextView android:id="@+id/otherIndicatorWaterValue" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="—" android:textColor="@color/metric_value" android:textSize="16sp" android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:id="@+id/visualComparisonSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone" />

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.MyFitAI.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_12">
                <LinearLayout
                    style="@style/Widget.MyFitAI.WhiteCardContent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@color/surface_primary"
                    android:orientation="vertical">
                    <TextView android:id="@+id/progressSummaryTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Affidabilità dell’andamento" android:textColor="@color/text_primary" android:textStyle="bold" />
                    <TextView android:id="@+id/progressSummaryText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_4" android:text="I dati mostrati derivano dallo storico reale." android:textColor="@color/text_secondary" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:id="@+id/dynamicProgressCards"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>
    </ScrollView>
    <include layout="@layout/view_bottom_navigation" />
</LinearLayout>
