<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_primary">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
             android:paddingHorizontal="@dimen/space_16"
             android:paddingTop="@dimen/space_8"
             android:paddingBottom="@dimen/space_24">

             <LinearLayout
                 android:layout_width="match_parent"
                  android:layout_height="@dimen/screen_header_height"
                 android:gravity="center_vertical"
                     android:background="@drawable/bg_screen_header"
                  android:paddingHorizontal="@dimen/space_8">
                 <ImageButton
                     android:id="@+id/backButton"
                    android:layout_width="@dimen/icon_button_size"
                     android:layout_height="@dimen/icon_button_size"
                      android:background="?attr/selectableItemBackgroundBorderless"
                     android:contentDescription="Indietro"
                     android:padding="@dimen/space_8"
                     android:src="@drawable/ic_arrow_back"
                     app:tint="@color/text_primary" />
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="Rilevazioni"
                    android:textColor="@color/text_primary"
                     style="@style/Text.MyFitAI.ScreenTitle" />
                 <View android:layout_width="@dimen/icon_button_size" android:layout_height="1dp" />
            </LinearLayout>

                 <TextView
                     android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_12"
                android:text="Registra e gestisci i dati corporei che alimentano i tuoi progressi."
                android:textColor="@color/text_secondary"
                 style="@style/Text.MyFitAI.Body" />

             <LinearLayout
                 android:layout_width="match_parent"
                 android:layout_height="wrap_content"
                 android:layout_marginTop="@dimen/space_8"
                 android:orientation="vertical">

              <com.myfitai.app.ui.widgets.MeasurementActionCardView
                  android:id="@+id/biaCard"
                  android:layout_width="match_parent"
                  android:layout_height="wrap_content" />

              <com.myfitai.app.ui.widgets.MeasurementActionCardView
                  android:id="@+id/bodyCard"
                  android:layout_width="match_parent"
                  android:layout_height="wrap_content"
                  android:layout_marginTop="@dimen/space_8" />
             </LinearLayout>

              <com.google.android.material.card.MaterialCardView android:id="@+id/dietImpactCard" style="@style/Widget.MyFitAI.Card" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_12" android:layout_marginBottom="@dimen/space_16">
                <LinearLayout style="@style/Widget.MyFitAI.HomeSectionContent" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                <com.myfitai.app.ui.widgets.SectionHeaderView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Impatto sul piano alimentare" />
                 <LinearLayout android:id="@+id/dietImpactRows" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />
                 <TextView android:id="@+id/dietTargetReasonText" style="@style/Text.MyFitAI.Caption" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_10" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/allHistoryButton"
                style="@style/Widget.MyFitAI.Button.Outlined"
                android:layout_width="match_parent"
                android:layout_height="@dimen/button_secondary_min_height"
                android:layout_marginTop="@dimen/space_24"
                android:text="Apri storico completo"
                android:textAllCaps="false" />
        </LinearLayout>
    </ScrollView>
    <include layout="@layout/view_bottom_navigation" />
</LinearLayout>
