<resources>
<style name="Theme.MyFitAI" parent="Theme.Material3.Light.NoActionBar">
    <item name="android:fontFamily">sans</item><item name="android:windowLightStatusBar">true</item>
    <item name="android:statusBarColor">@color/bg_primary</item><item name="android:navigationBarColor">@color/bg_primary</item>
    <item name="colorPrimary">@color/accent_green</item><item name="colorOnPrimary">@color/bg_primary</item>
    <item name="colorSurface">@color/surface_primary</item><item name="colorOnSurface">@color/text_primary</item>
    <item name="materialAlertDialogTheme">@style/ThemeOverlay.MyFitAI.AlertDialog</item>
    <item name="android:windowBackground">@color/bg_primary</item>
</style>
<style name="ThemeOverlay.MyFitAI.AlertDialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
    <item name="android:windowBackground">@color/white</item>
    <item name="android:colorBackground">@color/white</item>
    <item name="android:windowElevation">8dp</item>
    <item name="android:windowMinWidthMajor">88%</item>
    <item name="android:windowMinWidthMinor">92%</item>
    <item name="android:textColorPrimary">@color/text_primary</item>
    <item name="android:textColorSecondary">@color/text_secondary</item>
    <item name="colorPrimary">@color/accent_green_dark</item>
    <item name="colorOnPrimary">@color/white</item>
    <item name="colorSurface">@color/white</item>
    <item name="colorOnSurface">@color/text_primary</item>
    <item name="shapeAppearanceOverlay">@style/ShapeAppearanceOverlay.MyFitAI.AlertDialog</item>
</style>
<style name="ShapeAppearanceOverlay.MyFitAI.AlertDialog" parent="">
    <item name="cornerSize">24dp</item>
</style>
<style name="Text.MyFitAI.ScreenTitle" parent="TextAppearance.Material3.HeadlineSmall"><item name="android:textColor">@color/text_primary</item><item name="android:textStyle">bold</item></style>
<style name="Text.MyFitAI.Section" parent="TextAppearance.Material3.TitleMedium"><item name="android:textColor">@color/text_primary</item><item name="android:textStyle">bold</item></style>
<style name="Text.MyFitAI.Body" parent="TextAppearance.Material3.BodyMedium"><item name="android:textColor">@color/text_secondary</item></style>
<style name="Text.MyFitAI.Caption" parent="TextAppearance.Material3.BodySmall"><item name="android:textColor">@color/text_muted</item></style>
<style name="Widget.MyFitAI.Card" parent="Widget.Material3.CardView.Filled"><item name="cardBackgroundColor">@color/surface_primary</item><item name="cardCornerRadius">@dimen/radius_medium</item><item name="cardElevation">0dp</item></style>
<style name="Widget.MyFitAI.Button.Primary" parent="Widget.Material3.Button"><item name="backgroundTint">@color/accent_green</item><item name="cornerRadius">@dimen/radius_medium</item><item name="android:textColor">@color/white</item><item name="android:textStyle">bold</item><item name="android:textAllCaps">false</item></style>
<style name="Widget.MyFitAI.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton"><item name="strokeColor">@color/white</item><item name="cornerRadius">@dimen/radius_medium</item><item name="android:textColor">@color/white</item><item name="android:textStyle">bold</item><item name="android:textAllCaps">false</item></style>
 <style name="Widget.MyFitAI.Input" parent="Widget.Material3.TextInputLayout.OutlinedBox">
     <item name="boxBackgroundColor">@color/surface_primary</item>
     <item name="boxStrokeColor">@color/myfitai_input_stroke</item>
     <item name="boxStrokeWidth">1dp</item>
     <item name="boxStrokeWidthFocused">2dp</item>
     <item name="boxCornerRadiusTopStart">12dp</item>
     <item name="boxCornerRadiusTopEnd">12dp</item>
     <item name="boxCornerRadiusBottomStart">12dp</item>
     <item name="boxCornerRadiusBottomEnd">12dp</item>
     <item name="hintTextColor">@color/myfitai_input_hint</item>
     <item name="android:minHeight">52dp</item>
 </style>
 <style name="Widget.MyFitAI.InputDropdown" parent="Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu">
     <item name="boxBackgroundColor">@color/surface_primary</item>
     <item name="boxStrokeColor">@color/myfitai_input_stroke</item>
     <item name="boxStrokeWidth">1dp</item>
     <item name="boxStrokeWidthFocused">2dp</item>
     <item name="boxCornerRadiusTopStart">12dp</item>
     <item name="boxCornerRadiusTopEnd">12dp</item>
     <item name="boxCornerRadiusBottomStart">12dp</item>
     <item name="boxCornerRadiusBottomEnd">12dp</item>
     <item name="hintTextColor">@color/myfitai_input_hint</item>
     <item name="android:minHeight">52dp</item>
 </style>
 <style name="Widget.MyFitAI.InputEditText" parent="Widget.Material3.TextInputEditText.OutlinedBox">
     <item name="android:textColor">@color/text_primary</item>
     <item name="android:textColorHint">@color/text_secondary</item>
     <item name="android:textSize">16sp</item>
     <item name="android:minHeight">52dp</item>
     <item name="android:paddingStart">14dp</item>
     <item name="android:paddingEnd">14dp</item>
 </style>
<style name="ShapeAppearance.MyFitAI.Thumbnail" parent="ShapeAppearance.Material3.Corner.Medium"><item name="cornerSize">@dimen/radius_medium</item></style>
<style name="ShapeAppearance.MyFitAI.Avatar" parent="ShapeAppearance.Material3.Corner.Full"/>
<style name="Widget.MyFitAI.BodyMarker" parent=""><item name="android:layout_width">wrap_content</item><item name="android:layout_height">wrap_content</item><item name="android:orientation">horizontal</item><item name="android:gravity">center_vertical</item></style>
<style name="Widget.MyFitAI.BodyMarkerDot" parent=""><item name="android:layout_width">10dp</item><item name="android:layout_height">10dp</item><item name="android:background">@drawable/bg_body_marker</item></style>
<style name="Widget.MyFitAI.BodyMarkerLabel" parent=""><item name="android:layout_width">wrap_content</item><item name="android:layout_height">wrap_content</item><item name="android:layout_marginStart">3dp</item><item name="android:textColor">@color/text_secondary</item><item name="android:textSize">10sp</item><item name="android:background">@color/bg_primary</item><item name="android:paddingHorizontal">2dp</item></style>
</resources>
