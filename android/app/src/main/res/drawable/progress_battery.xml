<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape android:shape="rectangle"><corners android:radius="10dp"/><solid android:color="@color/surface_soft"/><stroke android:width="1dp" android:color="@color/divider"/></shape>
    </item>
    <item android:id="@android:id/progress">
        <clip>
            <shape android:shape="rectangle"><corners android:radius="10dp"/><solid android:color="@color/accent_green"/></shape>
        </clip>
    </item>
</layer-list>
