{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PlanReviewResponse",
  "type": "object",
  "required": ["status", "checks", "violations"],
  "properties": {
    "status": {"enum": ["APPROVED", "REJECTED", "NEEDS_INPUT"]},
    "checks": {"type": "object", "required": ["complete", "targetsCoherent", "timingPresent", "ingredientsComplete", "varietyAdequate", "foodConstraintsRespected", "noPunitiveCompensation"], "properties": {"complete": {"type": "boolean"}, "targetsCoherent": {"type": "boolean"}, "timingPresent": {"type": "boolean"}, "ingredientsComplete": {"type": "boolean"}, "varietyAdequate": {"type": "boolean"}, "foodConstraintsRespected": {"type": "boolean"}, "noPunitiveCompensation": {"type": "boolean"}}, "additionalProperties": false},
    "violations": {"type": "array", "items": {"type": "string"}},
    "requiredCorrections": {"type": "array", "items": {"type": "string"}},
    "tolerancePercent": {"type": "number", "const": 3}
  },
  "additionalProperties": false,
  "description": "Revisione AI informativa del piano. La decisione finale appartiene a appValidation calcolata dal Business Validator locale."
}
