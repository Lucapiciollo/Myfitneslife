{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "WeeklyMealPlanResponse",
  "type": "object",
  "required": ["status", "operation", "weekStart", "days"],
  "properties": {
    "status": {"enum": ["OK", "NEEDS_INPUT", "OUT_OF_SCOPE", "CANNOT_SAFELY_GENERATE"]},
    "operation": {"const": "GENERATE_WEEKLY_PLAN"},
    "weekStart": {"type": "string", "format": "date"},
    "needsInput": {"type": "array", "items": {"type": "string"}},
    "evidenceIds": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "days": {"type": "array", "minItems": 0, "maxItems": 7, "items": {"type": "object", "required": ["date", "trainingDay", "meals", "totals"], "properties": {
      "date": {"type": "string", "format": "date"}, "trainingDay": {"type": "boolean"},
      "meals": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["mealType", "time", "title", "ingredients", "kcal", "proteinG", "carbsG", "fatG"], "properties": {
        "mealType": {"enum": ["BREAKFAST", "SNACK", "LUNCH", "PRE_WORKOUT", "POST_WORKOUT", "DINNER", "OTHER"]},
        "time": {"type": "string", "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"}, "title": {"type": "string", "minLength": 1},
        "ingredients": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["name", "quantity", "unit", "displayDose", "weightState", "nutritionConfidence"], "properties": {"name": {"type": "string"}, "quantity": {"type": "number", "exclusiveMinimum": 0}, "unit": {"enum": ["g", "ml", "piece", "portion"]}, "displayDose": {"type": "string", "minLength": 1, "description": "Descrizione pratica per l'utente, coerente con quantity+unit; es. 1 cucchiaino, 1/2 cucchiaino, 1 bustina da 5 g, 1 bicchiere da 200 ml."}, "weightState": {"enum": ["RAW", "COOKED", "NOT_APPLICABLE"]}, "nutritionConfidence": {"enum": ["STANDARD", "ESTIMATED"]}}, "additionalProperties": false}},
        "kcal": {"type": "number", "minimum": 0}, "proteinG": {"type": "number", "minimum": 0}, "carbsG": {"type": "number", "minimum": 0}, "fatG": {"type": "number", "minimum": 0},
        "digestiveProfile": {"type": "object", "required": ["bloatingRisk", "waterRetentionRisk", "digestiveFlags", "digestiveNote"], "properties": {"bloatingRisk": {"enum": ["LOW", "MODERATE", "HIGH"]}, "waterRetentionRisk": {"enum": ["LOW", "MODERATE", "HIGH"]}, "digestiveFlags": {"type": "array", "items": {"enum": ["HIGH_SODIUM", "HIGH_FIBER", "HIGH_FAT_PREWORKOUT", "HIGH_FERMENTABLE_LOAD", "LARGE_MEAL_VOLUME"]}, "uniqueItems": true}, "digestiveNote": {"type": "string"}}, "additionalProperties": false}
      }, "additionalProperties": false}},
      "totals": {"type": "object", "required": ["kcal", "proteinG", "carbsG", "fatG"], "properties": {"kcal": {"type": "number", "minimum": 0}, "proteinG": {"type": "number", "minimum": 0}, "carbsG": {"type": "number", "minimum": 0}, "fatG": {"type": "number", "minimum": 0}}, "additionalProperties": false}
    }, "additionalProperties": false}},
    "agentValidation": {"type": "object", "description": "Autovalutazione informativa del modello. Non sostituisce appValidation calcolata localmente.", "properties": {"withinTolerance": {"type": "boolean"}, "allConstraintsSatisfied": {"type": "boolean"}, "notes": {"type": "array", "items": {"type": "string"}}}, "additionalProperties": false}
  },
  "additionalProperties": false
}
