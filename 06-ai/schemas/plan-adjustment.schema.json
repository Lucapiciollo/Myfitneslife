{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PlanAdjustmentResponse",
  "type": "object",
  "required": ["status", "operation", "sourcePlanVersionId", "newVersionReason", "changedMeals"],
  "properties": {
    "status": {"enum": ["OK", "NEEDS_INPUT", "OUT_OF_SCOPE", "CANNOT_SAFELY_GENERATE"]},
    "operation": {"const": "ADJUST_AFTER_DEVIATION"},
    "sourcePlanVersionId": {"type": "string"},
    "newVersionReason": {"type": "string"},
    "deviationEstimate": {"type": "object", "properties": {"kcal": {"type": ["number", "null"], "minimum": 0}, "confidence": {"enum": ["LOW", "MEDIUM", "HIGH"]}}, "additionalProperties": false},
    "changedMeals": {"type": "array", "items": {"type": "object", "required": ["date", "mealType", "time", "title", "ingredients", "kcal", "proteinG", "carbsG", "fatG"], "properties": {
      "date": {"type": "string", "format": "date"}, "mealType": {"type": "string"}, "time": {"type": "string"}, "title": {"type": "string"},
      "ingredients": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["name", "quantity", "unit", "weightState", "nutritionConfidence"], "properties": {"name": {"type": "string"}, "quantity": {"type": "number", "exclusiveMinimum": 0}, "unit": {"enum": ["g", "ml", "piece", "portion"]}, "weightState": {"enum": ["RAW", "COOKED", "NOT_APPLICABLE"]}, "nutritionConfidence": {"enum": ["STANDARD", "ESTIMATED"]}}, "additionalProperties": false}},
      "kcal": {"type": "number"}, "proteinG": {"type": "number"}, "carbsG": {"type": "number"}, "fatG": {"type": "number"},
      "digestiveProfile": {"type": "object", "properties": {"bloatingRisk": {"enum": ["LOW", "MODERATE", "HIGH"]}, "waterRetentionRisk": {"enum": ["LOW", "MODERATE", "HIGH"]}, "digestiveFlags": {"type": "array", "items": {"enum": ["HIGH_SODIUM", "HIGH_FIBER", "HIGH_FAT_PREWORKOUT", "HIGH_FERMENTABLE_LOAD", "LARGE_MEAL_VOLUME"]}, "uniqueItems": true}, "digestiveNote": {"type": "string"}}, "additionalProperties": false}
    }, "additionalProperties": false}},
    "needsInput": {"type": "array", "items": {"type": "string"}},
    "evidenceIds": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "agentValidation": {"type": "object", "description": "Autovalutazione informativa del modello; l’app ricalcola appValidation.", "properties": {"withinTolerance": {"type": "boolean"}, "futureMealsOnlyModified": {"type": "boolean"}, "punitiveCompensationAvoided": {"type": "boolean"}, "allConstraintsSatisfied": {"type": "boolean"}}, "additionalProperties": false}
  },
  "additionalProperties": false
}
